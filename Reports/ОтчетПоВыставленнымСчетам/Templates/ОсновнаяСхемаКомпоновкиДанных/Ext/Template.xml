;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЫБОР
		КОГДА ОтчетКомитентуОПродажах.Ссылка ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК УПД,
	ОтчетКомитентуОПродажах.ДокументОснование КАК ДокументОснование
ПОМЕСТИТЬ ВТ_ОтчетКомитенту
ИЗ
	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
ГДЕ
	ОтчетКомитентуОПродажах.Проведен

СГРУППИРОВАТЬ ПО
	ВЫБОР
		КОГДА ОтчетКомитентуОПродажах.Ссылка ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ,
	ОтчетКомитентуОПродажах.ДокументОснование
;

