;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СчетНаОплатуПокупателюТовары.Ссылка КАК Ссылка,
	СчетНаОплатуПокупателюТовары.Номенклатура КАК Номенклатура,
	СчетНаОплатуПокупателюТовары.Содержание КАК Содержание,
	СчетНаОплатуПокупателюТовары.Количество КАК Количество,
	СчетНаОплатуПокупателюТовары.Ссылка.ВалютаДокумента КАК Валюта,
	ВтВалютаРубли.Значение КАК ВалютаРегУчета,
	СчетНаОплатуПокупателюТовары.Цена КАК Цена,
	СчетНаОплатуПокупателюТовары.Сумма КАК Сумма,
	СчетНаОплатуПокупателюТовары.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	СчетНаОплатуПокупателюТовары.СуммаНДС КАК СуммаНДС,
	СчетНаОплатуПокупателюТовары.СтавкаНДС КАК СтавкаНДС,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_Реализации.ЭтоУниверсальныйДокумент, ЛОЖЬ)
				ИЛИ ВТ_ОтчетКомитенту.УПД
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьУПД,
	ВЫБОР
		КОГДА ВТ_ДокСтатус.Статус ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусОплатыСчета.НеОплачен)
		ИНАЧЕ ВТ_ДокСтатус.Статус
	КОНЕЦ КАК СтатусОплаты
ПОМЕСТИТЬ ВтВыставленныеСчетаВалюта
ИЗ
	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Реализации КАК ВТ_Реализации
		ПО СчетНаОплатуПокупателюТовары.Ссылка = ВТ_Реализации.СчетНаОплатуПокупателю
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтчетКомитенту КАК ВТ_ОтчетКомитенту
		ПО СчетНаОплатуПокупателюТовары.Ссылка = ВТ_ОтчетКомитенту.ДокументОснование
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокСтатус КАК ВТ_ДокСтатус
		ПО СчетНаОплатуПокупателюТовары.Ссылка = ВТ_ДокСтатус.Документ
		ЛЕВОЕ СОЕДИНЕНИЕ ВтВалютаРубли КАК ВтВалютаРубли
		ПО (ИСТИНА)
ГДЕ
	СчетНаОплатуПокупателюТовары.Ссылка.Проведен
	И СчетНаОплатуПокупателюТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВтВыставленныеСчетаВалюта.Ссылка КАК Ссылка,
	ВтВыставленныеСчетаВалюта.Номенклатура КАК Номенклатура,
	ВтВыставленныеСчетаВалюта.Содержание КАК Содержание,
	ВтВыставленныеСчетаВалюта.Количество КАК Количество,
	ВтВыставленныеСчетаВалюта.Валюта КАК Валюта,
	ВтВыставленныеСчетаВалюта.ВалютаРегУчета КАК ВалютаРегУчета,
	ВЫБОР
		КОГДА ВтВыставленныеСчетаВалюта.Валюта = ВтВыставленныеСчетаВалюта.ВалютаРегУчета
			ТОГДА ВтВыставленныеСчетаВалюта.Цена
		ИНАЧЕ ВЫБОР
				КОГДА КурсыВалют.Кратность = 0
					ТОГДА 0
				ИНАЧЕ ВтВыставленныеСчетаВалюта.Цена / КурсыВалют.Кратность * КурсыВалют.Курс
			КОНЕЦ
	КОНЕЦ КАК Цена,
	ВЫБОР
		КОГДА ВтВыставленныеСчетаВалюта.Валюта = ВтВыставленныеСчетаВалюта.ВалютаРегУчета
			ТОГДА ВтВыставленныеСчетаВалюта.Сумма
		ИНАЧЕ ВЫБОР
				КОГДА КурсыВалют.Кратность = 0
					ТОГДА 0
				ИНАЧЕ ВтВыставленныеСчетаВалюта.Сумма / КурсыВалют.Кратность * КурсыВалют.Курс
			КОНЕЦ
	КОНЕЦ КАК Сумма,
	ВтВыставленныеСчетаВалюта.СуммаВключаетНДС КАК СуммаВключаетНДС,
	ВЫБОР
		КОГДА ВтВыставленныеСчетаВалюта.Валюта = ВтВыставленныеСчетаВалюта.ВалютаРегУчета
			ТОГДА ВтВыставленныеСчетаВалюта.СуммаНДС
		ИНАЧЕ ВЫБОР
				КОГДА КурсыВалют.Кратность = 0
					ТОГДА 0
				ИНАЧЕ ВтВыставленныеСчетаВалюта.СуммаНДС / КурсыВалют.Кратность * КурсыВалют.Курс
			КОНЕЦ
	КОНЕЦ КАК СуммаНДС,
	ВтВыставленныеСчетаВалюта.СтавкаНДС КАК СтавкаНДС,
	ВтВыставленныеСчетаВалюта.ЕстьУПД КАК ЕстьУПД,
	ВтВыставленныеСчетаВалюта.СтатусОплаты КАК СтатусОплаты
ИЗ
	ВтВыставленныеСчетаВалюта КАК ВтВыставленныеСчетаВалюта
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		ПО ВтВыставленныеСчетаВалюта.Валюта = КурсыВалют.Валюта
			И (НАЧАЛОПЕРИОДА(ВтВыставленныеСчетаВалюта.Ссылка.Дата, ДЕНЬ) = КурсыВалют.Период)</query>
	</dataSet>
	<calculatedField>
		<dataPath>Всего</dataPath>
		<expression>Выбор
Когда СуммаВключаетНДС
Тогда Сумма
Иначе Сумма + СуммаНДС
Конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Всего</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ВключаетНДС</dataPath>
		<expression>Выбор
Когда СуммаВключаетНДС
Тогда "Да 
(Ставка НДС - " + Представление(СтавкаНДС)+")"
Иначе "Нет
(Ставка НДС - " + Представление(СтавкаНДС)+")"
Конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма включает НДС (Согласно документа)</v8:content>
			</v8:item>
		</title>
	</calculatedField>
