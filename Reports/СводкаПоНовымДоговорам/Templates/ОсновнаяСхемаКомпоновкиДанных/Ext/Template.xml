		<query>ВЫБРАТЬ
	ДоговорыКонтрагентов.Менеджер КАК Менеджер,
	ДоговорыКонтрагентов.Дата КАК Дата,
	ДоговорыКонтрагентов.Владелец КАК Контрагент
ПОМЕСТИТЬ ВТ
ИЗ
	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
ГДЕ
	ДоговорыКонтрагентов.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ДоговорыКонтрагентов.ВидДоговора = &amp;ВидДоговора
	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ

СГРУППИРОВАТЬ ПО
	ДоговорыКонтрагентов.Менеджер,
	ДоговорыКонтрагентов.Дата,
	ДоговорыКонтрагентов.Владелец
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Дата КАК Дата,
	ВТ.Контрагент КАК Контрагент,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ.Контрагент) КАК Количество,
	ВТ.Менеджер КАК Менеджер
ИЗ
	ВТ КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.Дата,
	ВТ.Контрагент,
	ВТ.Менеджер</query>
