Перем ПервоеПроведение;
&После("ОбработкаЗаполнения")
Процедура ЛГС_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		ЭтотОбъект.Товары.Очистить();
		
		ЭтотОбъект.СуммаВключаетНДС = Истина;
		ЭтотОбъект.ДокументБезНДС = Ложь;
		
		Для Каждого Стр Из ДанныеЗаполнения.Товары Цикл
			
			СтрТЧ = ЭтотОбъект.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);
			
		КонецЦикла; 
		
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения; 
		
	КонецЕсли;
	
КонецПроцедуры

&После("ОбработкаПроведения")
Процедура ЛГС_ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.РеестрОплатыСчетов.Записывать = Истина; 
	
	// Движение по РН РеестрОплатыСчетов
	Стр = Движения.РеестрОплатыСчетов.ДобавитьПриход();
	
	Стр.СчетНаОплату = ЭтотОбъект.Ссылка;
	
	Стр.Сумма = ЭтотОбъект.СуммаДокумента; 
	
	Стр.Период = ЭтотОбъект.Дата; 
	
	Движения.РеестрОплатыСчетов.Записать(); 
	
	ЗаписиОтправленияПисьма = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьНаборЗаписей();
	ЗаписиОтправленияПисьма.Отбор.Документ.Установить(Ссылка);	
	
	ЗаписиОтправленияПисьма.Прочитать();
	
	Если ЗаписиОтправленияПисьма.Количество() = 0 И Дата > Дата('20250225') Тогда
		
		НоваяЗаписьПисьма = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьМенеджерЗаписи();
		НоваяЗаписьПисьма.Документ = Ссылка;
		
		НоваяЗаписьПисьма.Записать();
		
	КонецЕсли;	
	
КонецПроцедуры 

&После("ОбработкаУдаленияПроведения")
Процедура ЛГС_ОбработкаУдаленияПроведения(Отказ)
	
	Движения.РеестрОплатыСчетов.Очистить();
	
	Движения.РеестрОплатыСчетов.Записать();  
	
КонецПроцедуры

