Процедура УстановитьНомер()
	
	Если ЗначениеЗаполнено(Номер) Тогда
		Возврат;		
	КонецЕсли;
	
	ИмяФункциональнойОпции = "ПрефиксыОрганизаций";
	ИмяПараметраФункциональнойОпции = "Организация";
	
	Префикс = "00-";
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Организация.Префикс) Тогда
		
		Префикс = Организация.Префикс + "-";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателю.Номер КАК Номер
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|ГДЕ
	|	СчетНаОплатуПокупателю.Дата >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|	И СчетНаОплатуПокупателю.Дата <= КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	ЕстьВыборка = Ложь;
	
	ЧислоНомера = 1;
	
	Пока Выборка.Следующий() Цикл
		
		Если (Число(Прав(СокрЛП(Выборка.Номер), 2)) + 1) > ЧислоНомера Тогда
			
			ЧислоНомера = Число(Прав(СокрЛП(Выборка.Номер), 2)) + 1; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Номер = СтрШаблон("%1%2%3", Префикс, Формат(Дата, "ДФ=ddMM"), Формат(ЧислоНомера, "ЧЦ=2; ЧН=0; ЧВН=; ЧГ=0"));
	
КонецПроцедуры

