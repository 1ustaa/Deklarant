
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ФормаДок = ПолучитьФорму("Документ.ПоручениеЭкспедитору.Форма.ФормаДокумента");
		
	ФормаДок.Объект.Дата = ТекущаяДата();
	ФормаДок.Объект.ДокументОснование = ПараметрКоманды;
	ФормаДок.Объект.Экспедитор = ПолучитьОрганизацию(ПараметрКоманды);
	ФормаДок.Объект.Клиент = ПолучитьКонтрагента(ПараметрКоманды);
	ФормаДок.Объект.Договор = ПолучитьОсновнойДоговорКонтрагента(ПараметрКоманды);
	ФормаДок.Объект.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();
	ФормаДок.Объект.Номер = ПолучитьНомер(ПараметрКоманды);
	ФормаДок.Объект.ОсобыеОтметки = ПолучитьНомер(ПараметрКоманды) + ", " + ПолучитьНомерКоносамента(ПараметрКоманды);
	ФормаДок.Объект.ВесБруттоНетто = ПолучитьВес(ПараметрКоманды);
	ФормаДок.Объект.КоличествоМестВидУпаковки = ПолучитьКоличествоГрузовыхМест(ПараметрКоманды);
	ФормаДок.Объект.ТоварыГотовыеКОтправкеМестоИДата = ПолучитьГруз(ПараметрКоманды);
	ФормаДок.Объект.ПунктОтправления = ПолучитьПортОтгрузки(ПараметрКоманды);
	ФормаДок.Объект.ПунктНазначения = ПолучитьНаправления(ПараметрКоманды);
	ФормаДок.Объект.ВидТранспорта = ПолучитьВидТранспорта(ПараметрКоманды);
	ФормаДок.Объект.ТребуемыеДокументы = "коносамент"; 
	
	СписокРеализацийИОтчетовКомитенту = ПолучитьСписокРеализацийИОтчетовКомитентуПоСделке(ПараметрКоманды);
	
	Для Каждого Стр Из СписокРеализацийИОтчетовКомитенту Цикл
		
		Если ТипЗнч(Стр) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СтрТЧ = ФормаДок.Объект.РеализацииТоваровИУслуг.Добавить();
			СтрТЧ.Реализация = Стр; 
			
			СоставНоменклатуры = ПолучитьСоставНоменклатуры(Стр);
			
			Для Каждого СтрНом Из СоставНоменклатуры Цикл
				
				СтрТЧНом = ФормаДок.Объект.СоставНоменклатуры.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрТЧНом, СтрНом);
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Стр) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			
			СтрТЧ = ФормаДок.Объект.ОтчетыКомитентам.Добавить();
			СтрТЧ.ОтчетКомитенту = Стр; 
			
			СоставНоменклатуры = ПолучитьСоставНоменклатурыОтчетаКомитенту(Стр);
			
			Для Каждого СтрНом Из СоставНоменклатуры Цикл
				
				СтрТЧНом = ФормаДок.Объект.СоставНоменклатуры.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрТЧНом, СтрНом);
				
			КонецЦикла;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПолучитьГрузополучателя(ПараметрКоманды)) Тогда
		
		ФормаДок.Объект.Грузополучатель	= ПолучитьГрузополучателя(ПараметрКоманды);
		
	Иначе
		
		ФормаДок.Объект.Грузополучатель = ПолучитьКонтрагента(ПараметрКоманды);
		
	КонецЕсли;
	
	ФормаДок.Элементы.ДокументОснование.Видимость = Истина;  
	
	ФормаДок.Открыть();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВидТранспорта(ПараметрКоманды)

	Возврат ПараметрКоманды.ВидТранспорта;	

КонецФункции


&НаСервере
Функция ПолучитьСоставНоменклатуры(Док) 
	
	МассивНоменклатуры = Новый Массив;
	
	ДобавляемыйДокумент = Док.ПолучитьОбъект();
	
	Для Каждого Стр ИЗ ДобавляемыйДокумент.Услуги Цикл 
		
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Содержание", Стр.Содержание);
		НоваяСтрока.Вставить("Количество", Стр.Количество);
		НоваяСтрока.Вставить("Цена", Стр.Цена);
		НоваяСтрока.Вставить("Сумма", Стр.Сумма);
		НоваяСтрока.Вставить("СуммаНДС", Стр.СуммаНДС);
		НоваяСтрока.Вставить("Документ", ДобавляемыйДокумент.Ссылка);
		НоваяСтрока.Вставить("Валюта", ДобавляемыйДокумент.ВалютаДокумента);
		НоваяСтрока.Вставить("СтавкаНДС", Стр.СтавкаНДС); 
		
		МассивНоменклатуры.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

&НаСервере
Функция ПолучитьСоставНоменклатурыОтчетаКомитенту(Док) 
	
	МассивНоменклатуры = Новый Массив;
	
	ДобавляемыйДокумент = Док.ПолучитьОбъект();
	
	Для Каждого Стр ИЗ ДобавляемыйДокумент.Товары Цикл 
		
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Содержание", Стр.Содержание);
		НоваяСтрока.Вставить("Количество", Стр.Количество);
		НоваяСтрока.Вставить("Цена", Стр.Цена);
		НоваяСтрока.Вставить("Сумма", Стр.Сумма);
		НоваяСтрока.Вставить("СуммаНДС", Стр.СуммаНДС);
		НоваяСтрока.Вставить("Документ", ДобавляемыйДокумент.Ссылка);
		НоваяСтрока.Вставить("Валюта", ДобавляемыйДокумент.ВалютаДокумента);
		НоваяСтрока.Вставить("СтавкаНДС", Стр.СтавкаНДС); 
		
		МассивНоменклатуры.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

