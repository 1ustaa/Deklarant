&НаСервере
Функция ПолучитьНаправления(ПараметрКоманды)
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Направление");
	
	Для Каждого Стр Из ПараметрКоманды.ИнформацияОПеревозчиках Цикл
		
		СтрТЗ = ТЗ.Добавить();
		СтрТЗ.Направление = Стр.Направление;
		
	КонецЦикла; 
	
	ТЗ.Свернуть("Направление"); 
	
	Направления = "";
	
	Для Каждого СтрТЗ Из ТЗ Цикл
		
		Если Направления = "" Тогда
			
			Направления = Строка(СтрТЗ.Направление);
			
		Иначе
			
			Направления = Направления + ", " + Строка(СтрТЗ.Направление);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Направления;	
	
КонецФункции 

&НаСервере
Функция ПолучитьСписокРеализацийИОтчетовКомитентуПоСделке(ПараметрКоманды)
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	РеализацияТоваровУслуг.Проведен = ИСТИНА
	               |	И РеализацияТоваровУслуг.СчетНаОплатуПокупателю.Сделка = &Сделка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровУслуг.Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОтчетКомитентуОПродажах.Ссылка
	               |ИЗ
	               |	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	               |ГДЕ
	               |	ОтчетКомитентуОПродажах.ДокументОснование.Сделка = &Сделка
	               |	И ОтчетКомитентуОПродажах.Проведен = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтчетКомитентуОПродажах.Ссылка";
	
	Запрос.УстановитьПараметр("Сделка", ПараметрКоманды.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Массив.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции	

