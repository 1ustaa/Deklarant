&НаСервере
Функция ЗаполнитьТабличныйДокументПрофитовСделок(ТабДок, МассивОбъектов)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Сделка.ПрофитыСделок");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");	
	
	ТабДок.Вывести(ОбластьШапка);
	
	СуммаИтогоИсходящиеСчета = 0;
	СуммаИтогоВходящиеСчета = 0; 
	СуммаИтогоПрофит = 0;
	
	Для Каждого Док Из МассивОбъектов Цикл
		
		ЗапросИсходящиеСчета = Новый Запрос;
		ЗапросИсходящиеСчета.Текст = РасчетПрофитаСделокСервер.ТекстЗапросаИсходящиеСчета(); 	
		ЗапросИсходящиеСчета.УстановитьПараметр("Сделка", Док);
		
		ВыборкаИсходящиеСчета = ЗапросИсходящиеСчета.Выполнить().Выгрузить();
		
		ЗапросВходящиеСчета = Новый Запрос;
		ЗапросВходящиеСчета.Текст = РасчетПрофитаСделокСервер.ТекстЗапросаВходящиеСчета(); 	
		ЗапросВходящиеСчета.УстановитьПараметр("Сделка", Док);
		
		ВыборкаВходящиеСчета = ЗапросВходящиеСчета.Выполнить().Выгрузить();
		
		СуммаИсходящихСчетов = 0;
		
		Для Каждого СтрИсходящиеСчета Из ВыборкаИсходящиеСчета Цикл
			
			СуммаИсходящихСчетов = СуммаИсходящихСчетов + СтрИсходящиеСчета.Сумма;
			
		КонецЦикла; 
		
		СуммаВходящихСчетов = 0;
		
		Для Каждого СтрВходящиеСчета Из ВыборкаВходящиеСчета Цикл
			
			СуммаВходящихСчетов = СуммаВходящихСчетов + СтрВходящиеСчета.Сумма;
			
		КонецЦикла;
		
		Для Каждого СтрВнутренниеРасходы Из Док.ВнутренниеРасходы Цикл
			
			СуммаВходящихСчетов = СуммаВходящихСчетов + СтрВнутренниеРасходы.Сумма;
			
		КонецЦикла;
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ОбластьСтрока.Параметры.Сделка = Док.Номер;
		ОбластьСтрока.Параметры.СделкаСсылка = Док.Ссылка;
		ОбластьСтрока.Параметры.ИсходящиеСчета = СуммаИсходящихСчетов;
		ОбластьСтрока.Параметры.ВходящиеСчета = СуммаВходящихСчетов;
		ОбластьСтрока.Параметры.Профит = СуммаИсходящихСчетов - СуммаВходящихСчетов;
		
		ТабДок.Вывести(ОбластьСтрока);
		
		СуммаИтогоИсходящиеСчета = СуммаИтогоИсходящиеСчета + СуммаИсходящихСчетов;
		СуммаИтогоВходящиеСчета = СуммаИтогоВходящиеСчета + СуммаВходящихСчетов; 
		СуммаИтогоПрофит = СуммаИтогоПрофит + СуммаИсходящихСчетов - СуммаВходящихСчетов;
		
	КонецЦикла;
	
	ОбластьИтогиТаблицы = Макет.ПолучитьОбласть("ИтогиТаблицы");
	
	ОбластьИтогиТаблицы.Параметры.ИтогоИсходящиеСчета = СуммаИтогоИсходящиеСчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоВходящиеСчета = СуммаИтогоВходящиеСчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоПрофит = СуммаИтогоПрофит;
	
	ТабДок.Вывести(ОбластьИтогиТаблицы);
	
	Возврат ТабДок;
	
КонецФункции  

