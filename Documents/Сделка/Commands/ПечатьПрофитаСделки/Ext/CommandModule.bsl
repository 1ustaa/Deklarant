	РасчетПрофитаСделокСервер.ПолучитьНДСВходящиеПеревыставляемые(АктыВходящие,СчетаВходящие,СуммаНДСИтогоВходящиеАктыПеревыставляемый,СуммаНДСИтогоВходящиеСчетаПеревыставляемый,СтруктураНДСВходящие);
	
	//ОбщаяСитемаНалогообложения = УчетНДС.ПрименяетсяОбщаяСтавкаНДС(Док.Организация, ТекущаяДата());
	
	//Если СуммаНДСИтогоИсходящиеАкты = 0 Тогда
	//	
	//	ОбластьПодвал.Параметры.ПрофитБезНДСПоСчетам = СуммаБезНДСИтогоИсходящиеСчета - СуммаСНДСИтогоВходящиеСчета;
	//	ОбластьПодвал.Параметры.ПрофитСНДСПоСчетам =  СуммаСНДСИтогоИсходящиеСчета - СуммаСНДСИтогоВходящиеСчета + СруктураНДСВходящие.СчетВходящийНеПеревыставляемыйНДС;// СуммаНДСИтогоВходящиеСчета;
	//	
	//	ОбластьПодвал.Параметры.ПрофитБезНДСПоАктам = СуммаБезНДСИтогоИсходящиеАкты - СуммаСНДСИтогоВходящиеАкты;  // Разница в расчетах
	//	ОбластьПодвал.Параметры.ПрофитСНДСПоАктам = СуммаСНДСИтогоИсходящиеАкты - СуммаСНДСИтогоВходящиеАкты + СруктураНДСВходящие.АктВходящийНеПеревыставляемыйНДС; //СуммаНДСИтогоВходящиеАкты;
	//	
	//	
	//Иначе   
	//	
	//	ОбластьПодвал.Параметры.ПрофитБезНДСПоСчетам = СуммаБезНДСИтогоИсходящиеСчета - СуммаБезНДСИтогоВходящиеСчета;
	//	ОбластьПодвал.Параметры.ПрофитСНДСПоСчетам =  СуммаСНДСИтогоИсходящиеСчета - СуммаСНДСИтогоВходящиеСчета;
	//	
	//	ОбластьПодвал.Параметры.ПрофитБезНДСПоАктам = СуммаБезНДСИтогоИсходящиеАкты - СуммаБезНДСИтогоВходящиеАкты;  // Разница в расчетах
	//	ОбластьПодвал.Параметры.ПрофитСНДСПоАктам = СуммаСНДСИтогоИсходящиеАкты - СуммаСНДСИтогоВходящиеАкты;
	//	
	//КонецЕсли;
	
	Если ПониженнаяСтавка Тогда  // для пониженной ставки НДС (5 и 7%)
		
		ОбластьПодвал.Параметры.ПрофитБезНДСПоАктам = СуммаСНДСИтогоИсходящиеАкты - СтруктураНДСИсходящие.АктИсходящийНеПеревыставляемыйНДС - СуммаСНДСИтогоВходящиеАкты;
		
		ОбластьПодвал.Параметры.ПрофитБезНДСПоСчетам = СуммаСНДСИтогоИсходящиеСчета - СтруктураНДСИсходящие.СчетИсходящийНеПеревыставляемыйНДС - СуммаСНДСИтогоВходящиеСчета;
		
	Иначе  // Если общая система налогообложения (20%)
		
