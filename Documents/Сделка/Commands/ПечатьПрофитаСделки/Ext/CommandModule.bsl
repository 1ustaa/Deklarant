
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОбъектыПечати = Новый СписокЗначений; 
	ИмяМакета = "Профит сделки"; 
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Профит сделки");
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Профит сделки"; 
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = СформироватьПечатнуюФормуПрофитаСделки(ПараметрКоманды, ОбъектыПечати, ИмяМакета); 
	
	Если НЕ КоллекцияПечатныхФорм[0].ТабличныйДокумент = Неопределено Тогда
		УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтотОбъект);
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФормуПрофитаСделки(МассивОбъектов, ОбъектыПечати, ИмяМакета) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяМакета = Неопределено;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб          = Истина;
	ТабличныйДокумент.ОриентацияСтраницы   = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПрофитСделки"; 
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	ПечатьТорговыхДокументов.УстановитьМинимальныеПоляПечати(ТабличныйДокумент);
	
	
	Если МассивОбъектов.Количество() > 1 Тогда
		
		ТабличныйДокумент = ЗаполнитьТабличныйДокументПрофитовСделок(ТабличныйДокумент, МассивОбъектов);	
		
	Иначе
		
		ТабличныйДокумент = ЗаполнитьТабличныйДокументПрофитСделки(ТабличныйДокумент, МассивОбъектов[0]); 
		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция ЗаполнитьТабличныйДокументПрофитСделки(ТабДок, Док)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Сделка.ПрофитСделки");	
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьШапка.Параметры.Номер = Док.Номер;		
	
	ТабДок.Вывести(ОбластьШапка);
	
	// Суммы БезНДС Итоговые
	СуммаБезНДСИтогоИсходящиеСчета = 0;
	СуммаБезНДСИтогоВходящиеСчета = 0; 
	
	СуммаБезНДСИтогоИсходящиеАкты = 0;	
	СуммаБезНДСИтогоВходящиеАкты = 0;
	
	// Суммы НДС Итоговые
	СуммаНДСИтогоИсходящиеСчета = 0;
	СуммаНДСИтогоВходящиеСчета = 0; 
	//СуммаНДСИтогоВходящиеСчетаПеревыставляемый = 0;
	
	СуммаНДСИтогоИсходящиеАкты = 0;	
	СуммаНДСИтогоВходящиеАкты = 0;
	//СуммаНДСИтогоВходящиеАктыПеревыставляемый = 0;
	
	// Суммы СНДС Итоговые
	СуммаСНДСИтогоИсходящиеСчета = 0;
	СуммаСНДСИтогоВходящиеСчета = 0; 
	
	СуммаСНДСИтогоИсходящиеАкты = 0;	
	СуммаСНДСИтогоВходящиеАкты = 0;  
	
	
	
	// Структура НДС по входящим документам
	СтруктураНДСВходящие = Новый Структура;
	СтруктураНДСВходящие.Вставить("АктВходящийВсегоНДС",0);
	СтруктураНДСВходящие.Вставить("АктВходящийНеПеревыставляемыйНДС",0);
	СтруктураНДСВходящие.Вставить("АктВходящийПеревыставляемыйНДС",0);
	СтруктураНДСВходящие.Вставить("СчетВходящийВсегоНДС",0);
	СтруктураНДСВходящие.Вставить("СчетВходящийНеПеревыставляемыйНДС",0);
	СтруктураНДСВходящие.Вставить("СчетВходящийПеревыставляемыйНДС",0); 
	
	// Структура НДС по исходящим документам
	СтруктураНДСИсходящие = Новый Структура;
	СтруктураНДСИсходящие.Вставить("АктИсходящийВсегоНДС",0);
	СтруктураНДСИсходящие.Вставить("АктИсходящийНеПеревыставляемыйНДС",0);
	СтруктураНДСИсходящие.Вставить("АктИсходящийПеревыставляемыйНДС",0);
	СтруктураНДСИсходящие.Вставить("СчетИсходящийВсегоНДС",0);
	СтруктураНДСИсходящие.Вставить("СчетИсходящийНеПеревыставляемыйНДС",0);
	СтруктураНДСИсходящие.Вставить("СчетИсходящийПеревыставляемыйНДС",0); 
	
	
	// ++ ХАУНД Устинин 01.06.2026 ID: 3196
	//Если Док.Организация.ИНН = "5074080761" Тогда // Декларант
	//	
	//	Номенклатура1 = Справочники.Номенклатура.ПустаяСсылка();  
	//	НоменклатураВозмещаемыеРасходы = Справочники.Номенклатура.ПустаяСсылка();
	//	
	//	
	//ИначеЕсли Док.Организация.ИНН = "2315213101" Тогда // Логист 
	//	
	//	Номенклатура1 = Справочники.Номенклатура.НайтиПоКоду("00-00000389"); // Таможенные платежи
	//	
	//КонецЕсли; 
	// -- ХАУНД Устинин 01.06.2026 ID: 3196
	
	
	ЗапросИсходящиеСчета = Новый Запрос;
	ЗапросИсходящиеСчета.Текст = РасчетПрофитаСделокСервер.ТекстЗапросаИсходящиеСчета(); 	
	ЗапросИсходящиеСчета.УстановитьПараметр("Сделка", Док); 
	
	ВыборкаИсходящиеСчета = ЗапросИсходящиеСчета.Выполнить().Выгрузить();
	
	ЗапросВходящиеСчета = Новый Запрос;
	ЗапросВходящиеСчета.Текст = РасчетПрофитаСделокСервер.ТекстЗапросаВходящиеСчета(); 	
	ЗапросВходящиеСчета.УстановитьПараметр("Сделка", Док);
	
	
	ВыборкаВходящиеСчета = ЗапросВходящиеСчета.Выполнить().Выгрузить();
	
	Индекс = 0;
	
	Если ВыборкаИсходящиеСчета.Количество() > ВыборкаВходящиеСчета.Количество() Тогда
		
		Пока Индекс < ВыборкаИсходящиеСчета.Количество() Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьСтрока.Параметры.ДокументИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].Ссылка;
			ОбластьСтрока.Параметры.СчетИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].Счет;
			
			Если ТипЗнч(ВыборкаИсходящиеСчета[Индекс].Ссылка) = Тип("Строка") Тогда
				
				ОбластьСтрока.Параметры.ДокументИсходящиеСчетаПредставление = "Наличный доход (" + ВыборкаИсходящиеСчета[Индекс].Ссылка + ")";
				ОбластьСтрока.Параметры.СчетИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].Ссылка;
				
			Иначе
				
				Если ТипЗнч(ВыборкаИсходящиеСчета[Индекс].Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
					
					ОбластьСтрока.Параметры.ДокументИсходящиеСчетаПредставление = "Акт покупателю №" + ВыборкаИсходящиеСчета[Индекс].Ссылка.Номер + " от " + Формат(ВыборкаИсходящиеСчета[Индекс].Ссылка.Дата,"ДФ=dd.MM.yy");
					
				ИначеЕсли ТипЗнч(ВыборкаИсходящиеСчета[Индекс].Ссылка) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
					
					ОбластьСтрока.Параметры.ДокументИсходящиеСчетаПредставление = "Отчет комитенту №" + ВыборкаИсходящиеСчета[Индекс].Ссылка.Номер + " от " + Формат(ВыборкаИсходящиеСчета[Индекс].Ссылка.Дата,"ДФ=dd.MM.yy");
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаИсходящиеСчета[Индекс].Счет) Тогда
					
					ОбластьСтрока.Параметры.СчетИсходящиеСчетаПредставление = "Счет покупателю №" + ВыборкаИсходящиеСчета[Индекс].Счет.Номер + " от " + Формат(ВыборкаИсходящиеСчета[Индекс].Счет.Дата,"ДФ=dd.MM.yy");
					ОбластьСтрока.Параметры.СчетИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].Счет;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОбластьСтрока.Параметры.СуммаБезНДСИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].СуммаБезНДССчета;
			ОбластьСтрока.Параметры.СуммаБезНДСИсходящиеАкты = ВыборкаИсходящиеСчета[Индекс].СуммаБезНДСАкта;
			
			ОбластьСтрока.Параметры.СуммаНДСИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].СуммаНДССчета;
			ОбластьСтрока.Параметры.СуммаНДСИсходящиеАкты = ВыборкаИсходящиеСчета[Индекс].СуммаНДСАкта;
			
			ОбластьСтрока.Параметры.СуммаСНДСИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].СуммаСНДССчета;
			ОбластьСтрока.Параметры.СуммаСНДСИсходящиеАкты = ВыборкаИсходящиеСчета[Индекс].СуммаСНДСАкта;
			
			Если ВыборкаИсходящиеСчета[Индекс].Статус = Null Тогда
				
				ОбластьСтрока.Параметры.ОплатаИсходящиеСчета = Перечисления.СтатусОплатыСчета.НеОплачен;
				
			Иначе
				
				ОбластьСтрока.Параметры.ОплатаИсходящиеСчета = ВыборкаИсходящиеСчета[Индекс].Статус;
				
			КонецЕсли;
			
			Если Индекс < ВыборкаВходящиеСчета.Количество() Тогда
				
				Если ТипЗнч(ВыборкаВходящиеСчета[Индекс].Ссылка) = Тип("Строка") Тогда
					
					ОбластьСтрока.Параметры.ДокументВходящиеСчета = Док.Ссылка;
					ОбластьСтрока.Параметры.ДокументВходящиеСчетаПредставление = "Наличный расход (" + ВыборкаВходящиеСчета[Индекс].Ссылка + ")";
					
				Иначе
					
					Если ЗначениеЗаполнено(ВыборкаВходящиеСчета[Индекс].Ссылка) Тогда
						
						Если ТипЗнч(ВыборкаВходящиеСчета[Индекс].Ссылка) = Тип("ДокументСсылка.ОперацияБух") Тогда
							
							ОбластьСтрока.Параметры.ДокументВходящиеСчета = ВыборкаВходящиеСчета[Индекс].Ссылка;
							ОбластьСтрока.Параметры.ДокументВходящиеСчетаПредставление = "Операция №" + ВыборкаВходящиеСчета[Индекс].Ссылка.Номер + " от " + Формат(ВыборкаВходящиеСчета[Индекс].Ссылка.Дата,"ДФ=dd.MM.yy");
							
						Иначе
							
							ОбластьСтрока.Параметры.ДокументВходящиеСчета = ВыборкаВходящиеСчета[Индекс].Ссылка;
							ОбластьСтрока.Параметры.ДокументВходящиеСчетаПредставление = "Акт от поставщика №" + ВыборкаВходящиеСчета[Индекс].Ссылка.НомерВходящегоДокумента + " от " + Формат(ВыборкаВходящиеСчета[Индекс].Ссылка.ДатаВходящегоДокумента,"ДФ=dd.MM.yy");	
						
						КонецЕсли;
						
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ВыборкаВходящиеСчета[Индекс].Счет) Тогда
						
						ОбластьСтрока.Параметры.СчетВходящиеСчетаПредставление = "Счет от поставщика №" + ВыборкаВходящиеСчета[Индекс].Счет.НомерВходящегоДокумента + " от " + Формат(ВыборкаВходящиеСчета[Индекс].Счет.ДатаВходящегоДокумента,"ДФ=dd.MM.yy");
						ОбластьСтрока.Параметры.СчетВходящиеСчета = ВыборкаВходящиеСчета[Индекс].Счет;
						
					КонецЕсли;
					
				КонецЕсли;
				
				ОбластьСтрока.Параметры.СуммаБезНДСВходящиеСчета = ВыборкаВходящиеСчета[Индекс].СуммаБезНДССчета;
				ОбластьСтрока.Параметры.СуммаБезНДСВходящиеАкты = ВыборкаВходящиеСчета[Индекс].СуммаБезНДСАкта;
				
				ОбластьСтрока.Параметры.СуммаНДСВходящиеСчета = ВыборкаВходящиеСчета[Индекс].СуммаНДССчета;
				ОбластьСтрока.Параметры.СуммаНДСВходящиеАкты = ВыборкаВходящиеСчета[Индекс].СуммаНДСАкта; 
				
				//Если ВыборкаВходящиеСчета[Индекс].СчетПеревыставляемый <> Null Тогда 
				//	
				//	Если ВыборкаВходящиеСчета[Индекс].СчетПеревыставляемый Тогда  
				//		
				//		СуммаНДСИтогоВходящиеСчетаПеревыставляемый = СуммаНДСИтогоВходящиеСчетаПеревыставляемый + ВыборкаВходящиеСчета[Индекс].СуммаНДССчета;
				//		
				//	Иначе
				//		
				//	КонецЕсли;  
				//	
				//КонецЕсли;
				//
				//Если ВыборкаВходящиеСчета[Индекс].АктПеревыставляемый <> Null Тогда  
				//	
				//	Если ВыборкаВходящиеСчета[Индекс].АктПеревыставляемый Тогда  
				//		
				//		СуммаНДСИтогоВходящиеАктыПеревыставляемый = СуммаНДСИтогоВходящиеАктыПеревыставляемый + ВыборкаВходящиеСчета[Индекс].СуммаНДСАкта;
				//		
				//	Иначе
				//		
				//	КонецЕсли;
				//	
				//КонецЕсли;
				
				ОбластьСтрока.Параметры.СуммаСНДСВходящиеСчета = ВыборкаВходящиеСчета[Индекс].СуммаСНДССчета;
				ОбластьСтрока.Параметры.СуммаСНДСВходящиеАкты = ВыборкаВходящиеСчета[Индекс].СуммаСНДСАкта;
				
				СуммаБезНДСИтогоВходящиеСчета = СуммаБезНДСИтогоВходящиеСчета + ВыборкаВходящиеСчета[Индекс].СуммаБезНДССчета;
				СуммаБезНДСИтогоВходящиеАкты = СуммаБезНДСИтогоВходящиеАкты + ВыборкаВходящиеСчета[Индекс].СуммаБезНДСАкта;
				
				СуммаНДСИтогоВходящиеСчета = СуммаНДСИтогоВходящиеСчета + ВыборкаВходящиеСчета[Индекс].СуммаНДССчета;
				СуммаНДСИтогоВходящиеАкты = СуммаНДСИтогоВходящиеАкты + ВыборкаВходящиеСчета[Индекс].СуммаНДСАкта; 
				
				
				
				СуммаСНДСИтогоВходящиеСчета = СуммаСНДСИтогоВходящиеСчета + ВыборкаВходящиеСчета[Индекс].СуммаСНДССчета;
				СуммаСНДСИтогоВходящиеАкты = СуммаСНДСИтогоВходящиеАкты + ВыборкаВходящиеСчета[Индекс].СуммаСНДСАкта;
				
				Если ВыборкаВходящиеСчета[Индекс].Статус = Null Тогда
					
					ОбластьСтрока.Параметры.ОплатаВходящиеСчета = Перечисления.СтатусОплатыСчета.НеОплачен;
					
				Иначе
					
					ОбластьСтрока.Параметры.ОплатаВходящиеСчета = ВыборкаВходящиеСчета[Индекс].Статус;
					
				КонецЕсли;
				
			КонецЕсли;
			
			СуммаБезНДСИтогоИсходящиеСчета = СуммаБезНДСИтогоИсходящиеСчета + ВыборкаИсходящиеСчета[Индекс].СуммаБезНДССчета;
			СуммаБезНДСИтогоИсходящиеАкты = СуммаБезНДСИтогоИсходящиеАкты + ВыборкаИсходящиеСчета[Индекс].СуммаБезНДСАкта;
			
			СуммаНДСИтогоИсходящиеСчета = СуммаНДСИтогоИсходящиеСчета + ВыборкаИсходящиеСчета[Индекс].СуммаНДССчета;
			СуммаНДСИтогоИсходящиеАкты = СуммаНДСИтогоИсходящиеАкты + ВыборкаИсходящиеСчета[Индекс].СуммаНДСАкта;
			
			СуммаСНДСИтогоИсходящиеСчета = СуммаСНДСИтогоИсходящиеСчета + ВыборкаИсходящиеСчета[Индекс].СуммаСНДССчета;
			СуммаСНДСИтогоИсходящиеАкты = СуммаСНДСИтогоИсходящиеАкты + ВыборкаИсходящиеСчета[Индекс].СуммаСНДСАкта;
			
			ТабДок.Вывести(ОбластьСтрока);
			
