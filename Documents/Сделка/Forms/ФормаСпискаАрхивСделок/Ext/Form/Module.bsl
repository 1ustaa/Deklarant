&НаСервере
Функция ПолучитьПрофитПоСделкам()

    Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаТЗПрофита();
	
	Результат = Запрос.Выполнить();
	
	ДанныеЗапросаПоСделкам = Результат.Выгрузить();
	
	ТабЗначДляСписка = ДанныеЗапросаПоСделкам.Скопировать(,"Сделка,ПрофитАктБезНДС,ПрофитСчетБезНДС");

	

