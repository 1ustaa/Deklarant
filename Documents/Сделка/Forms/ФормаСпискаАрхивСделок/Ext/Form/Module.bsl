    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка КАК Счет,
	               |	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Сделка КАК Сделка,
	               |	СУММА(ВЫБОР
	               |			КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.СуммаВключаетНДС = ИСТИНА
	               |				ТОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
