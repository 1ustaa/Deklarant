
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтотОбъект.Квартал = НачалоКвартала(ТекущаяДата());
	
	УстановитьОтборСписка();

КонецПроцедуры 

&НаСервере
Процедура УстановитьОтборСписка()
	
	Список.Отбор.Элементы.Очистить();
	
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Вывезен); 
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Доставлен);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.СданПорожний); 
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Выгружен);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.ВыставленыВсеРасходы);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.ДокументыПодготовлены);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Закрыта);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Отменена);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Задержана);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.ПретензияСуд);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.Задержана);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.ВыходИзПорта);
	СписокСтатусов.Добавить(Перечисления.СтатусыСделок.SWBОформлен);
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке; 
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
	
	ЭлементОтбора.ПравоеЗначение = СписокСтатусов; 
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Квартал"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно; 
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
	
	ЭлементОтбора.ПравоеЗначение = КонецКвартала(ЭтотОбъект.Квартал);
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Квартал"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно; 
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
	
	ЭлементОтбора.ПравоеЗначение = НачалоКвартала(ЭтотОбъект.Квартал); 
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВсеФайлыДобавлены"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
	
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ОтборКонтрагент) Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент"); 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
		
		ЭлементОтбора.ПравоеЗначение = ЭтотОбъект.ОтборКонтрагент;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ОтборОтветственный) Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ответственный"); 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;  
		
		ЭлементОтбора.ПравоеЗначение = ЭтотОбъект.ОтборОтветственный;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КварталНазад(Команда)     
	
	ЭтотОбъект.Квартал = ДобавитьМесяц(НачалоМесяца(ЭтотОбъект.Квартал), -3);
	
	УстановитьОтборСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура КварталВперед(Команда)
	
	ЭтотОбъект.Квартал = ДобавитьМесяц(НачалоМесяца(ЭтотОбъект.Квартал), 3);
	
	УстановитьОтборСписка();
	
КонецПроцедуры

