
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Сделка = Параметры.Ключ;
	
	ЗаполнитьИсториюСтатусов();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьИсториюСтатусов()

	Для Каждого Стр ИЗ Сделка.Статусы Цикл
		
		Если ТипЗнч(Стр.Статус) = Тип("ПеречислениеСсылка.СтатусыСделок") Тогда
			
			ЗаполнитьЗначенияСвойств(ИсторияСтатусов.Добавить(),Стр);	
			
		КонецЕсли;
				
	КонецЦикла;
		
КонецПроцедуры
