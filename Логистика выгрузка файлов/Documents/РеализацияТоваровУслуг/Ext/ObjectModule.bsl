Функция КонтрольОтправкиНаПочту() 
	
	НЗРеализаций = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьНаборЗаписей();	
	НЗРеализаций.Отбор.Документ.Установить(ЭтотОбъект.Ссылка);
	
	НЗРеализаций.Прочитать();
	
	Если НЗРеализаций.Количество() > 0 Тогда
		
		Возврат НЕ НЗРеализаций[0].Отправлен;	
		
	Иначе		
		
		МЗРеализаций = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьМенеджерЗаписи();
		
		МЗРеализаций.Документ = ЭтотОбъект.Ссылка;
		
		МЗРеализаций.Записать();
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

Функция СформироватьПараметрыПисьма(Получатели, ПочтаОтправителя, ТемаПисьма, ТекстПисьма, Вложения)
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", Получатели);
	ПараметрыПисьма.Вставить("УчетнаяЗапись", ПочтаОтправителя);                                                               
	ПараметрыПисьма.Вставить("АдресОтвета", Получатели);
	ПараметрыПисьма.Вставить("Тема", ТемаПисьма);	
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыПисьма.Вставить("ТипТекста", "ПростойТекст");
	ПараметрыПисьма.Вставить("Вложения", Вложения);
	
	Возврат ПараметрыПисьма;
	
КонецФункции

&После("ОбработкаПроведения")
Процедура ЛГС_ОбработкаПроведения(Отказ, РежимПроведения)
	
	ЗаписиОтправленияПисьма = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьНаборЗаписей();
	ЗаписиОтправленияПисьма.Отбор.Документ.Установить(Ссылка);	
	
	ЗаписиОтправленияПисьма.Прочитать();
	
	Если ЗаписиОтправленияПисьма.Количество() = 0 И Дата > Дата('20250225') Тогда
		
		НоваяЗаписьПисьма = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьМенеджерЗаписи();
		НоваяЗаписьПисьма.Документ = Ссылка;
		НоваяЗаписьПисьма.Записать();
		
	КонецЕсли;
	
	Движения.ПеревыставляемыеТоварыУслуги.Записывать = Истина;		
	
	Для Каждого Стр Из ЭтотОбъект.Услуги Цикл
		
		Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ЭтотОбъект.Дата;
		Движение.Номенклатура = Стр.Номенклатура;
		Движение.Контрагент = ЭтотОбъект.Контрагент;
		Движение.Сделка = ЭтотОбъект.СчетНаОплатуПокупателю.Сделка; 		
		Движение.Сумма = (Стр.Сумма + ?(ЭтотОбъект.СуммаВключаетНДС, 0, Стр.СуммаНДС)) * ЭтотОбъект.КурсВзаиморасчетов / ЭтотОбъект.КратностьВзаиморасчетов; 
				
	КонецЦикла;
	
	Для Каждого Стр Из ЭтотОбъект.АгентскиеУслуги Цикл
		
		Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ЭтотОбъект.Дата;
		Движение.Номенклатура = Стр.Номенклатура;
		Движение.Контрагент = Стр.Контрагент;
		Движение.Сделка = ЭтотОбъект.СчетНаОплатуПокупателю.Сделка; 
		Движение.Сумма = (Стр.Сумма + ?(ЭтотОбъект.СуммаВключаетНДС, 0, Стр.СуммаНДС)) * ЭтотОбъект.КурсВзаиморасчетов / ЭтотОбъект.КратностьВзаиморасчетов;
		
	КонецЦикла; 
	
	Для Каждого Стр Из ЭтотОбъект.Товары Цикл
		
		Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ЭтотОбъект.Дата;
		Движение.Номенклатура = Стр.Номенклатура;
		Движение.Контрагент = ЭтотОбъект.Контрагент;
		Движение.Сделка = ЭтотОбъект.СчетНаОплатуПокупателю.Сделка; 
		Движение.Сумма = (Стр.Сумма + ?(ЭтотОбъект.СуммаВключаетНДС, 0, Стр.СуммаНДС)) * ЭтотОбъект.КурсВзаиморасчетов / ЭтотОбъект.КратностьВзаиморасчетов;
		
	КонецЦикла;
	
КонецПроцедуры

&После("ПриЗаписи")
