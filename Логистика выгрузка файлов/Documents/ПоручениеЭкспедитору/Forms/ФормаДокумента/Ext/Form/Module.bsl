&НаКлиенте
Процедура РеализацииТоваровИУслугРеализацияПриИзменении(Элемент)
	СтрокаТЧ = Элементы.РеализацииТоваровИУслуг.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Реализация", СтрокаТЧ.Реализация);
	
	НайденнаяСтрока = Объект.РеализацииТоваровИУслуг.НайтиСтроки(Отбор);
	
	Если НайденнаяСтрока.Количество() < 2 Тогда
		ДобавитьДанныеРеализацииНаСервере(СтрокаТЧ.Реализация);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДанныеРеализацииНаСервере(Реализация)
	
	ДобавляемыйДокумент = Реализация.ПолучитьОбъект();
	Если ДобавляемыйДокумент.Проведен Тогда
		Для Каждого Стр ИЗ ДобавляемыйДокумент.Услуги Цикл
			НоваяСтрока = Объект.СоставНоменклатуры.Добавить();
			НоваяСтрока.Содержание = Стр.Содержание;
			НоваяСтрока.Количество = Стр.Количество;
			НоваяСтрока.Цена = Стр.Цена;
			НоваяСтрока.Сумма = Стр.Сумма;
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
			НоваяСтрока.Документ = ДобавляемыйДокумент.Ссылка;
			НоваяСтрока.Валюта = ДобавляемыйДокумент.ВалютаДокумента;
			НоваяСтрока.СтавкаНДС = Стр.СтавкаНДС;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетыКомитентамОтчетКомитентуПриИзменении(Элемент)
	СтрокаТЧ = Элементы.ОтчетыКомитентам.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОтчетКомитенту", СтрокаТЧ.ОтчетКомитенту);
	
	НайденнаяСтрока = Объект.ОтчетыКомитентам.НайтиСтроки(Отбор);
	
	Если НайденнаяСтрока.Количество() < 2 Тогда
		ДобавитьДанныеОтчетаКомитентуНаСервере(СтрокаТЧ.ОтчетКомитенту);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьДанныеОтчетаКомитентуНаСервере(ОтчетКомитенту)
	ДобавляемыйДокумент = ОтчетКомитенту.ПолучитьОбъект();
	Если ДобавляемыйДокумент.Проведен Тогда
		Для Каждого Стр ИЗ ДобавляемыйДокумент.Товары Цикл
			Если Стр.Номенклатура.ВидНоменклатуры.Услуга Тогда
				НоваяСтрока = Объект.СоставНоменклатуры.Добавить();
				НоваяСтрока.Содержание = Стр.Содержание;
				НоваяСтрока.Количество = Стр.Количество;
				НоваяСтрока.Цена = Стр.Цена;
				НоваяСтрока.Сумма = Стр.Сумма;
				НоваяСтрока.Документ = ДобавляемыйДокумент.Ссылка;
				НоваяСтрока.Валюта = ДобавляемыйДокумент.ВалютаДокумента;
				НоваяСтрока.СтавкаНДС = Стр.СтавкаНДС;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеализацииТоваровИУслугПередУдалением(Элемент, Отказ)
	СтрокаТЧ = Элементы.РеализацииТоваровИУслуг.ТекущиеДанные;
	// Сохраним ссылку на старый документ
	мСтарыйДокумент = СтрокаТЧ.Реализация;
	// Удалим данные старого документа в ТЧ СоставНоменклатуры
	УдалитьДанныеДокумента(мСтарыйДокумент);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетыКомитентамПередУдалением(Элемент, Отказ)
	СтрокаТЧ = Элементы.ОтчетыКомитентам.ТекущиеДанные;
	
	мСтарыйДокумент = СтрокаТЧ.ОтчетКомитенту;
	УдалитьДанныеДокумента(мСтарыйДокумент);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДанныеДокумента(Документ)
	СтруктураДляПоиска = Новый Структура("Документ", Документ);
	МассивУдаляемыхСтрок = Объект.СоставНоменклатуры.НайтиСтроки(СтруктураДляПоиска);
	Для Каждого Строка Из МассивУдаляемыхСтрок Цикл 
		Объект.СоставНоменклатуры.Удалить(Строка); 
		
	КонецЦикла;
	
КонецПроцедуры

