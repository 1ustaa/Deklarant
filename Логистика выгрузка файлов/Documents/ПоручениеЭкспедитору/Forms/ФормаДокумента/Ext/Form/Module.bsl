Перем мСтарыйДокумент;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		Элементы.ДокументОснование.Видимость = Истина;	
		
		Элементы.ФормаЗаполнитьПоСделке.Видимость = Истина;
		
	КонецЕсли;
	
	НЗ = РегистрыСведений.СтатусыОригиналовДокументовПоручениеЭкспедитору.СоздатьНаборЗаписей();
	НЗ.Отбор.Документ.Установить(Объект.Ссылка);
	
	НЗ.Прочитать();
	
	Для Каждого Запись Из НЗ Цикл
		
		ЭтотОбъект.ОригиналПорученияЭкспедиторуПолучен = Запись.ОригиналПорученияЭкспедиторуПолучен;
		ЭтотОбъект.ОригиналПриложенияКДоговоруПолучен = Запись.ОригиналПриложенияКДоговоруПолучен;
		
	КонецЦикла;
	
КонецПроцедуры

