&НаСервере
Процедура ЗаполнитьПоСделкеНаСервере() 
	
	СписокРеализацийИОтчетовКомитенту = ПолучитьСписокРеализацийИОтчетовКомитентуПоСделке();
	
	Для Каждого Стр Из СписокРеализацийИОтчетовКомитенту Цикл
		
		Если ТипЗнч(Стр) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СтрТЧ = Объект.РеализацииТоваровИУслуг.Добавить();
			СтрТЧ.Реализация = Стр; 
			
			СоставНоменклатуры = ПолучитьСоставНоменклатурыРеализации(Стр);
			
			Для Каждого СтрНом Из СоставНоменклатуры Цикл
				
				СтрТЧНом = Объект.СоставНоменклатуры.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрТЧНом, СтрНом);
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Стр) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			
			СтрТЧ = Объект.ОтчетыКомитентам.Добавить();
			СтрТЧ.ОтчетКомитенту = Стр; 
			
			СоставНоменклатуры = ПолучитьСоставНоменклатурыОтчетаКомитенту(Стр);
			
			Для Каждого СтрНом Из СоставНоменклатуры Цикл
				
				СтрТЧНом = Объект.СоставНоменклатуры.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрТЧНом, СтрНом);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокРеализацийИОтчетовКомитентуПоСделке()
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	РеализацияТоваровУслуг.Проведен = ИСТИНА
	               |	И РеализацияТоваровУслуг.СчетНаОплатуПокупателю.Сделка.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровУслуг.Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОтчетКомитентуОПродажах.Ссылка
	               |ИЗ
	               |	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	               |ГДЕ
	               |	ОтчетКомитентуОПродажах.ДокументОснование.Ссылка = &Ссылка
	               |	И ОтчетКомитентуОПродажах.Проведен = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтчетКомитентуОПродажах.Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Массив.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции 

&НаСервере   
Функция ПолучитьСоставНоменклатурыРеализации(Док) 
	
	МассивНоменклатуры = Новый Массив;
	
	ДобавляемыйДокумент = Док.ПолучитьОбъект();
	
	Для Каждого Стр ИЗ ДобавляемыйДокумент.Услуги Цикл 
		
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Содержание", Стр.Содержание);
		НоваяСтрока.Вставить("Количество", Стр.Количество);
		НоваяСтрока.Вставить("Цена", Стр.Цена);
		НоваяСтрока.Вставить("Сумма", Стр.Сумма);
		НоваяСтрока.Вставить("СуммаНДС", Стр.СуммаНДС);
		НоваяСтрока.Вставить("Документ", ДобавляемыйДокумент.Ссылка);
		НоваяСтрока.Вставить("Валюта", ДобавляемыйДокумент.ВалютаДокумента);
		НоваяСтрока.Вставить("СтавкаНДС", Стр.СтавкаНДС); 
		
		МассивНоменклатуры.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

&НаСервере   
Функция ПолучитьСоставНоменклатурыОтчетаКомитенту(Док) 
	
	МассивНоменклатуры = Новый Массив;
	
	ДобавляемыйДокумент = Док.ПолучитьОбъект();
	
	Для Каждого Стр ИЗ ДобавляемыйДокумент.Товары Цикл 
		
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Содержание", Стр.Содержание);
		НоваяСтрока.Вставить("Количество", Стр.Количество);
		НоваяСтрока.Вставить("Цена", Стр.Цена);
		НоваяСтрока.Вставить("Сумма", Стр.Сумма);
		НоваяСтрока.Вставить("СуммаНДС", Стр.СуммаНДС);
		НоваяСтрока.Вставить("Документ", ДобавляемыйДокумент.Ссылка);
		НоваяСтрока.Вставить("Валюта", ДобавляемыйДокумент.ВалютаДокумента);
		НоваяСтрока.Вставить("СтавкаНДС", Стр.СтавкаНДС); 
		
		МассивНоменклатуры.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоСделке(Команда) 
	
	Объект.СоставНоменклатуры.Очистить();
	Объект.РеализацииТоваровИУслуг.Очистить();
	Объект.ОтчетыКомитентам.Очистить();
	
	ЗаполнитьПоСделкеНаСервере();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи) 
	
	НЗ = РегистрыСведений.СтатусыОригиналовДокументовПоручениеЭкспедитору.СоздатьНаборЗаписей();
	НЗ.Отбор.Документ.Установить(Объект.Ссылка);
	
	НЗ.Прочитать();
	
	Если НЗ.Количество() > 0 Тогда
		
		Для Каждого Запись Из НЗ Цикл
			
			Запись.ОригиналПорученияЭкспедиторуПолучен = ЭтотОбъект.ОригиналПорученияЭкспедиторуПолучен;
			Запись.ОригиналПриложенияКДоговоруПолучен = ЭтотОбъект.ОригиналПриложенияКДоговоруПолучен;
			
		КонецЦикла;
		
		НЗ.Записать();
		
	Иначе
		
		Если ЭтотОбъект.ОригиналПорученияЭкспедиторуПолучен ИЛИ ЭтотОбъект.ОригиналПриложенияКДоговоруПолучен Тогда
			
			Запись = РегистрыСведений.СтатусыОригиналовДокументовПоручениеЭкспедитору.СоздатьМенеджерЗаписи();
			Запись.Документ = Объект.Ссылка;
			Запись.ОригиналПорученияЭкспедиторуПолучен = ЭтотОбъект.ОригиналПорученияЭкспедиторуПолучен;
			Запись.ОригиналПриложенияКДоговоруПолучен = ЭтотОбъект.ОригиналПриложенияКДоговоруПолучен;
			Запись.Записать();  
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
