&НаСервере
Функция НайтиСФПоОснованию(Основание)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СчетФактураВыданный.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	                      |ГДЕ
	                      |	СчетФактураВыданный.ДокументОснование = &Основание");
	
	Запрос.УстановитьПараметр("Основание", Основание);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли
КонецФункции

&НаСервере
Функция ТабДокУПД(Сф)	
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Сф);
	
	НастройкиПечати = УчетНДСВызовСервера.ПолучитьНастройкиПечатиУниверсальныхПередаточныхДокументов(
	МассивОбъектов);
	
	ЕстьСчетаФактурыВыданные   = Ложь;
	ЕстьСчетаФактурыПолученные = Ложь;
	
	Для каждого Объект Из НастройкиПечати.УниверсальныеПередаточныеДокументы Цикл
		Если ТипЗнч(Объект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			ЕстьСчетаФактурыВыданные = Истина;
			Прервать;
		ИначеЕсли ТипЗнч(Объект) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			ЕстьСчетаФактурыПолученные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(НастройкиПечати.СписокМакетов) = Тип("Строка") Тогда
		ИменаМакетов = СтрРазделить(НастройкиПечати.СписокМакетов,",");	
	КОнецЕсли;
	
	ТекстЗапроса = "";
	ОбъектыПечати = Новый СписокЗначений();
	ТаблицаМакетовУПД = УчетНДС.ТаблицаМакетовУПД(); 
	ПараметрыПечати = ПолучитьПараметрыПечати();
	ВременнаяКоллекцияДляОднойПечатнойФормы = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(НастройкиПечати.СписокМакетов);
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
	
	Для Каждого МакетУПД ИЗ ТаблицаМакетовУПД Цикл 
		Если МакетУПД.Статус <> "1" Тогда
			Продолжить;
		КонецЕсли; 
		
		Если УправлениеПечатью.НужноПечататьМакет(ВременнаяКоллекцияДляОднойПечатнойФормы, МакетУПД.ИДМакета) Тогда
			Если ЕстьСчетаФактурыВыданные Тогда
				ТекстЗапроса = Документы.СчетФактураВыданный.ТекстЗапросаПечатьСчетовФактур(
				МакетУПД.ВерсияПостановленияНДС1137, Истина, МакетУПД.ПрослеживаемыеТовары);
			Иначе
				ТекстЗапроса = Документы.СчетФактураПолученный.ТекстЗапросаПечатьСчетовФактур(
				МакетУПД.ВерсияПостановленияНДС1137, МакетУПД.ПрослеживаемыеТовары);
			КонецЕсли;
			
			СтруктураПараметровПечати = УчетНДС.НовыйСтруктураПараметровПечатиУПД_УКД();
			СтруктураПараметровПечати.МассивОбъектов              = НастройкиПечати.УниверсальныеПередаточныеДокументы;
			СтруктураПараметровПечати.ОбъектыПечати               = ОбъектыПечати;
			СтруктураПараметровПечати.ТекстЗапросаДокументам      = ТекстЗапроса;
			СтруктураПараметровПечати.ТолькоПередаточныйДокумент  = Ложь;
			СтруктураПараметровПечати.ТабДокумент                 = Неопределено;
			СтруктураПараметровПечати.ПараметрыПечати             = ПараметрыПечати;
			СтруктураПараметровПечати.КлючПараметровПечати        = МакетУПД.КлючПараметровПечати;
			СтруктураПараметровПечати.ПолныйПутьКМакету           = МакетУПД.ПолныйПутьКМакету;
			СтруктураПараметровПечати.ПараметрыВывода             = ПараметрыВывода;
			
			ТабличныйДокумент = УчетНДС.ПечатьУниверсальныхПередаточныхДокументов(СтруктураПараметровПечати);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработатьФаксимилеТабДок(ТабличныйДокумент);
		
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция ТабДокСчет(Сч)
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами",Ложь);
	ПараметрыПечати.Вставить("ВыводитьКоносамент",Истина);
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Сч);
	
	ОбъектыПечати = Новый СписокЗначений;
	
	ОбъектыПечатиВрем = ОбщегоНазначенияКлиентСервер.СкопироватьСписокЗначений(ОбъектыПечати);
	
	СоответствиеСчетовРеализациям = Неопределено;
	ДокументыБезСчетовНаОплату = Неопределено;
	ТаблицаСведенийСчетНаОплату = Документы.СчетНаОплатуПокупателю.ПолучитьТаблицуСведенийСчетаНаОплату(
			МассивОбъектов, СоответствиеСчетовРеализациям, ДокументыБезСчетовНаОплату);
	
	ТабличныйДокумент = ПечатьТорговыхДокументов.ПечатьСчетаНаОплату(ТаблицаСведенийСчетНаОплату,ОбъектыПечатиВрем,ПараметрыПечати);	
	
	ОбработатьФаксимилеТабДок(ТабличныйДокумент);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция ТабДокАкт(Акт)
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ВидДокументаПечати",  "РеализацияТоваровУслуг");
	ПараметрыПечати.Вставить("ИмяПараметровПечати", "ПАРАМЕТРЫ_ПЕЧАТИ_РеализацияТоваровУслуг_Акт");
	ПараметрыПечати.Вставить("ИмяМакетаПечати",     "Документ.РеализацияТоваровУслуг.ПФ_MXL_Акт");
	ПараметрыПечати.Вставить("ВыводитьКоносамент", Истина);
	ПараметрыПечати.Вставить("ОтслеживатьОригинал", Истина); 
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами",Ложь);
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечатиВрем = ОбщегоНазначенияКлиентСервер.СкопироватьСписокЗначений(ОбъектыПечати);
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Акт);
	
	ТаблицаСведенийАктаОбОказанииУслуг = Документы.РеализацияТоваровУслуг.ПолучитьТаблицуСведенийАктаОбОказанииУслуг(МассивОбъектов);
	
	ТабличныйДокумент = ПечатьТорговыхДокументов.ПечатьАктаОбОказанииУслуг(ТаблицаСведенийАктаОбОказанииУслуг, ОбъектыПечати, ПараметрыПечати);	
	
	ОбработатьФаксимилеТабДок(ТабличныйДокумент);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция ТабДокОтчет(Отчет)
		
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечатиВрем = ОбщегоНазначенияКлиентСервер.СкопироватьСписокЗначений(ОбъектыПечати);
	
