&НаСервере
Функция ТабДокСФ(СФ)
	
	ПорядокПримененияФормСФ = 
		УчетНДСПереопределяемый.СоответствиеВерсийПостановленияФормамСчетовФактур();
		
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();	
		
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами",Ложь);
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(СФ);
	
	НастройкиПечати = УчетНДСВызовСервера.ПолучитьНастройкиПечатиСчетовФактур(МассивОбъектов);
	
	ОбъектыПечати = Новый СписокЗначений;
	
	ОбъектыПечатиВрем = ОбщегоНазначенияКлиентСервер.СкопироватьСписокЗначений(ОбъектыПечати);
	
	СоответствиеСчетовРеализациям = Неопределено;
	ДокументыБезСчетовНаОплату = Неопределено;
	ТаблицаСведенийСчетНаОплату = Документы.СчетНаОплатуПокупателю.ПолучитьТаблицуСведенийСчетаНаОплату(
			МассивОбъектов, СоответствиеСчетовРеализациям, ДокументыБезСчетовНаОплату);
	
	ТабличныйДокумент = УчетНДС.ПечатьСчетовФактур1096(
			МассивОбъектов,
			ОбъектыПечати,
			Документы.СчетФактураВыданный.ТекстЗапросаПечатьСчетовФактур(ПорядокПримененияФормСФ["СчетФактура1096"]),
			ПараметрыПечати,
			ПараметрыВывода);	
	
	ОбработатьФаксимилеТабДок(ТабличныйДокумент);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Процедура ОбработатьФаксимилеТабДок(ТабличныйДокумент)

	ФайлыПечатиИПодписи = Справочники.Организации.ПодписиИПечатиОрганизации(Справочники.Организации.ОрганизацияПоУмолчанию(), ТекущаяДата());
	
	Для Каждого Рис ИЗ ТабличныйДокумент.Рисунки Цикл
				
		Если СтрНайти(Рис.Имя,"Печать") <> 0 И ФаксимилеИспользуется Тогда
			Рис.Картинка = ФайлыПечатиИПодписи["ФаксимилеПечать"];
		ИначеЕсли СтрНайти(Рис.Имя,"Руководитель") <> 0 И ФаксимилеИспользуется Тогда
			Рис.Картинка = ФайлыПечатиИПодписи["ФаксимилеРуководитель"];
		Иначе
			Рис.ВыводитьНаПечать = Ложь;	
		КОнецЕсли;
		
		Рис.ГраницаСверху = Ложь;
		Рис.ГраницаСлева = Ложь;
		Рис.ГраницаСнизу = Ложь;
		Рис.ГраницаСправа = Ложь;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыПечати()
	
	ПараметрыПечати = Новый Структура;
	
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", ЛОЖЬ);
	ПараметрыПечати.Вставить("ИдентификаторВКомплекте", "УниверсальныйПередаточныйДокументКомплект");
	ПараметрыПечати.Вставить("ОтслеживатьОригинал", Истина);
	
	Возврат ПараметрыПечати;
	
КонецФункции

&НаСервере
Функция ПолучитьРез()

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	                      |ГДЕ
	                      |	РеализацияТоваровУслуг.Номер = &Номер");
	Запрос.УстановитьПараметр("Номер", "ДЦ00-000003");
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;	
	КонецЕсли;	

КОнецФункции

&НаКлиенте
Процедура ПослеПодключенияРасширения(Подключено, ДопПараметры) Экспорт
	
	Если Подключено Тогда
		
		Попытка
			Если ДопПараметры.МассивФайлов.Количество <> 0 Тогда 
				ДанныеФайла = ДопПараметры.МассивФайлов[0];
				СсылкаНаФайл = ПоместитьВоВременноеХранилище(ДанныеФайла.ДвоичныеДанные, Новый УникальныйИдентификатор);
			КонецЕсли;
			
			//СсылкаНаФайл = ПолучитьСсылкуНаФайл(ДопПараметры.МассивФайлов);
			
			Если НЕ ЭтоАдресВременногоХранилища(СсылкаНаФайл) Тогда   
				
				ПоказатьПредупреждение(Новый ОписаниеОповещения(), "Файл не найден", 0, "Ошибка при выгрузке");
				
				Возврат; 
				
			КонецЕсли;
			
			ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
			ПараметрыДиалогаПолученияФайлов.ВыборКаталога = Истина;
			ПараметрыДиалогаПолученияФайлов.Заголовок = "Выберите каталог сохранения файла";
			
			НачатьПолучениеФайлаССервера(СсылкаНаФайл, ДанныеФайла.ИмяФайла, ПараметрыДиалогаПолученияФайлов);
			
		Исключение	
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось записать файл. Возможно, недостаточно места на диске, диск защищен от записи или не подключено расширение для работы с файлами.";
			Сообщение.Сообщить();  
			
		КонецПопытки;	
		
	ИначеЕсли ДопПараметры.УстановитьЕслиНеПодключено Тогда
		
		НачатьУстановкуРасширенияРаботыСФайлами(
            Новый ОписаниеОповещения(
                "ПодключитьРасширениеРаботыСФайламиНаКлиенте",
                ЭтотОбъект,
                Новый Структура("УстановитьЕслиНеПодключено, МассивФайлов", Ложь, ДопПараметры.МассивФайлов)));
		
	Иначе
		
		ПоказатьПредупреждение( , НСтр("ru = 'Для выполнения данной операции вам нужно установить расширение работы с файлами.'"));
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПодключитьРасширениеРаботыСФайламиНаКлиенте(ДопПараметры) Экспорт
	
	ОповещениеОПодключенииРасширенияРаботыСФайлами = Новый ОписаниеОповещения("ПослеПодключенияРасширения", ЭтотОбъект, ДопПараметры);
	
	НачатьПодключениеРасширенияРаботыСФайлами(ОповещениеОПодключенииРасширенияРаботыСФайлами);
	
КонецПроцедуры



















