	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументСделка.Ссылка КАК Ссылка,
	ДокументСделка.ПометкаУдаления КАК ПометкаУдаления,
	ДокументСделка.Номер КАК Номер,
	ДокументСделка.Дата КАК Дата,
	ДокументСделка.Проведен КАК Проведен,
	ДокументСделка.Организация КАК Организация,
	ДокументСделка.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА ДокументСделка.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Грузополучатели.ПустаяСсылка)
			ТОГДА ДокументСделка.Контрагент.Наименование
		ИНАЧЕ ДокументСделка.Контрагент.Наименование + "/" + ДокументСделка.Грузополучатель.Наименование
	КОНЕЦ КАК Контрагент,
	ДокументСделка.Коносамент КАК Коносамент,
	ДокументСделка.НомерИсходящий КАК НомерИсходящий,
	ДокументСделка.Комментарий КАК Комментарий,
	ДокументСделка.ПортПрибытия КАК ПортПрибытия,
	ДокументСделка.ПортОтгрузки КАК ПортОтгрузки,
	ДокументСделка.Судно КАК Судно,
	ДокументСделка.Груз КАК Груз,
	ДокументСделка.РежимВывоза КАК РежимВывоза,
	ДокументСделка.ПрипортовойТерминал КАК ПрипортовойТерминал,
	ДокументСделка.ВидТранспорта КАК ВидТранспорта,
	ДокументСделка.УсловиеПоставки КАК УсловиеПоставки,
	ДокументСделка.ДопРасходыПоАвтотранспортуОтсутствуют КАК ДопРасходыПоАвтотранспортуОтсутствуют,
	ДокументСделка.Вид КАК Вид,
	ДокументСделка.Ставка КАК Ставка,
	ВЫБОР
		КОГДА ДокументСделка.Агент = ЗНАЧЕНИЕ(Справочник.АгентыЛиний.ПустаяСсылка)
			ТОГДА ДокументСделка.Линия.Наименование
		ИНАЧЕ ДокументСделка.Линия.Наименование + "/" + ДокументСделка.Агент.Наименование
	КОНЕЦ КАК Линия,
	ДанныеСделокДляВыводаВСписках.Контейнер КАК Контейнер,
	ДанныеСделокДляВыводаВСписках.Вес КАК Вес,
	ДанныеСделокДляВыводаВСписках.РазмерКонтейнера КАК РазмерКонтейнера,
	ДанныеСделокДляВыводаВСписках.ТипКонтейнера КАК ТипКонтейнера,
	ДанныеСделокДляВыводаВСписках.ПеревозчикАвтотранспорт КАК Перевозчик,
	ДанныеСделокДляВыводаВСписках.Количество КАК Количество,
	ДанныеСделокДляВыводаВСписках.ДатаВыгрузкиСуднаДО КАК ДатаВыгрузкиСуднаДО,
	ДанныеСделокДляВыводаВСписках.ДатаОкончанияДействияРелиза КАК ДатаОкончанияДействияРелиза,
	ДанныеСделокДляВыводаВСписках.ДатаВывозаИзПорта КАК ДатаВывозаИзПорта,
	ДанныеСделокДляВыводаВСписках.ДатаВыгрузкиУКлиента КАК ДатаВыгрузкиУКлиента,
	ДанныеСделокДляВыводаВСписках.ДатаСдачиПорожнегоКонтейнера КАК ДатаСдачиПорожнегоКонтейнера,
	ДокументСделка.ДатаВыходаИзПортаОтгрузки КАК ДатаВыходаИзПортаОтгрузки,
	ДокументСделка.ДатаПрибытия КАК ДатаПрибытия,
	NULL КАК ВидыФайлов,
	ДокументСделка.КомментарийНДС КАК КомментарийНДС,
	СтатусыСделок.Статус КАК Статус,
	СтатусыСделок.ПодстатусОплатаВЛинию КАК ПодстатусОплатаВЛинию,
