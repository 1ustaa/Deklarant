
&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	ТекДень = ТекущаяДата();
	
	Прошлое = ТекущаяДата() - 86400 * 15;
	Будущее = ТекущаяДата() + 86400 * 15;
	
	Список.Параметры.УстановитьЗначениеПараметра("Контрагенты",КонтрагентПоПользователю());
	Список.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь",ТекПользователь());
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Контрагенты",КонтрагентПоПользователю());
	
	Отбор = СписокДокументов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	Отбор.ПравоеЗначение = НачалоДня(Прошлое);
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
	Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Отбор.Использование = Истина;
	
	Отбор = СписокДокументов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	Отбор.ПравоеЗначение = КонецДня(Будущее);
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата"); 
	Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Отбор.Использование = Истина;
	
	СписокАктовСверки.Параметры.УстановитьЗначениеПараметра("Контрагенты",КонтрагентПоПользователю());
	СписокПрисоединенныеФайлы.Параметры.УстановитьЗначениеПараметра("Контрагенты",КонтрагентПоПользователю());
	СписокСчета.Параметры.УстановитьЗначениеПараметра("Контрагенты",КонтрагентПоПользователю());
	СписокПлатежи.Параметры.УстановитьЗначениеПараметра("Контрагенты",КонтрагентПоПользователю()); 
	
КонецПроцедуры

