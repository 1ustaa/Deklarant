&НаКлиенте
Процедура Фильтр(Команда)
	
	ТекСтраница = Элементы.ГруппаСтраницаСписокСделок.ТекущаяСтраница.Имя;
	
	Оп = Новый ОписаниеОповещения("ПослеЗакрытияФильтра",ЭтаФорма, ТекСтраница);
	
	ДопПараметры = Новый Структура;
	дПериод = Новый СтандартныйПериод;
	ПкдДата = Новый ПолеКомпоновкиДанных("Дата");
		
	ТекСписок = ОпределитьТекСписок(ТекСтраница);
	
	Для Каждого Стр ИЗ ТекСписок.Отбор.Элементы Цикл
		
		Если Стр.ЛевоеЗначение = ПкдДата Тогда
			Если Стр.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
				дПериод.ДатаНачала = Стр.ПравоеЗначение;
			ИначеЕсли Стр.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
				дПериод.ДатаОкончания = Стр.ПравоеЗначение;
			КонецЕсли;
		Иначе
			ДопПараметры.Вставить(Стр.ЛевоеЗначение, Стр.ПравоеЗначение);	
		КонецЕсли;
				
	КонецЦикла;
	
	Если ЗначениеЗаполнено(дПериод.ДатаНачала) Или ЗначениеЗаполнено(дПериод.ДатаОкончания) Тогда
		ДопПараметры.Вставить("Период", дПериод);	
	КОнецЕсли;
	
	ОткрытьФорму("Документ.Сделка.Форма.ФормаОтбора",ДопПараметры,ЭтаФорма,,,,Оп,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФильтра(Результат, ДопПараметры) Экспорт
	
	Если ДопПараметры <> Неопределено Тогда
			
		ТекСписок = ОпределитьТекСписок(ДопПараметры);
		
	КонецЕсли;
	
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ТекСписок.Отбор.Элементы.Очистить();
		
		Для Каждого Ключ ИЗ Результат Цикл
			
			Если Ключ.Ключ = "Период" Тогда
				
				Отбор = ТекСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
				Отбор.ПравоеЗначение = Ключ.Значение.ДатаНачала;
				Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
				Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				Отбор.Использование = Истина;
				
				Отбор = ТекСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
				Отбор.ПравоеЗначение = Ключ.Значение.ДатаОкончания;
				Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата"); 
				Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				Отбор.Использование = Истина;
				
			ИначеЕсли Ключ.Ключ = "Контейнер" Тогда
				
				Отбор = ТекСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
				Отбор.ПравоеЗначение = Ключ.Значение;
				Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Ключ.Ключ);
				Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				Отбор.Использование = Истина;	
				
			Иначе
				
				Отбор = ТекСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				Отбор.ПравоеЗначение = Ключ.Значение;
				Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Ключ.Ключ);
				Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				Отбор.Использование = Истина;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

