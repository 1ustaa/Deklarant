&НаКлиенте
Процедура ПослеПодключенияРасширения(Подключено, ДопПараметры) Экспорт
	
	Если Подключено Тогда
		
		Попытка
			
			ИмяФайла = СокрП(ДопПараметры.ИмяФайла);
			
			//ВремФайл = ОбработатьИмяВремФайла(ПолучитьИмяВременногоФайла("pdf"), ИмяФайла);
			ВремФайл = ИмяФайла+".pdf";
			
			ДопПараметры.ТабличныйДокумент.Записать(ВремФайл,ТипФайлаТабличногоДокумента.PDF);
			Файл = Новый Файл(ВремФайл);
			
			ДД = Новый ДвоичныеДанные(Файл.ПолноеИмя);
			
			СсылкаНаФайл = ПоместитьВоВременноеХранилище(ДД, Новый УникальныйИдентификатор);
			
			СтруктураФайла = Новый Структура;
			СтруктураФайла.Вставить("ДвоичныеДанные", ДД);
			СтруктураФайла.Вставить("ИмяФайла", Файл.Имя);
			СтруктураФайла.Вставить("ПутьФайла", Файл.ПолноеИмя);
			
			МассивФайлов = Новый Массив;
			МассивФайлов.Добавить(СтруктураФайла);
			
			СтруктураВозврата = Новый Структура;
			СтруктураВозврата.Вставить("МассивФайлов",МассивФайлов);
			
			Если МассивФайлов.Количество <> 0 Тогда 
				ДанныеФайла = МассивФайлов[0];
				СсылкаНаФайл = ПоместитьВоВременноеХранилище(ДанныеФайла.ДвоичныеДанные, Новый УникальныйИдентификатор);
			КонецЕсли;
			
			//СсылкаНаФайл = ПолучитьСсылкуНаФайл(ДопПараметры.МассивФайлов);
			
			Если НЕ ЭтоАдресВременногоХранилища(СсылкаНаФайл) Тогда   
				
				ПоказатьПредупреждение(Новый ОписаниеОповещения(), "Файл не найден", 0, "Ошибка при выгрузке");
				
				Возврат; 
				
			КонецЕсли;
			
			ПараметрыДиалогаПолученияФайлов = Новый ПараметрыДиалогаПолученияФайлов;
			ПараметрыДиалогаПолученияФайлов.ВыборКаталога = Истина;
			ПараметрыДиалогаПолученияФайлов.Заголовок = "Выберите каталог сохранения файла";
			
			НачатьПолучениеФайлаССервера(СсылкаНаФайл, ДанныеФайла.ИмяФайла, ПараметрыДиалогаПолученияФайлов);
			
		Исключение	
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось записать файл. Возможно, недостаточно места на диске, диск защищен от записи или не подключено расширение для работы с файлами.";
			Сообщение.Сообщить();  
			
		КонецПопытки;	
		
	ИначеЕсли ДопПараметры.УстановитьЕслиНеПодключено Тогда
		
		НачатьУстановкуРасширенияРаботыСФайлами(
            Новый ОписаниеОповещения(
                "ПодключитьРасширениеРаботыСФайламиНаКлиенте",
                ЭтотОбъект,
                Новый Структура("УстановитьЕслиНеПодключено, МассивФайлов", Ложь, ДопПараметры.МассивФайлов)));
		
	Иначе
		
		ПоказатьПредупреждение( , НСтр("ru = 'Для выполнения данной операции вам нужно установить расширение работы с файлами.'"));
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПодключитьРасширениеРаботыСФайламиНаКлиенте(ДопПараметры) Экспорт
	
	ОповещениеОПодключенииРасширенияРаботыСФайлами = Новый ОписаниеОповещения("ПослеПодключенияРасширения", ЭтотОбъект, ДопПараметры);
	
	НачатьПодключениеРасширенияРаботыСФайлами(ОповещениеОПодключенииРасширенияРаботыСФайлами);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФорму(Команда)

	ТекСтраница = Элементы.ГруппаСтраницаСписокСделок.ТекущаяСтраница.Имя;
	
	Оп = Новый ОписаниеОповещения("ПослеЗакрытияИзмененияФормы",ЭтаФорма, ТекСтраница);
	
	Если ТекСтраница = "Сделки" Тогда
		ТекСписок = Элементы.Список;	
	ИначеЕсли ТекСтраница = "ФинансовыеДокументы" Тогда	
		ТекСписок = Элементы.СписокДокументов;	
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	
	КолонкиВидимость = Новый Соответствие;
	КолонкиПорядок = Новый Соответствие;
	
	Порядок = 1;
	
	Для Каждого Эл ИЗ ТекСписок.ПодчиненныеЭлементы Цикл
		
		КолонкиВидимость.Вставить(Эл.Имя, Эл.Видимость);
		КолонкиПорядок.Вставить(Эл.Имя, Порядок);	
		Порядок = Порядок + 1;
		
	КонецЦикла;
	
	ДопПараметры.Вставить("Колонки", КолонкиВидимость);
	ДопПараметры.Вставить("КолонкиПорядок", КолонкиПорядок);
	
	ОткрытьФорму("Документ.Сделка.Форма.ФормаИзменитьСоставИПорядокКолонок",ДопПараметры,ЭтаФорма,,,,Оп,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияИзмененияФормы(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
				
		Индекс = 0;
		
		Пока Индекс <> Результат.Количество() - 1 Цикл
			
			ПереместитьНаСервере(Результат[Индекс].ИмяКолонки, ДопПараметры, Результат[Индекс+1].ИмяКолонки);	
			Элементы[Результат[Индекс].ИмяКолонки].Видимость = Результат[Индекс].Использовать;
			Индекс = Индекс + 1;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Функция ОпределитьТекСписок(ТекСтраница)

	Если ТекСтраница = "Сделки" Тогда
		ТекСписок = Список;	
	ИначеЕсли ТекСтраница = "ФинансовыеДокументы" Тогда	
		ТекСписок = СписокДокументов;	
	КонецЕсли;
	
	Возврат ТекСписок;
	
КонецФункции

&НаСервере
Процедура ПереместитьНаСервере(ЭлПереноса, ДопПараметры, ЭлПеред)
	
	Если ДопПараметры = "Сделки" Тогда
		ТекСписок = Элементы.Список;	
	ИначеЕсли ДопПараметры = "ФинансовыеДокументы" Тогда	
		ТекСписок = Элементы.СписокДокументов;	
	КонецЕсли;
	
	Элементы.Переместить(Элементы[ЭлПереноса], ТекСписок, Элементы[ЭлПеред]);		
	
КонецПроцедуры


&НаКлиенте
Процедура ИсторияСтатусов(Команда)
	ТекСделка = Элементы.Список.ТекущаяСтрока;
	Парам = Новый Структура("Ключ",ТекСделка);
	ОткрытьФорму("Документ.Сделка.Форма.ФормаИсторииСтатусов",Парам,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура СписокПрисоединенныеФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	 
	Если Элементы.СписокПрисоединенныеФайлы.РежимВыбора Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СписокПрисоединенныеФайлы.ТекущиеДанные;
	
	Если Элементы.СписокПрисоединенныеФайлы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(ТекущиеДанные.Ссылка,
		Неопределено, УникальныйИдентификатор, Неопределено, "");
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ДанныеФайла", ДанныеФайла);
	Обработчик = Новый ОписаниеОповещения("СписокВыборПослеВыбораРежимаРедактирования", ЭтотОбъект, ПараметрыОбработчика);
	
	РаботаСФайламиСлужебныйКлиент.ВыбратьРежимИРедактироватьФайл(Обработчик, ДанныеФайла, Истина);
	
КонецПроцедуры

