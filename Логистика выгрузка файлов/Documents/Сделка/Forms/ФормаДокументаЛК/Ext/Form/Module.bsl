&НаСервере
Функция ПолучитьОстаткиПеревыставляемыеПоСделке()
	
	ОтменаВыставленияСчета = Ложь;
	
	Для Каждого НомерСтроки ИЗ Элементы.РасходыКлиента.ВыделенныеСтроки Цикл 
		
		СтрокаРасходыКлиента = Объект.РасходыКлиента.НайтиПоИдентификатору(НомерСтроки);	
		
		Если СтрокаРасходыКлиента.Перевыставляемый И НЕ СтрокаРасходыКлиента.Выставлено И НЕ СтрокаРасходыКлиента.Аннулирован Тогда  
			
			Запрос = Новый Запрос;                                                 
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СУММА(ЕСТЬNULL(ПеревыставляемыеТоварыУслугиОстатки.СуммаОстаток, 0)) КАК СуммаОстаток
			|ИЗ
			|	РегистрНакопления.ПеревыставляемыеТоварыУслуги.Остатки(
			|			,
			|			Контрагент = &Контрагент
			|				И Номенклатура = &Номенклатура
			|				И Сделка = &Сделка) КАК ПеревыставляемыеТоварыУслугиОстатки";
			
			Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
			Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
			Запрос.УстановитьПараметр("Номенклатура", СтрокаРасходыКлиента.Номенклатура);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Если Выборка.СуммаОстаток < СтрокаРасходыКлиента.Сумма Тогда
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "По позиции " + СтрокаРасходыКлиента.Номенклатура + " недостаточно суммы остатка. Счет не может быть оформлен.";
					Сообщение.Сообщить();
					
					ОтменаВыставленияСчета = Истина;
					
				КонецЕсли;
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "По позиции " + СтрокаРасходыКлиента.Номенклатура + " нет остатков. Счет не может быть оформлен.";
				Сообщение.Сообщить();
				
				ОтменаВыставленияСчета = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ОтменаВыставленияСчета;
	
	
КонецФункции	

&НаКлиенте
Процедура ВыставитьСчетРасходыКлиента(Команда)	
	
	ЕстьНевыставленныеУслуги = Ложь;
	ЕстьНДС = Ложь;
	
	ФормаДок = ПолучитьФорму("Документ.СчетНаОплатуПокупателю.ФормаОбъекта");
	
	ИндНДС = Истина;
	Для Каждого НомерСтроки ИЗ Элементы.РасходыКлиента.ВыделенныеСтроки Цикл
		
		СтрокаДляОбработки = Объект.РасходыКлиента.НайтиПоИдентификатору(НомерСтроки);
		
		Если (НЕ СтрокаДляОбработки.Выставлено) Тогда
			
			СтрДок = ФормаДок.Объект.Товары.Добавить();
			СтрДок.Номенклатура = СтрокаДляОбработки.Номенклатура;
			СтрДок.Содержание = СтрокаДляОбработки.Содержание;
			СтрДок.Количество = СтрокаДляОбработки.Количество;
			СтрДок.Цена = СтрокаДляОбработки.Цена;
			СтрДок.Сумма = СтрокаДляОбработки.Сумма;
			СтрДок.СтавкаНДС = СтрокаДляОбработки.СтавкаНДС;  
			СтрДок.СуммаНДС =  СтрокаДляОбработки.СуммаНДС;
			СтрДок.Перевыставляемый = СтрокаДляОбработки.Перевыставляемый;
			
			ЕстьНевыставленныеУслуги = Истина;
			
			ЕстьНДСНоменклатуры = ПолучитьРезультатПоСтавкеНДС(СтрДок.СтавкаНДС);
			
			Если (НЕ ЕстьНДС) И ЕстьНДСНоменклатуры И ИндНДС Тогда
				ЕстьНДС = ЕстьНДСНоменклатуры; 
				ИндНДС = Ложь;
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ЕстьНевыставленныеУслуги Тогда  
		
		ФормаДок.Объект.Дата = ТекущаяДата();
		ФормаДок.Объект.Сделка = Объект.Ссылка;
		ФормаДок.Объект.Организация = Объект.Организация;
		ФормаДок.Объект.Контрагент = Объект.Контрагент;
		ФормаДок.Объект.ДоговорКонтрагента = ПолучитьОсновнойДоговорКонтрагентаСПокупателем();
		ФормаДок.Объект.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();
		ФормаДок.Объект.ВалютаДокумента = ПолучитьВалютуПоУмолчанию();
		ФормаДок.Объект.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
		ФормаДок.Объект.ВидОперации = ПолучитьВидОперацииСчетаНаОплатуПокупателю();
		
		ФормаДок.Объект.ДокументБезНДС = НЕ ЕстьНДС;
		
		ЭтаФорма.Модифицированность = Истина;
		
		ФормаДок.Объект.СуммаДокумента = ФормаДок.Объект.Товары.Итог("Сумма");
		
		ФормаДок.Элементы.ДокументОснование.Видимость = Истина;
		
		ФормаДок.Элементы.ДоговорКонтрагента.Доступность = Истина;
		
		ФормаДок.СрокОплаты = РассчитатьСрокОплатыСчета(ФормаДок.Объект.ДоговорКонтрагента);
		
		ФормаДок.Записать();
		
		Для Каждого НомерСтроки ИЗ Элементы.РасходыКлиента.ВыделенныеСтроки Цикл
			
			СтрокаДляОбработки = Объект.РасходыКлиента.НайтиПоИдентификатору(НомерСтроки);
			
			Если НЕ СтрокаДляОбработки.Выставлено Тогда
				
				СтрокаДляОбработки.Выставлено = Истина;
				СтрокаДляОбработки.СчетНаОплату = ФормаДок.Объект.Ссылка;
				
			КонецЕсли;              
			
		КонецЦикла; 
		
		ЭтотОбъект.Записать();
		
		ОбъектФормы = ФормаДок.Объект;
		
		СтруктураНадписи = Новый Структура(
		"ВалютаДокумента, Курс, Кратность, СуммаВключаетНДС, ДокументБезНДС, ВалютаРегламентированногоУчета",
		ОбъектФормы.ВалютаДокумента,
		ОбъектФормы.КурсВзаиморасчетов,
		ОбъектФормы.КратностьВзаиморасчетов,
		ОбъектФормы.СуммаВключаетНДС,
		ОбъектФормы.ДокументБезНДС,
		ФормаДок.ВалютаРегламентированногоУчета);
		
		ФормаДок.ЦеныИВалюта = ОбщегоНазначенияБПКлиентСервер.СформироватьНадписьЦеныИВалюта(СтруктураНадписи);
		
		ФормаДок.Открыть();
		
	КонецЕсли;	
	
КонецПроцедуры 

