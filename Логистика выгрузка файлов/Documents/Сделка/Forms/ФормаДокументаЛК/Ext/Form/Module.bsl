&НаКлиенте
Процедура ВидПриИзменении(Элемент)  
	
	ОбновитьОтображениеЭлементовПоВидуСделки();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	//Попытка
	//	ЗаблокироватьДанныеФормыДляРедактирования();
	//	
	//	ЭтотОбъект.ДатаВремяОткрытияФормы = ТекущаяДата();
	//	
	//Исключение
	//	ЭтаФорма.ТолькоПросмотр = Истина;
	//	ЭтаФорма.Элементы.КонтейнерыУстановитьДатыДляВсехСтрокПоКолонкеКонтейнеры.Доступность = Ложь;
	//	ЭтаФорма.Элементы.РасходыКлиентаВыставитьСчетРасходыКлиента.Доступность = Ложь;
	//	ЭтаФорма.Элементы.РасходыКлиентаВыставитьОтчетКомитенту.Доступность = Ложь;
	//	ЭтаФорма.Элементы.РасходыКлиентаКонвертироватьСуммуUSDПоТекущемуКурсуРасходыКлиента.Доступность = Ложь;
	//	ЭтаФорма.Элементы.РасходыКлиентаАннулироватьРасходКлиента.Доступность = Ложь;
	//	ЭтаФорма.Элементы.РасходыКлиентаКонтейнеры.Доступность = Ложь;
	//	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ". Вам запрещено редактирование документа");
	//КонецПопытки;
	
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();  
		Объект.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		ЭтотОбъект.Статус = Перечисления.СтатусыСделок.Новая;
		
		Объект.Квартал = НачалоКвартала(ТекущаяДата()); 
		Объект.ПодстатусСрочностьСборДокументов = Перечисления.СтатусыСрочностиСборДокументов.Нет;
		
		СтрСтатус = Объект.Статусы.Добавить(); 
		СтрСтатус.Статус = Перечисления.СтатусыСделок.Новая;
		СтрСтатус.Дата = ТекущаяДата();
		СтрСтатус.Пользователь = ПользователиКлиентСервер.ТекущийПользователь(); 
		
		Если Параметры.Свойство("Вид") Тогда
			
			Если Параметры.Вид = "Экспорт" Тогда
				
				Объект.Вид = Перечисления.ВидыСделок.Экспорт;
				Объект.ТипДокументов = Перечисления.ТипыДокументовСборДокументов.Экспорт;
				
			Иначе
				
				Объект.Вид = Перечисления.ВидыСделок[Параметры.Вид];
				Объект.ТипДокументов = Перечисления.ТипыДокументовСборДокументов.Импорт;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Параметры.Свойство("КопированиеСделки") Тогда
			
			Если Параметры.КопированиеСделки Тогда
				
				Если Параметры.Клиент Тогда    
					
					Объект.Контрагент = Параметры.СсылкаНаСделку.Контрагент;
					
				КонецЕсли;
				
				Если Параметры.ПортОтгрузки Тогда    
					
					Объект.ПортОтгрузки = Параметры.СсылкаНаСделку.ПортОтгрузки; 
					
				КонецЕсли; 
				
				Если Параметры.ПортПрибытия Тогда    
					
					Объект.ПортПрибытия = Параметры.СсылкаНаСделку.ПортПрибытия;
					
				КонецЕсли; 
				
				Если Параметры.АгентЛинии Тогда    
					
					Объект.Агент = Параметры.СсылкаНаСделку.Агент;
					
				КонецЕсли;
				
				Если Параметры.ВидТранспорта Тогда    
					
					Объект.ВидТранспорта = Параметры.СсылкаНаСделку.ВидТранспорта;
					
				КонецЕсли;
				
				Если Параметры.Груз Тогда    
					
					Объект.Груз = Параметры.СсылкаНаСделку.Груз;
					
				КонецЕсли;
				
				Если Параметры.Грузополучатель Тогда    
					
					Объект.Грузополучатель = Параметры.СсылкаНаСделку.Грузополучатель;
					
				КонецЕсли;
				
				Если Параметры.Демередж Тогда    
					
					Объект.Демередж = Параметры.СсылкаНаСделку.Демередж;
					
				КонецЕсли; 
				
				Если Параметры.КоличествоГрузовыхМест Тогда    
					
					Объект.КоличествоГрузовыхМест = Параметры.СсылкаНаСделку.КоличествоГрузовыхМест;
					
				КонецЕсли; 
				
				Если Параметры.Линия Тогда    
					
					Объект.Линия = Параметры.СсылкаНаСделку.Линия;
					
				КонецЕсли;
				
				Если Параметры.ПрипортовойТерминал Тогда    
					
					Объект.ПрипортовойТерминал = Параметры.СсылкаНаСделку.ПрипортовойТерминал;
					
				КонецЕсли;
				
				Если Параметры.РежимВывоза Тогда    
					
					Объект.РежимВывоза = Параметры.СсылкаНаСделку.РежимВывоза;
					
				КонецЕсли;
				
				Если Параметры.Судно Тогда    
					
					Объект.Судно = Параметры.СсылкаНаСделку.Судно;
					
				КонецЕсли;
				
				Если Параметры.ТерминальнаяОбработка Тогда    
					
					Объект.ТерминальнаяОбработка = Параметры.СсылкаНаСделку.ТерминальнаяОбработка;
					
				КонецЕсли;
				
				Если Параметры.УсловиеПоставки Тогда    
					
					Объект.УсловиеПоставки = Параметры.СсылкаНаСделку.УсловиеПоставки;
					
				КонецЕсли;
				
				Если Параметры.Фрахт Тогда    
					
					Объект.Фрахт = Параметры.СсылкаНаСделку.Фрахт;
					
				КонецЕсли;
				
				ДобавлятьНовыеСтроки = Ложь;
				
				Если Параметры.ТипКонтейнера ИЛИ Параметры.РазмерКонтейнера ИЛИ Параметры.ПеревозчикиКонтейнеров ИЛИ Параметры.НаправлениеКонтейнеров Тогда
					
					ДобавлятьНовыеСтроки = Истина;
					
				КонецЕсли;  
				
				Если ДобавлятьНовыеСтроки Тогда
					
					Для Каждого Стр Из Параметры.СсылкаНаСделку.Контейнеры Цикл
						
						СтрТЧ = Объект.Контейнеры.Добавить();
						
						Если Параметры.ТипКонтейнера Тогда   	
							
							СтрТЧ.Тип = Стр.Тип; 
							
						КонецЕсли;
						
						Если Параметры.РазмерКонтейнера Тогда
							
							СтрТЧ.Размер = Стр.Размер;
							
						КонецЕсли;
						
						КопированиеСтрокИнформацииОПеревозчике = Ложь;
						
						Если Параметры.ПеревозчикиКонтейнеров Тогда
							
							СтрТЧ.КлючСвязиИнформацияОПеревозчике = Стр.КлючСвязиИнформацияОПеревозчике;
							
							КопированиеСтрокИнформацииОПеревозчике = Истина;
							
						КонецЕсли;
						
						Если Параметры.НаправлениеКонтейнеров Тогда
							
							СтрТЧ.КлючСвязиИнформацияОПеревозчике = Стр.КлючСвязиИнформацияОПеревозчике; 
							
							КопированиеСтрокИнформацииОПеревозчике = Истина;
							
						КонецЕсли; 
						
						Если КопированиеСтрокИнформацииОПеревозчике Тогда
							
							ПараметрыОтбора = Новый Структура("КлючСвязи", Стр.КлючСвязиИнформацияОПеревозчике);
							
							НайденныеСтроки = Параметры.СсылкаНаСделку.ИнформацияОПеревозчиках.НайтиСтроки(ПараметрыОтбора); 
							
							Если НайденныеСтроки.Количество() > 0 Тогда
								
								Для Каждого СтрНайденнаяСтрока ИЗ НайденныеСтроки Цикл
									
									СтрИнформацияОПеревозчиках = Объект.ИнформацияОПеревозчиках.Добавить();
									
									СтрИнформацияОПеревозчиках.КлючСвязи = СтрНайденнаяСтрока.КлючСвязи; 
									
									Если Параметры.ПеревозчикиКонтейнеров Тогда
										
										СтрИнформацияОПеревозчиках.Перевозчик = СтрНайденнаяСтрока.Перевозчик;
										
									КонецЕсли;
									
									Если Параметры.НаправлениеКонтейнеров Тогда
										
										СтрИнформацияОПеревозчиках.Направление = СтрНайденнаяСтрока.Направление; 
										
									КонецЕсли;
									
								КонецЦикла;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Объект.Вид = Параметры.СсылкаНаСделку.Вид;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;  
	
	Если ЛогистикаСервер.ЕстьРоль("ЛогистикаАдминистратор") ИЛИ ЛогистикаСервер.ЕстьРоль("ЛогистикаБухгалтер") Тогда
		
		Элементы.РасходыКлиентаВыставитьОтчетКомитенту.Видимость = Истина;
		Элементы.РасходыКлиентаВыставитьСчетРасходыКлиента.Видимость = Истина;
		
	КонецЕсли;
	
	ОбновитьОтображениеЭлементовПоВидуСделки(); 
	
	ЗаполнитьВизуальноеОтображениеИнформацияОПеревозчиках(); 
	
	РассчитатьВходящиеРасходыПоСделке();  
	
	РасчитатьВходящиеСчетаПоСделке();
	
	ЗаполнитьНеобходимыеДокументы();
	
	ЗаполнитьСтатусыСделки();
	
	ЗаполнитьИсториюСтатусов();
	
	НомерСтатуса = ЛогистикаСервер.ПолучитьНомерСтатуса(ЭтотОбъект.Статус, Объект.Вид);
	
	Если НомерСтатуса > 2 И НомерСтатуса < 8 Тогда
		
		//Элементы.НетСтавки.Видимость = Истина;
		
	Иначе
		
		//Элементы.НетСтавки.Видимость = Ложь;
		
	КонецЕсли;
	
	ДоверенностьБулево = Объект.ЕстьДоверенность = Перечисления.СтатусыДоверенностей.Есть; 
	
	ОбработатьДоступностьЭлементаДатаЗакрытия();
	
	//Элементы.Статусы.ОтборСтрок = Новый ФиксированнаяСтруктура("СтатусыСтатус", Объект.Проживает);
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьИсториюСтатусов()

	Для Каждого Стр ИЗ Объект.Статусы Цикл
		
		Если ТипЗнч(Стр.Статус) = Тип("ПеречислениеСсылка.СтатусыСделок") Тогда
			
			ЗаполнитьЗначенияСвойств(ИсторияСтатусовПросмортр.Добавить(),Стр);	
			
		КонецЕсли;
				
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура РасчитатьВходящиеСчетаПоСделке()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетНаОплатуПоставщикаТовары.Содержание КАК Содержание,
	|	ВЫБОР
	|		КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов <> 0
	|				И НЕ СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов ЕСТЬ NULL
	|			ТОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения * СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов / СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов
	//|		ИНАЧЕ ВЫБОР
	//|				КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов <> 0
	//|						И СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов <> NULL
	//|					ТОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения * СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов
	|				ИНАЧЕ СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения
	//|			КОНЕЦ
	|	КОНЕЦ КАК Сумма,
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения КАК СуммаРаспределения,
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка КАК Документ,
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.ВалютаДокумента КАК Валюта,
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения КАК СуммаВВалюте
	|ИЗ
	|	Документ.СчетНаОплатуПоставщика.РаспределениеСуммПоСделкамТовары КАК СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика.Товары КАК СчетНаОплатуПоставщикаТовары
	|		ПО СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.КлючСвязи = СчетНаОплатуПоставщикаТовары.КлючСвязиРаспределения
	|			И СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка = СчетНаОплатуПоставщикаТовары.Ссылка
	|ГДЕ
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Сделка = &Сделка
	|	И СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Рубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Пока Выборка.Следующий() Цикл
		
		СтрТЧ = ЭтотОбъект.ВходящиеСчета.Добавить();
		СтрТЧ.ПоступлениеУслуг = Выборка.Документ;
		СтрТЧ.Сумма = Выборка.Сумма;
		СтрТЧ.СодержаниеУслуги = Выборка.Содержание;
		
		Если Выборка.Валюта <> Рубли Тогда            
			
			СтрТЧ.Валюта = Выборка.Валюта;
			
			СтрТЧ.СуммаВВалюте = Выборка.СуммаВВалюте;			
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ИтогоВходящиеСчетаСумма = ВходящиеСчета.Итог("Сумма");
	ИтогоВходящиеСчетаСуммаВВалюте = ВходящиеСчета.Итог("СуммаВВалюте");
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСтатусыСделки()
	
	НЗ = РегистрыСведений.СтатусыСделок.СоздатьНаборЗаписей();
	
	НЗ.Отбор.Сделка.Установить(Объект.Ссылка);
	
	НЗ.Прочитать();
	
	Если НЗ.Количество() > 0 Тогда
		
		Статус = НЗ[0].Статус;
		ПодстатусБухгалтерия = НЗ[0].ПодстатусБухгалтерия;
		ПодстатусФинОтдел = НЗ[0].ПодстатусФинОтдел;
		ПодстатусОплатаВЛинию = НЗ[0].ПодстатусОплатаВЛинию;
		
	КонецЕсли;
	
КонецПроцедуры                  

&НаСервере
Процедура ЗаполнитьНеобходимыеДокументы()
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Стр = Объект.СборДокументов.Добавить();
		Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеЭкспедитораСПодписью;
		Стр.Необходим = Истина;
		
		Стр = Объект.СборДокументов.Добавить();
		Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ЭкспедиторскаяРасписка;
		Стр.Необходим = Истина;
		
		Стр = Объект.СборДокументов.Добавить();
		Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПриложениеСПодписьюСДвухСторон;
		Стр.Необходим = Истина;
		
		Стр = Объект.СборДокументов.Добавить();
		Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеРавноПриложение;
		Стр.Необходим = Истина;
		
		Стр = Объект.СборДокументов.Добавить();
		Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.КоносаментСПечатью;
		Стр.Необходим = Истина;
		
		Стр = Объект.СборДокументов.Добавить();
		Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ДТ;
		Стр.Необходим = Истина;
		
		Если Объект.Вид = Перечисления.ВидыСделок.Экспорт Тогда
			
			Стр = Объект.СборДокументов.Добавить();
			Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПогрузПоручениеЭкспорт;
			Стр.Необходим = Истина;
			
		КонецЕсли;
		
	Иначе
		
		Если Объект.ТипДокументов <> Перечисления.ТипыДокументовСборДокументов.Неизвестно Тогда
			
			Если Объект.СборДокументов.Количество() = 0 Тогда
				
				Стр = Объект.СборДокументов.Добавить();
				Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеЭкспедитораСПодписью;
				Стр.Необходим = Истина;
				
				Стр = Объект.СборДокументов.Добавить();
				Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ЭкспедиторскаяРасписка;
				Стр.Необходим = Истина;
				
				Стр = Объект.СборДокументов.Добавить();
				Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПриложениеСПодписьюСДвухСторон;
				Стр.Необходим = Истина;
				
				Стр = Объект.СборДокументов.Добавить();
				Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеРавноПриложение;
				Стр.Необходим = Истина;
				
				Если Объект.ТипДокументов <> Перечисления.ТипыДокументовСборДокументов.Экспедирование Тогда
					
					Стр = Объект.СборДокументов.Добавить();
					Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.КоносаментСПечатью;
					Стр.Необходим = Истина;
					
				КонецЕсли;
				
				Стр = Объект.СборДокументов.Добавить();
				Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ДТ;
				Стр.Необходим = Истина;
				
				Если Объект.Вид = Перечисления.ВидыСделок.Экспорт Тогда
					
					Стр = Объект.СборДокументов.Добавить();
					Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПогрузПоручениеЭкспорт;
					Стр.Необходим = Истина;
					
				КонецЕсли; 
				
			Иначе
				
				ЕстьЭкспедиторскаяРасписка = Ложь;
				ЕстьПриложениеСПодписьюСДвухСторон = Ложь;
				ЕстьПоручениеЭкспедитораСПодписью = Ложь;
				ЕстьПоручениеРавноПриложение = Ложь;
				
				Для Каждого Стр Из Объект.СборДокументов Цикл
					
					Запрос = Новый Запрос;
					
					Запрос.Текст = "ВЫБРАТЬ
					|	ВЫБОР
					|		КОГДА СделкаПрисоединенныеФайлы.Ссылка ЕСТЬ NULL
					|			ТОГДА ЛОЖЬ
					|		ИНАЧЕ ИСТИНА
					|	КОНЕЦ КАК ЕстьФайл
					|ИЗ
					|	Справочник.СделкаПрисоединенныеФайлы КАК СделкаПрисоединенныеФайлы
					|ГДЕ
					|	СделкаПрисоединенныеФайлы.ПометкаУдаления = ЛОЖЬ
					|	И СделкаПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
					|	И СделкаПрисоединенныеФайлы.ВидФайла = &ВидФайла";
					
					Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка); 
					Запрос.УстановитьПараметр("ВидФайла", Стр.ВидДокумента);
					
					Выборка = Запрос.Выполнить().Выбрать();
					
					Пока Выборка.Следующий() Цикл 
						
						Если Выборка.ЕстьФайл Тогда
							
							Стр.Добавлен = Истина;
							
							Если Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ЭкспедиторскаяРасписка Тогда
								
								ЕстьЭкспедиторскаяРасписка = Истина;
								
							ИначеЕсли Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПриложениеСПодписьюСДвухСторон Тогда
								
								ЕстьПриложениеСПодписьюСДвухСторон = Истина;	
								
							ИначеЕсли Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеЭкспедитораСПодписью Тогда
								
								ЕстьПоручениеЭкспедитораСПодписью = Истина;
								
							ИначеЕсли Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеРавноПриложение Тогда
								
								ЕстьПоручениеРавноПриложение = Истина;	
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЦикла;
				
				Для Каждого Стр Из Объект.СборДокументов Цикл
					
					Если (Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ЭкспедиторскаяРасписка ИЛИ Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПриложениеСПодписьюСДвухСторон
						ИЛИ Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеЭкспедитораСПодписью) И ЕстьПоручениеРавноПриложение Тогда
						
						Стр.Необходим = Ложь;
						
					ИначеЕсли Стр.ВидДокумента = Справочники.ВидыПрисоединенныхФайловСделки.ПоручениеРавноПриложение И (ЕстьЭкспедиторскаяРасписка
						ИЛИ ЕстьПриложениеСПодписьюСДвухСторон ИЛИ ЕстьПоручениеЭкспедитораСПодписью) Тогда  
						
						Стр.Необходим = Ложь;
						
						
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьВходящиеРасходыПоСделке()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоступлениеТоваровУслугУслуги.Содержание КАК Содержание,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КратностьВзаиморасчетов <> 0
	|				И НЕ ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КратностьВзаиморасчетов ЕСТЬ NULL
	|			ТОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КурсВзаиморасчетов / ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КратностьВзаиморасчетов
	//|		ИНАЧЕ ВЫБОР
	//|		ИНАЧЕ ВЫБОР
	//|				КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КурсВзаиморасчетов <> 0
	//|						И ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КурсВзаиморасчетов <> NULL
	//|					ТОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.КурсВзаиморасчетов
	|				ИНАЧЕ ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.СуммаРаспределения
	//|			КОНЕЦ
	|	КОНЕЦ КАК Сумма,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка КАК Документ,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.ВалютаДокумента КАК Валюта,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.СуммаРаспределения КАК СуммаВВалюте
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамУслуги КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	|		ПО ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.КлючСвязи = ПоступлениеТоваровУслугУслуги.КлючСвязиРаспределения
	|			И ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка = ПоступлениеТоваровУслугУслуги.Ссылка
	|ГДЕ
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Сделка.Ссылка = &Сделка
	|	И ПоступлениеТоваровУслугРаспределениеСуммПоСделкам.Ссылка.Проведен = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТовары.Номенклатура.Наименование,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов <> 0
	|				И НЕ ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов ЕСТЬ NULL
	|			ТОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов / ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов
	//|		ИНАЧЕ ВЫБОР
	//|				КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов <> 0
	//|						И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов <> NULL
	//|					ТОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов
	|				ИНАЧЕ ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.СуммаРаспределения
	//|			КОНЕЦ
	|	КОНЕЦ,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.ВалютаДокумента,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.СуммаРаспределения
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамТовары КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ПО ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.КлючСвязи = ПоступлениеТоваровУслугТовары.КлючСвязиРаспределения
	|			И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка = ПоступлениеТоваровУслугТовары.Ссылка
	|ГДЕ
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Сделка = &Сделка
	|	И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка.Проведен = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугАгентскиеУслуги.Номенклатура.Наименование,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КратностьВзаиморасчетов <> 0
	|				И НЕ ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КратностьВзаиморасчетов <> NULL
	|			ТОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов / ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КратностьВзаиморасчетов
	//|		ИНАЧЕ ВЫБОР
	//|				КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов <> 0
	//|						И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов <> NULL
	//|					ТОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов
	|				ИНАЧЕ ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения
	//|			КОНЕЦ
	|	КОНЕЦ,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка,
	|	ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка.ВалютаДокумента,
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамАгентскиеУслуги КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.АгентскиеУслуги КАК ПоступлениеТоваровУслугАгентскиеУслуги
	|		ПО ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.КлючСвязи = ПоступлениеТоваровУслугАгентскиеУслуги.КлючСвязиРаспределения
	|			И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка = ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка
	|ГДЕ
	|	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Сделка = &Сделка
	|	И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Рубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Пока Выборка.Следующий() Цикл
		
		СтрТЧ = ЭтотОбъект.ВходящиеРасходы.Добавить();
		СтрТЧ.ПоступлениеУслуг = Выборка.Документ;
		СтрТЧ.Сумма = Выборка.Сумма;
		СтрТЧ.СодержаниеУслуги = Выборка.Содержание;
		
		Если Выборка.Валюта <> Рубли Тогда            
			
			СтрТЧ.Валюта = Выборка.Валюта;
			
			СтрТЧ.СуммаВВалюте = Выборка.СуммаВВалюте;			
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ИтогоВходящиеРасходыСумма = ВходящиеРасходы.Итог("Сумма");
	ИтогоВходящиеРасходыСуммаВВалюте = ВходящиеРасходы.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВизуальноеОтображениеИнформацияОПеревозчиках()
	
	Для Каждого Стр Из Объект.Контейнеры Цикл
		
		ПараметрыОтбора = Новый Структура("КлючСвязи", Стр.КлючСвязиИнформацияОПеревозчике);
		
		НайденныеСтроки = Объект.ИнформацияОПеревозчиках.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекстовоеПредставление = "";
			
			Для Каждого СтрНайденнаяСтрока ИЗ НайденныеСтроки Цикл
				
				Если ТекстовоеПредставление = "" Тогда
					
					ТекстовоеПредставление = Строка(СтрНайденнаяСтрока.Перевозчик) + " - " + Формат(СтрНайденнаяСтрока.СтавкаКлиенту,"ЧДЦ=2; ЧГ=") + " - " + Строка(СтрНайденнаяСтрока.Направление) + " - " + Формат(СтрНайденнаяСтрока.СтавкаАвтоперевозки,"ЧДЦ=2; ЧГ=");	
					
				Иначе
					
					ТекстовоеПредставление = ТекстовоеПредставление + Символы.ПС + Строка(СтрНайденнаяСтрока.Перевозчик) + " - " + Формат(СтрНайденнаяСтрока.СтавкаКлиенту,"ЧДЦ=2; ЧГ=") + " - " + Строка(СтрНайденнаяСтрока.Направление) + " - " + Формат(СтрНайденнаяСтрока.СтавкаАвтоперевозки,"ЧДЦ=2; ЧГ=");
					
				КонецЕсли;
				
			КонецЦикла;
			
			Стр.ИнформацияОПеревозчике = ТекстовоеПредставление;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Для Каждого Стр ИЗ Объект.Контейнеры Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.ИнформацияОПеревозчике) Тогда
			
			Стр.ИнформацияОПеревозчике = "не указан";
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеЭлементовПоВидуСделки()
	
	СделкаЭкспорт 			= Ложь;
	СделкаДекларирование 	= Ложь;
	СделкаАвтоперевозка 	= Ложь;       
	СделкаИмпорт 			= Ложь;
	СделкаСертификация      = Ложь;
	
	Элементы.Статус.СписокВыбора.Очистить();
	
