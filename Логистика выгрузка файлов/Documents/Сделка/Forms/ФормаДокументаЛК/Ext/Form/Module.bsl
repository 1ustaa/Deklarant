&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	
	
	Если НЕ ПолучитьРазрешениеПоРолиПользователя(ПользователиКлиентСервер.ТекущийПользователь()) Тогда
		
		ЭтотОбъект.Статус = ПолучитьСтатусСделки(); 
		
		ПоказатьПредупреждение(,"Нет прав для установки статуса <Закрыта>",,"ОШИБКА");
		
		Возврат;
		
	КонецЕсли; 
		
	Стр = Объект.Статусы.Добавить();  
	Стр.Статус = ЭтотОбъект.Статус;
	Стр.Дата = ТекущаяДата(); 
	
	Стр.Пользователь = ПользователиКлиентСервер.ТекущийПользователь();        
	
	Если ЛогистикаСервер.ПолучитьНомерСтатуса(ЭтотОбъект.Статус, Объект.Вид) = 3 И Объект.Фрахт = ПредопределенноеЗначение("Перечисление.СтатусФрахта.Наш") Тогда
		
		ЭтотОбъект.ПодстатусБухгалтерия = ПредопределенноеЗначение("Перечисление.ПодстатусыБухгалтерияСделок.ВОбработке");
		
		Стр = Объект.Статусы.Добавить();  
		Стр.Статус = ЭтотОбъект.ПодстатусБухгалтерия;
		Стр.Дата = ТекущаяДата();
		Стр.Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
		
	ИначеЕсли ЛогистикаСервер.ПолучитьНомерСтатуса(ЭтотОбъект.Статус, Объект.Вид) > 3 И ЛогистикаСервер.ПолучитьНомерСтатуса(ЭтотОбъект.Статус, Объект.Вид)	< 8 Тогда
		
		ЭтотОбъект.ПодстатусБухгалтерия = ПредопределенноеЗначение("Перечисление.ПодстатусыБухгалтерияСделок.ВОбработке");
		
		Стр = Объект.Статусы.Добавить();  
		Стр.Статус = ЭтотОбъект.ПодстатусБухгалтерия;
		Стр.Дата = ТекущаяДата();
		Стр.Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
		
	КонецЕсли;
	
    ОбработатьДоступностьЭлементаДатаЗакрытия(Истина);  
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьРазрешениеПоРолиПользователя(ПользовательБазы)  
	
	Если ЭтотОбъект.Статус = Перечисления.СтатусыСделок.Закрыта Тогда
		
		ПравоИзменять = ЛогистикаСервер.ЕстьРоль("ЛогистикаАдминистратор");
		
		Возврат ПравоИзменять;
		
	Иначе	
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции 

&НаСервере
Процедура ОбработатьДоступностьЭлементаДатаЗакрытия(ИзмененСтатус = Ложь)

	Если ЭтотОбъект.Статус = Перечисления.СтатусыСделок.Закрыта ИЛИ ЭтотОбъект.Статус = Перечисления.СтатусыСделок.Завершена Тогда
		
		Элементы.ДатаЗакрытия.Видимость = Истина;
		
		Если ИзмененСтатус Тогда
			
			Объект.ДатаЗакрытия = ТекущаяДата();	
			
		КонецЕсли;
		
	Иначе
		
		Элементы.ДатаЗакрытия.Видимость = Ложь; 
		
		Если ИзмененСтатус Тогда
			
			Объект.ДатаЗакрытия = Неопределено;	
			
		КонецЕсли;
		
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСтатусСделки()
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатусыСделок.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.СтатусыСделок КАК СтатусыСделок
	|ГДЕ
	|	СтатусыСделок.Сделка = &Сделка";
	
	Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Выборка.Следующий(); 
		
		Возврат Выборка.Статус;
		
	Иначе
		
		Возврат Перечисления.СтатусыСделок.Новая;
		
	КонецЕсли;
	
КонецФункции 

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.ЕстьДоверенность = ?(ДоверенностьБулево, 
	ПредопределенноеЗначение("Перечисление.СтатусыДоверенностей.Есть"),
	ПредопределенноеЗначение("Перечисление.СтатусыДоверенностей.Нет"));
	
	Если НЕ ЗаполнениеДанныхКорректно().Корректно Тогда 
		
		ОписаниеОповещения = Новый ОписаниеОповещения();
		
		ПоказатьПредупреждение(ОписаниеОповещения, ЗаполнениеДанныхКорректно().ТекстОшибки, 60, "Ошибка при сохранении");
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбязательныеПоляДекларирование()
	
	Результат = Новый Массив;
	Результат.Добавить("ДатаПрибытия");
	Результат.Добавить("МенеджерПоТаможне");
	Результат.Добавить("Сертификация");
	Результат.Добавить("ДеньгиНаЕЛС");
	Результат.Добавить("КоличествоКодовТНВЭД");
	Результат.Добавить("КоличествоАртикулов");
	Результат.Добавить("НомерДТ");
	Возврат Результат;
	
КонецФункции // ОбязательныеПоляДекларирование()

&НаСервере
Функция ЗаполнениеДанныхКорректно()
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Корректно", Истина);
	СтруктураВозврата.Вставить("ТекстОшибки", "");
	
	СделкаЭкспорт 	= Объект.Вид = Перечисления.ВидыСделок.Экспорт; 
	СделкаИмпорт	= Объект.Вид = Перечисления.ВидыСделок.Импорт;
	СделкаСертификация	= Объект.Вид = Перечисления.ВидыСделок.Сертификация; 
	СделкаДекларирование = Объект.Вид = Перечисления.ВидыСделок.Декларирование;
	СделкаАвтоперевозка = Объект.Вид = Перечисления.ВидыСделок.Автоперевозка;
	
	УсловиеПоставкиЭкспедированиеНаСВХ = Объект.УсловиеПоставки = Перечисления.УсловияПоставки.ЭкспедированиеНаСВХ;
	
	НомерСтатуса = ЛогистикаСервер.ПолучитьНомерСтатуса(ЭтотОбъект.Статус, Объект.Вид);
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		СтруктураВозврата.Корректно = Ложь;
		СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Контрагент>" + Символы.ПС;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		
		СтруктураВозврата.Корректно = Ложь;
		СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Договор>" + Символы.ПС;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ПутьКПапке) Тогда
		
		СтруктураВозврата.Корректно = Ложь;
		СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Путь к папке>" + Символы.ПС;
		
	КонецЕсли;
	
	Если СделкаАвтоперевозка Тогда   // === Проверка заполнения по сделкам Автоперевозок
		
		Если НЕ ЗначениеЗаполнено(Объект.Менеджер) Тогда
			
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Менеджер по продажам>" + Символы.ПС;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.МенеджерПоРаботеСКлиентами) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Менеджер по работе с клиентами>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Грузополучатель>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.АдресПогрузки) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Адрес погрузки>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.АдресВыгрузки) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Адрес выгрузки>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.КонтактНаПогрузке) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Контакт на погрузке>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.КонтактНаВыгрузке) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Контакт на выгрузке>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.КлассОпасности) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Класс опасности>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.ВесБрутто) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Вес брутто>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.ПутьКПапке) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Путь>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.Груз) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Груз>" + Символы.ПС;
		КонецЕсли;  
		
	ИначеЕсли СделкаСертификация Тогда // === Проверка заполнения по сделке СЕРТИФИКАЦИЯ
		
		Если НЕ ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Грузополучатель>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Грузополучатель>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.ПутьКПапке) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Путь>" + Символы.ПС;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Объект.ВидСертификата) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Вид сертификата>" + Символы.ПС;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Объект.КоличествоСертификатов) Тогда
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Количество сертификатов>" + Символы.ПС;
		КонецЕсли;    
		
	Иначе 	                                                       // === Проверка заполнения по сделкам Импорт Экспорт Декларирование
		
		Если НЕ ЗначениеЗаполнено(Объект.Менеджер) Тогда
			
			СтруктураВозврата.Корректно = Ложь;
			СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Менеджер по продажам>" + Символы.ПС;
			
		КонецЕсли;
		
		Если НЕ СделкаЭкспорт Тогда
			
			Если НЕ СделкаДекларирование  Тогда
				
				Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
					
					Если НЕ ЗначениеЗаполнено(Объект.Фрахт) Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Фрахт>" + Символы.ПС;
						
					КонецЕсли; 
					
				КонецЕсли;
				
				
				Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда  
					
					Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
						
						Если НЕ ЗначениеЗаполнено(Объект.ПортОтгрузки) Тогда
							
							СтруктураВозврата.Корректно = Ложь;
							СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Порт отгрузки (POL)>" + Символы.ПС;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Объект.УсловиеПоставки) Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Условие поставки>" + Символы.ПС;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
				
				Если НЕ ЗначениеЗаполнено(Объект.РежимВывоза) Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Режим вывоза>" + Символы.ПС;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СделкаИмпорт ИЛИ СделкаЭкспорт Тогда
			
			Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда  
				
				Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
					
					Если НЕ ЗначениеЗаполнено(Объект.ПолученОригиналТелекс) Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Получен оригинал Телекс>" + Символы.ПС;
						
					КонецЕсли; 
					
				КонецЕсли;	
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Объект.МенеджерПоРаботеСКлиентами) Тогда
				
				СтруктураВозврата.Корректно = Ложь;
				СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Менеджер по работе с клиентами>" + Символы.ПС;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		Если НомерСтатуса > 1 Тогда //В РАБОТЕ, ПРОВЕРКА
			
			Если НЕ СделкаЭкспорт И НЕ СделкаДекларирование Тогда  
				
				Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
					
					Если НЕ ЗначениеЗаполнено(Объект.ДатаВыходаИзПортаОтгрузки) И 
						Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.ЭкспедированиеНаСВХ Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Выход из порта отгрузки>" + Символы.ПС;
						
					КонецЕсли; 
					
				КонецЕсли;
				
				Если СделкаДекларирование Тогда
					
					Если НЕ ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Грузополучатель>" + Символы.ПС;
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НомерСтатуса > 2 И НЕ СделкаДекларирование Тогда //НА ПОДХОДЕ, ПРОВЕРКА    
			
			Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
				
				Если НЕ ЗначениеЗаполнено(Объект.Линия) И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.ЭкспедированиеНаСВХ  Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Линия>" + Символы.ПС;
					
				КонецЕсли;
				
			КонецЕсли; 
			
			Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
				
				Если НЕ ЗначениеЗаполнено(Объект.Агент) И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.ЭкспедированиеНаСВХ Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Агент>" + Символы.ПС;
					
				КонецЕсли; 
				
			КонецЕсли;
			
			Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
				
				Если НЕ ЗначениеЗаполнено(Объект.Судно) И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.ЭкспедированиеНаСВХ Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Судно>" + Символы.ПС;
					
				КонецЕсли; 
				
			КонецЕсли;  
			
			Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
				
				
				Если НЕ ЗначениеЗаполнено(Объект.ПрипортовойТерминал) И НЕ СделкаЭкспорт Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Припортовой терминал>" + Символы.ПС;
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Объект.ПортПрибытия) И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.ЭкспедированиеНаСВХ Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Порт прибытия>" + Символы.ПС;
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Объект.Коносамент) Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Коносамент>" + Символы.ПС;
					
				КонецЕсли;
				
				Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
					
					Если НЕ ЗначениеЗаполнено(Объект.ДатаПрибытия) И НЕ СделкаЭкспорт Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <ETA>" + Символы.ПС;
						
					КонецЕсли;  
					
				КонецЕсли;   
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НомерСтатуса > 3 Тогда //ВЫГРУЖЕН, ПРОВЕРКА
			
			Если НЕ СделкаДекларирование Тогда
				Если НЕ СделкаЭкспорт Тогда
					
					Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
						
						Для Каждого Стр ИЗ Объект.Контейнеры Цикл  
							
					Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
							
							Если НЕ ЗначениеЗаполнено(Стр.ДатаВыгрузкиСуднаДО) Тогда
								
								СтруктураВозврата.Корректно = Ложь;
								СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "В таблице контейнеров не заполнено поле <Выгрузка судна/ДО>" + Символы.ПС;
								
								Прервать;
								
							КонецЕсли; 
							
					КонецЕсли;		
							
						КонецЦикла; 
						
					КонецЕсли;  
					
				Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
					
					Если НЕ ЗначениеЗаполнено(Объект.ТерминальнаяОбработка) Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Терминальная обработка>" + Символы.ПС;
						
					КонецЕсли; 
					
				КонецЕсли;
				
				
					
				КонецЕсли;
			Иначе
				Для каждого Поле Из ОбязательныеПоляДекларирование() Цикл
					
					Если НЕ ЗначениеЗаполнено(Объект[Поле]) Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтрШаблон("%1Не заполнено поле <%2>%3", СтруктураВозврата.ТекстОшибки, Поле, Символы.ПС);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НомерСтатуса > 4 Тогда //ВЫВЕЗЕН, ПРОВЕРКА ИЛИ СЕРТИФИКАТ ВЫПУЩЕН
			
			Если НЕ СделкаЭкспорт Тогда
				
				//Если НЕ ЗначениеЗаполнено(Объект.Направление) Тогда
				//	
				//	СтруктураВозврата.Корректно = Ложь;
				//	СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Направление>" + Символы.ПС;
				//	
				//КонецЕсли;
				
				Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
					
					Если НЕ ЗначениеЗаполнено(Объект.РежимВывоза) Тогда
						
						СтруктураВозврата.Корректно = Ложь;
						СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Режим вывоза>" + Символы.ПС;
						
					КонецЕсли;   
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Объект.ВидТранспорта) Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Вид транспорта>" + Символы.ПС;
					
				КонецЕсли;
				
				Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
					
					Для Каждого Стр ИЗ Объект.Контейнеры Цикл 
						
						Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
							
							Если НЕ ЗначениеЗаполнено(Стр.ДатаВывозаИзПорта) Тогда
								
								СтруктураВозврата.Корректно = Ложь;
								СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "В таблице контейнеров не заполнено поле <Вывоз из порта>" + Символы.ПС;
								
								Прервать;
								
							КонецЕсли; 
							
						КонецЕсли;		
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если СделкаСертификация Тогда
				
				Если НЕ ЗначениеЗаполнено(Объект.НомераСертификатов) Тогда
					
					СтруктураВозврата.Корректно = Ложь;
					СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "Не заполнено поле <Номера сертификатов>" + Символы.ПС; 
					
				КонецЕсли;                                                                                                                   
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если НомерСтатуса > 5 Тогда //ДОСТАВЛЕН, ПРОВЕРКА
			
			Если НЕ СделкаЭкспорт Тогда
				
				Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
					
					Для Каждого Стр ИЗ Объект.Контейнеры Цикл 
						
						Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
							
							Если НЕ ЗначениеЗаполнено(Стр.ДатаВыгрузкиУКлиента) Тогда
								
								СтруктураВозврата.Корректно = Ложь;
								СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "В таблице контейнеров не заполнено поле <Выгрузка у клиента>" + Символы.ПС;
								
								Прервать;
								
							КонецЕсли; 
							
						КонецЕсли;		
						
					КонецЦикла; 
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если НомерСтатуса > 6 Тогда //СДАН ПОРОЖНИЙ, ПРОВЕРКА
			
			Если НЕ СделкаЭкспорт Тогда
				
				Если НЕ УсловиеПоставкиЭкспедированиеНаСВХ Тогда
					
					Для Каждого Стр ИЗ Объект.Контейнеры Цикл  
						
						Если СделкаИмпорт И Объект.УсловиеПоставки <> Перечисления.УсловияПоставки.Вывоз Тогда    // Импорт и Вывоз
							
							Если НЕ ЗначениеЗаполнено(Стр.ДатаСдачиПорожнегоКонтейнера) Тогда
								
								СтруктураВозврата.Корректно = Ложь;
								СтруктураВозврата.ТекстОшибки = СтруктураВозврата.ТекстОшибки + "В таблице контейнеров не заполнено поле <Сдача порожнего контейнера>" + Символы.ПС;
								
								Прервать;
								
							КонецЕсли;
							
						КонецЕсли;		
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сделка.ПутьКПапке КАК ПутьКПапке,
	|	Сделка.Ссылка КАК Ссылка,
	|	Сделка.Вид КАК Вид
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.Ссылка <> &Ссылка
	|	И Сделка.ПутьКПапке = &ПутьКПапке
	|	И Сделка.Вид = &Вид";
	
	Запрос.УстановитьПараметр("ПутьКПапке", Объект.ПутьКПапке);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Вид", Объект.Вид);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.Корректно = Ложь;
		ОшибкаПапки = СтрШаблон("Путь к папке %1 уже используется в документе %2", Объект.ПутьКПапке, Выборка.Ссылка);
		СтруктураВозврата.ТекстОшибки = СтрШаблон("%1%2%3", СтруктураВозврата.ТекстОшибки, ОшибкаПапки, Символы.ПС);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

