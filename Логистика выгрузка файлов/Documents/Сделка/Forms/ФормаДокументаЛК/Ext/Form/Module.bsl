&НаКлиенте
Процедура ВходящиеРасходыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ВходящиеРасходыПоступлениеУслуг" Тогда	
		
		Если ЗначениеЗаполнено(Элементы.ВходящиеРасходы.ТекущиеДанные.ПоступлениеУслуг) Тогда
			
			ВидДокумента = ПолучитьВидДокументаПоступления(Элементы.ВходящиеРасходы.ТекущиеДанные.ПоступлениеУслуг);
			
			Если ВидДокумента = "Услуги" Тогда
				
				ПараметрыФормы = Новый Структура("Ключ", Элементы.ВходящиеРасходы.ТекущиеДанные.ПоступлениеУслуг);
				ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокументаУслуги", ПараметрыФормы); 
				
			ИначеЕсли ВидДокумента = "Товары" Тогда
				
				ПараметрыФормы = Новый Структура("Ключ", Элементы.ВходящиеРасходы.ТекущиеДанные.ПоступлениеУслуг);
				ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокументаТовары", ПараметрыФормы);
				
			ИначеЕсли ВидДокумента = "Общая" Тогда
				
				ПараметрыФормы = Новый Структура("Ключ", Элементы.ВходящиеРасходы.ТекущиеДанные.ПоступлениеУслуг);
				ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокументаОбщая", ПараметрыФормы);
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьВидДокументаПоступления(Док)
	
	Если Док.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги Тогда
		
		Возврат "Услуги";
		
	ИначеЕсли Док.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары Тогда 
		
		Возврат "Товары";
		
	ИначеЕсли Док.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия Тогда 
		
		Возврат "Общая";
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

