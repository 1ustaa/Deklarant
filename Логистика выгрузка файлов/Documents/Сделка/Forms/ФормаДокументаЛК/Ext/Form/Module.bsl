&НаСервере
Процедура ЗаполнитьРасходыКлиентаКопированиемИзСделки(Сделка)
	
	Для Каждого Стр Из Сделка.РасходыКлиента Цикл 
		
		СтрТЧ = Объект.РасходыКлиента.Добавить(); 
		
		СтрТЧ.Номенклатура = Стр.Номенклатура;
		СтрТЧ.Содержание = ПолучитьСодержаниеУслугиПоВсемКонтейнерам(Стр.Номенклатура);
		СтрТЧ.Количество = Стр.Количество;
		СтрТЧ.Цена = Стр.Цена;
		СтрТЧ.Сумма = Стр.Сумма;
		СтрТЧ.Контейнеры = "Все";
		СтрТЧ.ЦенаUSD = Стр.ЦенаUSD;
		
	КонецЦикла;
	
