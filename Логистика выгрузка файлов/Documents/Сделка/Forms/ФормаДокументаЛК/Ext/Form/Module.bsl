Процедура РасходыКлиентаПередУдалением(Элемент, Отказ)
	
	Если Элемент.ВыделенныеСтроки.Количество() = 1  Тогда
		
		Отказ = ПолучитьНаличиеСчета(Элемент.ТекущиеДанные.СчетНаОплату);
		
		Если Отказ = Истина Тогда
			ПоказатьПредупреждение(,"В данной позиции есть выставленные счета покупателю." + Символы.ПС +  "Для удаления необходимо удалить счет покупателю",,"ОШИБКА");
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(,"Удаленое возможно только по одной строке",,"ОШИБКА");
		Отказ = Истина;
		Возврат
		
	КонецЕсли;	
	
