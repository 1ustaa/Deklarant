&НаКлиенте
Процедура РасходыКлиентаКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы.РасходыКлиента.ТекущиеДанные;
	ТекДанные.Сумма = ТекДанные.Количество * ТекДанные.Цена; 
	ТекДанные.СуммаUSD = ТекДанные.Количество * ТекДанные.ЦенаUSD; 
	
	Если ЗначениеЗаполнено(ТекДанные.СтавкаНДС) Тогда
		ТекДанные.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(ТекДанные.Сумма, Истина, УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(ТекДанные.СтавкаНДС, Ложь));	
	КонецЕсли;
	
	ПересчитатьСуммуНДСВСтроке(ТекДанные);
	
КонецПроцедуры

