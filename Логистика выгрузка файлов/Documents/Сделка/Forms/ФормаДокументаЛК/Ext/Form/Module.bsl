		СтрокаДляОбработки = Объект.РасходыКлиента.НайтиПоИдентификатору(НомерСтроки);
		
		Если СтрокаДляОбработки.ЦенаUSD > 0 Тогда
			
			СтрокаДляОбработки.Цена = (СтрокаДляОбработки.ЦенаUSD * КурсВалютыUSD.Курс) / КурсВалютыUSD.Кратность; 
			СтрокаДляОбработки.Сумма = СтрокаДляОбработки.Цена * СтрокаДляОбработки.Количество;
			ПересчитатьСуммуНДСВСтроке(СтрокаДляОбработки)
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

