&НаКлиенте
Процедура УстановитьДатыДляВсехСтрокПоКолонкеКонтейнеры(Команда)   
	
	Если Элементы.Контейнеры.ТекущиеДанные <> Неопределено Тогда
		
		ИмяКолонки = Элементы.Контейнеры.ТекущийЭлемент.Имя;
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "Контейнеры", "");
		ТекДата = Элементы.Контейнеры.ТекущиеДанные[ИмяКолонки];
		
		Если ТипЗнч(ТекДата) = Тип("Дата") Тогда
			
			Для Каждого Стр Из Объект.Контейнеры Цикл
				
				Стр[ИмяКолонки] = ТекДата;
				
			КонецЦикла;
			
		Иначе
			
			ОписаниеОповещения = Новый ОписаниеОповещения();
			
			ПоказатьПредупреждение(ОписаниеОповещения, "Заполнение доступно только для дат", 60, "Ошибка при изменении");
			
			Отказ = Истина;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

