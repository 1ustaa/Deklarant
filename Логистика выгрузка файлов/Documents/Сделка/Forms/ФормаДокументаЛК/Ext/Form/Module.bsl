&НаСервере
Функция ПолучитьМассивКонтейнеровДляСтроки(СтрокаКонтейнеры)
	
	Массив = Новый Массив;
	
	Для Каждого Стр Из Объект.Контейнеры Цикл
		
		Структ = Новый Структура;
		Структ.Вставить("Контейнер", Стр.Контейнер);
		
		Если СтрНайти(СтрокаКонтейнеры, Стр.Контейнер.Наименование) > 0 ИЛИ СтрокаКонтейнеры = "Все" Тогда
			
			Структ.Вставить("Выбран", Истина);
			
		Иначе
			
			Структ.Вставить("Выбран", Ложь);
			
		КонецЕсли;  
		
		Массив.Добавить(Структ);
		
	КонецЦикла;     
	
	Возврат Массив;
	
КонецФункции

