		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ДопРасходыКонтейнераКонтейнеры" Тогда	
		
		МассивКонтейнеров = ПолучитьМассивКонтейнеровДляСтроки(Элементы.ДопРасходыКонтейнера.ТекущиеДанные.Контейнеры);
		
		ПараметрыФормы = Новый Структура("Контейнеры", МассивКонтейнеров);
		ПараметрыФормы.Вставить("ИмяСобытия", "ВыбраныКонтейнерыДляДопРасходовКонтейнера");
		ОткрытьФорму("Документ.Сделка.Форма.ФормаВыбораКонтейнеровНаРасходы", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		
