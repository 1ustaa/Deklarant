&НаКлиенте
Процедура РасходыКлиентаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РасходыКлиентаСчетНаОплату" Тогда	
		
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.СчетНаОплату) Тогда
			
			Если ТипЗнч(Элемент.ТекущиеДанные.СчетНаОплату) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
				
				ПараметрыФормы = Новый Структура("Ключ", Элементы.РасходыКлиента.ТекущиеДанные.СчетНаОплату);
				ОткрытьФорму("Документ.СчетНаОплатуПокупателю.Форма.ФормаДокумента", ПараметрыФормы);
								
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "РасходыКлиентаКонтейнеры" Тогда	
		
		МассивКонтейнеров = ПолучитьМассивКонтейнеровДляСтроки(Элементы.РасходыКлиента.ТекущиеДанные.Контейнеры);
		
		ПараметрыФормы = Новый Структура("Контейнеры", МассивКонтейнеров);
		ПараметрыФормы.Вставить("ИмяСобытия", "ВыбраныКонтейнерыДляРасходовКлиента");
		ОткрытьФорму("Документ.Сделка.Форма.ФормаВыбораКонтейнеровНаРасходы", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		
	ИначеЕсли Поле.Имя = "РасходыКлиентаРеализация" Тогда	
		
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Реализация) Тогда
			
			ПараметрыФормы = Новый Структура("Ключ", Элементы.РасходыКлиента.ТекущиеДанные.Реализация);
			ОткрытьФорму("Документ.РеализацияТоваровУслуг.Форма.ФормаДокументаУслуги", ПараметрыФормы);
			
		КонецЕсли; 
		
	ИначеЕсли Поле.Имя = "РасходыКлиентаОтчетКомитенту" Тогда	
		
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ОтчетКомитенту) Тогда
			
			ПараметрыФормы = Новый Структура("Ключ", Элементы.РасходыКлиента.ТекущиеДанные.ОтчетКомитенту);
			ОткрытьФорму("Документ.ОтчетКомитентуОПродажах.Форма.ФормаДокументаОЗакупках", ПараметрыФормы);
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДопРасходыКонтейнераВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДопРасходыКонтейнераСчетНаОплату" Тогда
		
