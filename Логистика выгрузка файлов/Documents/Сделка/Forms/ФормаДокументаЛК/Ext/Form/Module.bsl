&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПодборРасходыКлиента" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда
		
		Стр = Элементы.РасходыКлиента.ТекущиеДанные;
		Стр.Номенклатура = Параметр.Номенклатура;
		Стр.Количество = 1;
		Стр.Контейнеры = "Все";
		Стр.Содержание = ПолучитьСодержаниеУслугиПоВсемКонтейнерам(Стр.Номенклатура);
		Стр.Перевыставляемый = Параметр.Перевыставляемый;
		Стр.СтавкаНДС = ПолучитьСтавкуНДСВидРасхода(Параметр.Номенклатура);
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ВыборТекстаГруза" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда	
		
		Объект.Груз = Параметр;
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ВыборТекстаКомментария" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда	
		
		Объект.Комментарий = Параметр;  
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ВыборТекстаСтавки" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда	
		
		Объект.Ставка = Параметр;   
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ВыборТекстаКомментарийНДС" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда 
		
		Объект.КомментарийНДС = Параметр; 
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ВыбраныКонтейнерыДляРасходовКлиента" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда 	
		
		Элементы.РасходыКлиента.ТекущиеДанные.Контейнеры = Параметр;
		Элементы.РасходыКлиента.ТекущиеДанные.Содержание = ПолучитьПолноеНаименованиеНоменклатуры(Элементы.РасходыКлиента.ТекущиеДанные.Номенклатура) +
			" коносамент " + Строка(Объект.Коносамент) + " " + ЛогистикаСервер.СтрокаКонтейнер() + " " + Параметр;  
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ВыполненоЗаполнениеИнформацияОПеревозчике" И Источник = ЭтаФорма.УникальныйИдентификатор Тогда
		
		Для Каждого Стр Из Объект.ИнформацияОПеревозчиках Цикл
			
			ПараметрыОтбора = Новый Структура("КлючСвязи", Параметр.КлючСвязи);
			
			НайденныеСтроки = Объект.ИнформацияОПеревозчиках.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Для Каждого СтрНайденнаяСтрока ИЗ НайденныеСтроки Цикл
					
					Объект.ИнформацияОПеревозчиках.Удалить(СтрНайденнаяСтрока);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Для Каждого Стр Из Параметр.МассивДобавляемыхСтрокИнформацияОПеревозчике Цикл
			
			СтрИнформацияОПеревозчике = Объект.ИнформацияОПеревозчиках.Добавить();
			СтрИнформацияОПеревозчике.КлючСвязи = Параметр.КлючСвязи;
			СтрИнформацияОПеревозчике.Перевозчик = Стр.Перевозчик;
			СтрИнформацияОПеревозчике.Направление = Стр.Направление;
			СтрИнформацияОПеревозчике.СтавкаАвтоперевозки = Стр.СтавкаАвтоперевозки;
			СтрИнформацияОПеревозчике.СтавкаКлиенту = Стр.СтавкаКлиенту;
			
		КонецЦикла;
		
		Для Каждого Стр Из Объект.Контейнеры Цикл
			
			Если Стр.КлючСвязиИнформацияОПеревозчике = Параметр.КлючСвязи Тогда
				
				Если Параметр.ТекстовоеПредставление = "" Тогда
					
					Стр.ИнформацияОПеревозчике = "не указан";
					
				Иначе
					
					Стр.ИнформацияОПеревозчике = Параметр.ТекстовоеПредставление;  
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

