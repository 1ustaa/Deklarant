&НаСервере
Функция СохранитьДанныеСтатусовСделки()
	
	НЗ = РегистрыСведений.СтатусыСделок.СоздатьНаборЗаписей();
	
	НЗ.Отбор.Сделка.Установить(Объект.Ссылка);
	
	НЗ.Прочитать();
	
	Если НЗ.Количество() = 0 Тогда
		
		МЗ = РегистрыСведений.СтатусыСделок.СоздатьМенеджерЗаписи();
		
		МЗ.Сделка = Объект.Ссылка;
		МЗ.Статус = Статус;
		МЗ.ПодстатусБухгалтерия = ПодстатусБухгалтерия;
		МЗ.ПодстатусФинОтдел = ПодстатусФинОтдел;
		МЗ.ПодстатусОплатаВЛинию = ПодстатусОплатаВЛинию;
		МЗ.ДатаВремяПоследнейСменыПодстатусаОплатаВЛинию = ТекущаяДата();
		МЗ.ДатаВремяПоследнейСменыПодстатусаФинОтдел = ТекущаяДата();
		МЗ.Записать();
		
	Иначе
		
		ПредупреждениеПриЗакрытииОСтатусах = Неопределено;
		
		Если НЗ[0].Статус <> Статус Тогда
			
			НЗ[0].Статус = Статус;
			
		КонецЕсли;
		
		Если НЗ[0].ПодстатусБухгалтерия <> ПодстатусБухгалтерия Тогда
			
			НЗ[0].ПодстатусБухгалтерия = ПодстатусБухгалтерия;
			
		КонецЕсли;
		
		Если НЗ[0].ПодстатусФинОтдел <> ПодстатусФинОтдел Тогда
			
			Если ЭтотОбъект.ДатаВремяОткрытияФормы < НЗ[0].ДатаВремяПоследнейСменыПодстатусаФинОтдел Тогда
				
				Если ПредупреждениеПриЗакрытииОСтатусах = Неопределено Тогда
					
					ПредупреждениеПриЗакрытииОСтатусах = "Не удалось установить подстатус (фин.), так как был установлен другой подстатус другим пользователем во время работы с документом";
					
				Иначе
					
					ПредупреждениеПриЗакрытииОСтатусах = ПредупреждениеПриЗакрытииОСтатусах + Символы.ПС + "Не удалось установить подстатус (фин.), так как был установлен другой подстатус другим пользователем во время работы с документом";
					
				КонецЕсли;
				
			Иначе	
				
				НЗ[0].ПодстатусФинОтдел = ПодстатусФинОтдел;  
				НЗ[0].ДатаВремяПоследнейСменыПодстатусаФинОтдел = ТекущаяДата();
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЗ[0].ПодстатусОплатаВЛинию <> ПодстатусОплатаВЛинию Тогда
			
			Если ЭтотОбъект.ДатаВремяОткрытияФормы < НЗ[0].ДатаВремяПоследнейСменыПодстатусаОплатаВЛинию Тогда
				
				Если ПредупреждениеПриЗакрытииОСтатусах = Неопределено Тогда
					
					ПредупреждениеПриЗакрытииОСтатусах = "Не удалось установить подстатус (опл. в линию), так как был установлен другой подстатус другим пользователем во время работы с документом";
					
				Иначе
					
					ПредупреждениеПриЗакрытииОСтатусах = ПредупреждениеПриЗакрытииОСтатусах + Символы.ПС + "Не удалось установить подстатус (опл. в линию), так как был установлен другой подстатус другим пользователем во время работы с документом";
					
				КонецЕсли;
				
			Иначе
				
				НЗ[0].ПодстатусОплатаВЛинию = ПодстатусОплатаВЛинию;
				НЗ[0].ДатаВремяПоследнейСменыПодстатусаОплатаВЛинию = ТекущаяДата();
				
			КонецЕсли;
			
		КонецЕсли;
		
		НЗ.Записать();
		
	КонецЕсли;
	
	Возврат ПредупреждениеПриЗакрытииОСтатусах;
	
КонецФункции

