
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ОбъектыПечати = Новый СписокЗначений;
	ИмяМакета = "Профит сделки";
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Профит сделки");
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Профит сделки";
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = СформироватьПечатнуюФормуПрофитаСделки(ПараметрКоманды, ОбъектыПечати, ИмяМакета);

	Если НЕ КоллекцияПечатныхФорм[0].ТабличныйДокумент = Неопределено Тогда
		УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФормуПрофитаСделки(МассивОбъектов, ОбъектыПечати, ИмяМакета)

	УстановитьПривилегированныйРежим(Истина);

	ИмяМакета = Неопределено;

	ТабличныйДокумент = Новый ТабличныйДокумент;

	ТабличныйДокумент.АвтоМасштаб          = Истина;
	ТабличныйДокумент.ОриентацияСтраницы   = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПрофитСделки";
	ТабличныйДокумент.ТолькоПросмотр = Истина;

	ПечатьТорговыхДокументов.УстановитьМинимальныеПоляПечати(ТабличныйДокумент);

	Если МассивОбъектов.Количество() > 1 Тогда

		ТабличныйДокумент = ЗаполнитьТабличныйДокументПрофитовСделок(ТабличныйДокумент, МассивОбъектов);

	Иначе

		ТабличныйДокумент = ЗаполнитьТабличныйДокументПрофитСделки(ТабличныйДокумент, МассивОбъектов[0]);

	КонецЕсли;

	Возврат ТабличныйДокумент;

КонецФункции

// Профит считается в РасчетПрофитаСделокСервер.ПрофитСделки - здесь только вывод.
&НаСервере
Функция ЗаполнитьТабличныйДокументПрофитСделки(ТабДок, Док)

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Сделка.ПрофитСделки");

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = Док.Номер;
	ТабДок.Вывести(ОбластьШапка);

	Профит = РасчетПрофитаСделокСервер.ПрофитСделки(Док);

	ВыборкаИсходящиеСчета = Профит.Исходящие;
	ВыборкаВходящиеСчета = Профит.Входящие;

	// Исходящие и входящие выводятся рядом, строка к строке.
	КоличествоСтрок = Макс(ВыборкаИсходящиеСчета.Количество(), ВыборкаВходящиеСчета.Количество());

	Для Индекс = 0 По КоличествоСтрок - 1 Цикл

		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

		Если Индекс < ВыборкаИсходящиеСчета.Количество() Тогда
			ЗаполнитьОбластьИсходящие(ОбластьСтрока, ВыборкаИсходящиеСчета[Индекс]);
		КонецЕсли;

		Если Индекс < ВыборкаВходящиеСчета.Количество() Тогда
			ЗаполнитьОбластьВходящие(ОбластьСтрока, ВыборкаВходящиеСчета[Индекс], Док);
		КонецЕсли;

		ТабДок.Вывести(ОбластьСтрока);

	КонецЦикла;

	ОбластьИтогиТаблицы = Макет.ПолучитьОбласть("ИтогиТаблицы");

	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаБезНДСИсходящиеСчета = Профит.ИсхБезНДССчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаБезНДСВходящиеСчета = Профит.ВхБезНДССчета;

	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаНДСИсходящиеСчета = Профит.ИсхНДССчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаНДСВходящиеСчета = Профит.ВхНДССчета;

	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаСНДСИсходящиеСчета = Профит.ИсхСНДССчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаСНДСВходящиеСчета = Профит.ВхСНДССчета;

	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаБезНДСИсходящиеАкты = Профит.ИсхБезНДСАкты;
	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаБезНДСВходящиеАкты = Профит.ВхБезНДСАкты;

	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаНДСИсходящиеАкты = Профит.ИсхНДСАкты;
	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаНДСВходящиеАкты = Профит.ВхНДСАкты;

	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаСНДСИсходящиеАкты = Профит.ИсхСНДСАкты;
	ОбластьИтогиТаблицы.Параметры.ИтогоСуммаСНДСВходящиеАкты = Профит.ВхСНДСАкты;

	ТабДок.Вывести(ОбластьИтогиТаблицы);

	Если Профит.ПониженнаяСтавка Тогда  // для пониженной ставки НДС (5 и 7%)

		ОбластьПодвал = Макет.ПолучитьОбласть("ПодвалУпрощенка");
		ОбластьПодвал.Параметры.ПрофитБезНДСПоАктам = Профит.ПрофитБезНДСПоАктам;
		ОбластьПодвал.Параметры.ПрофитБезНДСПоСчетам = Профит.ПрофитБезНДСПоСчетам;

	Иначе  // Если общая система налогообложения (20%)

		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ПрофитБезНДСПоАктам = Профит.ПрофитБезНДСПоАктам;
		ОбластьПодвал.Параметры.ПрофитСНДСПоАктам = Профит.ПрофитСНДСПоАктам;
		ОбластьПодвал.Параметры.ПрофитБезНДСПоСчетам = Профит.ПрофитБезНДСПоСчетам;
		ОбластьПодвал.Параметры.ПрофитСНДСПоСчетам = Профит.ПрофитСНДСПоСчетам;

	КонецЕсли;

	ТабДок.Вывести(ОбластьПодвал);

	Возврат ТабДок;

КонецФункции

&НаСервере
Процедура ЗаполнитьОбластьИсходящие(ОбластьСтрока, СтрокаИсходящие)

	ОбластьСтрока.Параметры.ДокументИсходящиеСчета = СтрокаИсходящие.Ссылка;
	ОбластьСтрока.Параметры.СчетИсходящиеСчета = СтрокаИсходящие.Счет;

	Если ТипЗнч(СтрокаИсходящие.Ссылка) = Тип("Строка") Тогда

		ОбластьСтрока.Параметры.ДокументИсходящиеСчетаПредставление = "Наличный доход (" + СтрокаИсходящие.Ссылка + ")";
		ОбластьСтрока.Параметры.СчетИсходящиеСчета = СтрокаИсходящие.Ссылка;

	Иначе

		Если ТипЗнч(СтрокаИсходящие.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда

			ОбластьСтрока.Параметры.ДокументИсходящиеСчетаПредставление = "Акт покупателю №" + СтрокаИсходящие.Ссылка.Номер + " от " + Формат(СтрокаИсходящие.Ссылка.Дата,"ДФ=dd.MM.yy");

		ИначеЕсли ТипЗнч(СтрокаИсходящие.Ссылка) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда

			ОбластьСтрока.Параметры.ДокументИсходящиеСчетаПредставление = "Отчет комитенту №" + СтрокаИсходящие.Ссылка.Номер + " от " + Формат(СтрокаИсходящие.Ссылка.Дата,"ДФ=dd.MM.yy");

		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаИсходящие.Счет) Тогда

			ОбластьСтрока.Параметры.СчетИсходящиеСчетаПредставление = "Счет покупателю №" + СтрокаИсходящие.Счет.Номер + " от " + Формат(СтрокаИсходящие.Счет.Дата,"ДФ=dd.MM.yy");
			ОбластьСтрока.Параметры.СчетИсходящиеСчета = СтрокаИсходящие.Счет;

		КонецЕсли;

	КонецЕсли;

	ОбластьСтрока.Параметры.СуммаБезНДСИсходящиеСчета = СтрокаИсходящие.СуммаБезНДССчета;
	ОбластьСтрока.Параметры.СуммаБезНДСИсходящиеАкты = СтрокаИсходящие.СуммаБезНДСАкта;

	ОбластьСтрока.Параметры.СуммаНДСИсходящиеСчета = СтрокаИсходящие.СуммаНДССчета;
	ОбластьСтрока.Параметры.СуммаНДСИсходящиеАкты = СтрокаИсходящие.СуммаНДСАкта;

	ОбластьСтрока.Параметры.СуммаСНДСИсходящиеСчета = СтрокаИсходящие.СуммаСНДССчета;
	ОбластьСтрока.Параметры.СуммаСНДСИсходящиеАкты = СтрокаИсходящие.СуммаСНДСАкта;

	Если СтрокаИсходящие.Статус = Null Тогда
		ОбластьСтрока.Параметры.ОплатаИсходящиеСчета = Перечисления.СтатусОплатыСчета.НеОплачен;
	Иначе
		ОбластьСтрока.Параметры.ОплатаИсходящиеСчета = СтрокаИсходящие.Статус;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбластьВходящие(ОбластьСтрока, СтрокаВходящие, Док)

	Если ТипЗнч(СтрокаВходящие.Ссылка) = Тип("Строка") Тогда

		ОбластьСтрока.Параметры.ДокументВходящиеСчета = Док.Ссылка;
		ОбластьСтрока.Параметры.ДокументВходящиеСчетаПредставление = "Наличный расход (" + СтрокаВходящие.Ссылка + ")";

	Иначе

		Если ЗначениеЗаполнено(СтрокаВходящие.Ссылка) Тогда

			Если ТипЗнч(СтрокаВходящие.Ссылка) = Тип("ДокументСсылка.ОперацияБух") Тогда

				ОбластьСтрока.Параметры.ДокументВходящиеСчета = СтрокаВходящие.Ссылка;
				ОбластьСтрока.Параметры.ДокументВходящиеСчетаПредставление = "Операция №" + СтрокаВходящие.Ссылка.Номер + " от " + Формат(СтрокаВходящие.Ссылка.Дата,"ДФ=dd.MM.yy");

			Иначе

				ОбластьСтрока.Параметры.ДокументВходящиеСчета = СтрокаВходящие.Ссылка;
				ОбластьСтрока.Параметры.ДокументВходящиеСчетаПредставление = "Акт от поставщика №" + СтрокаВходящие.Ссылка.НомерВходящегоДокумента + " от " + Формат(СтрокаВходящие.Ссылка.ДатаВходящегоДокумента,"ДФ=dd.MM.yy");

			КонецЕсли;

		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаВходящие.Счет) Тогда

			ОбластьСтрока.Параметры.СчетВходящиеСчетаПредставление = "Счет от поставщика №" + СтрокаВходящие.Счет.НомерВходящегоДокумента + " от " + Формат(СтрокаВходящие.Счет.ДатаВходящегоДокумента,"ДФ=dd.MM.yy");
			ОбластьСтрока.Параметры.СчетВходящиеСчета = СтрокаВходящие.Счет;

		КонецЕсли;

	КонецЕсли;

	ОбластьСтрока.Параметры.СуммаБезНДСВходящиеСчета = СтрокаВходящие.СуммаБезНДССчета;
	ОбластьСтрока.Параметры.СуммаБезНДСВходящиеАкты = СтрокаВходящие.СуммаБезНДСАкта;

	ОбластьСтрока.Параметры.СуммаНДСВходящиеСчета = СтрокаВходящие.СуммаНДССчета;
	ОбластьСтрока.Параметры.СуммаНДСВходящиеАкты = СтрокаВходящие.СуммаНДСАкта;

	ОбластьСтрока.Параметры.СуммаСНДСВходящиеСчета = СтрокаВходящие.СуммаСНДССчета;
	ОбластьСтрока.Параметры.СуммаСНДСВходящиеАкты = СтрокаВходящие.СуммаСНДСАкта;

	Если СтрокаВходящие.Статус = Null Тогда
		ОбластьСтрока.Параметры.ОплатаВходящиеСчета = Перечисления.СтатусОплатыСчета.НеОплачен;
	Иначе
		ОбластьСтрока.Параметры.ОплатаВходящиеСчета = СтрокаВходящие.Статус;
	КонецЕсли;

КонецПроцедуры

// Профит по актам каждой сделки - тот же, что в подвале печатной формы одной сделки.
&НаСервере
Функция ЗаполнитьТабличныйДокументПрофитовСделок(ТабДок, МассивОбъектов)

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Сделка.ПрофитыСделок");

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьШапка);

	СуммаИтогоИсходящиеСчета = 0;
	СуммаИтогоВходящиеСчета = 0;
	СуммаИтогоПрофит = 0;

	Для Каждого Док Из МассивОбъектов Цикл

		Профит = РасчетПрофитаСделокСервер.ПрофитСделки(Док);

		Если Профит.ПониженнаяСтавка Тогда
			СуммаИсходящих = Профит.ИсхСНДСАкты - Профит.НДСИсхНепервыставляемыйАкты;
			СуммаВходящих = Профит.ВхСНДСАкты;
		Иначе
			СуммаИсходящих = Профит.ИсхБезНДСАкты;
			СуммаВходящих = Профит.ВхБезНДСАкты;
		КонецЕсли;

		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

		ОбластьСтрока.Параметры.Сделка = Док.Номер;
		ОбластьСтрока.Параметры.СделкаСсылка = Док.Ссылка;
		ОбластьСтрока.Параметры.ИсходящиеСчета = СуммаИсходящих;
		ОбластьСтрока.Параметры.ВходящиеСчета = СуммаВходящих;
		ОбластьСтрока.Параметры.Профит = Профит.ПрофитБезНДСПоАктам;

		ТабДок.Вывести(ОбластьСтрока);

		СуммаИтогоИсходящиеСчета = СуммаИтогоИсходящиеСчета + СуммаИсходящих;
		СуммаИтогоВходящиеСчета = СуммаИтогоВходящиеСчета + СуммаВходящих;
		СуммаИтогоПрофит = СуммаИтогоПрофит + Профит.ПрофитБезНДСПоАктам;

	КонецЦикла;

	ОбластьИтогиТаблицы = Макет.ПолучитьОбласть("ИтогиТаблицы");

	ОбластьИтогиТаблицы.Параметры.ИтогоИсходящиеСчета = СуммаИтогоИсходящиеСчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоВходящиеСчета = СуммаИтогоВходящиеСчета;
	ОбластьИтогиТаблицы.Параметры.ИтогоПрофит = СуммаИтогоПрофит;

	ТабДок.Вывести(ОбластьИтогиТаблицы);

	Возврат ТабДок;

КонецФункции
