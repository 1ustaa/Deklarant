
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаПараметров", ЭтотОбъект);
	
	ОткрытьФорму("Документ.Сделка.Форма.ФормаВводаЗаявкиНаПеревозкуНаОснованииСделки", Новый Структура("Сделка", ПараметрКоманды),ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВводаПараметров(Рез, ДопПарам) Экспорт
	
	Если НЕ Рез = Неопределено Тогда
		
		ФормаДок = ПолучитьФорму("Документ.ЗаявкаАвтоперевозчику.Форма.ФормаДокумента");
		
		ФормаДок.Объект.Дата = ПолучитьДатуДО(Рез); 
		
		ФормаДок.Объект.Номер = ПолучитьНомерСделки(Рез);
		
		ФормаДок.Объект.ДокументОснование = Рез.Сделка;   
		
		ФормаДок.Объект.Организация = ПолучитьОрганизацию(Рез);
		
		ФормаДок.Объект.Груз = ПолучитьГруз(Рез);
		
		Если Рез.МассивКонтейнеров.Количество() > 0 Тогда
			
			ФормаДок.Объект.Вес = ПолучитьВес(Рез);
			
			ФормаДок.Объект.ВидТранспорта = ПолучитьВидТранспорта(Рез);
			
			ФормаДок.Объект.ДатаЗагрузки = ПолучитьДатуВывозаИзПорта(Рез);
			
			ФормаДок.Объект.Перевозчик = ПолучитьПеревозчика(Рез); 
			
			ФормаДок.Объект.Направление = ПолучитьНаправление(Рез);
			
			ФормаДок.Объект.Контейнеры = ПолучитьКонтейнеры(Рез);
			
			ФормаДок.Объект.Тариф = ПолучитьТариф(Рез);
				
		КонецЕсли;
		
		ФормаДок.Элементы.ДокументОснование.Видимость = Истина;  
		
		ФормаДок.Открыть(); 
		
	КонецЕсли;
	
КонецПроцедуры 

 &НаСервере
Функция ПолучитьНомерСделки(ПараметрКоманды)
	
	Возврат ПараметрКоманды.Сделка.Номер;	
	
КонецФункции

