#Область ФункцииПроцедуры
&НаСервере
Процедура ЗаполнитьВизуальноеОтображениеРаспределенияПоСделкамВТоварах()
	
	Для Каждого Стр Из Объект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("КлючСвязи",Стр.КлючСвязиРаспределения); 
		
		НайденныеСтроки = Объект.РаспределениеСуммПоСделкамТовары.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекстовоеПредставление = "";
			
			Для Каждого СтрНайденнаяСтрока из НайденныеСтроки Цикл
				
				Если ТекстовоеПредставление = "" Тогда
					
					ТекстовоеПредставление = ПолучитьНомерДокумента(СтрНайденнаяСтрока.Сделка) + " - " + Формат(СтрНайденнаяСтрока.СуммаРаспределения,"ЧДЦ=2; ЧГ=");	

				Иначе
					
					ТекстовоеПредставление = ТекстовоеПредставление + Символы.ПС + ПолучитьНомерДокумента(СтрНайденнаяСтрока.Сделка) + " - " + Формат(СтрНайденнаяСтрока.СуммаРаспределения,"ЧДЦ=2; ЧГ=");
					
				КонецЕсли;	
				
			КонецЦикла;	
			
			Стр.Сделки = ТекстовоеПредставление;
			
		КонецЕсли;
		
		
	КонецЦикла;  
	
	Для Каждого Стр Из Объект.Товары Цикл
	
		Если НЕ ЗначениеЗаполнено(Стр.Сделки) Тогда
			
			Стр.Сделки = "не распределено";
			
		КонецЕсли;	
	
	КонецЦикла;  
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьНомерДокумента(Док) 
	
	Возврат Док.Номер;
	
КонецФункции

#КонецОбласти

#Область СобытияФормы 

 &НаКлиенте
Процедура ЛГС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)


	Если Источник = ЭтаФорма.УникальныйИдентификатор Тогда
		
		Если ИмяСобытия = "ВыполненоРаспределениеСтрокиПоСделкамСчетПоставщикаТовары" Тогда
			
			Для Каждого Стр Из Объект.РаспределениеСуммПоСделкамТовары Цикл
				
				ПараметрыОтбора = Новый Структура("КлючСвязи", Параметр.КлючСвязи);
				
				НайденныеСтроки = Объект.РаспределениеСуммПоСделкамТовары.НайтиСтроки(ПараметрыОтбора);
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					Для Каждого СтрНайденнаяСтрока ИЗ НайденныеСтроки Цикл
						
						Объект.РаспределениеСуммПоСделкамТовары.Удалить(СтрНайденнаяСтрока);
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла; 
			
			Для Каждого Стр Из Параметр.МассивДобавляемыхСтрокРаспределения Цикл
				
				СтрРаспределение = Объект.РаспределениеСуммПоСделкамТовары.Добавить();
				СтрРаспределение.КлючСвязи = Параметр.КлючСвязи;
				СтрРаспределение.Сделка = Стр.Сделка;
				СтрРаспределение.СуммаРаспределения = Стр.Сумма;
				
			КонецЦикла;
			
			Для Каждого Стр Из Объект.Товары Цикл
				
				Если Стр.КлючСвязиРаспределения = Параметр.КлючСвязи Тогда
					
					Стр.Сделки = Параметр.ТекстовоеПредставление;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЛГС_ТоварыВыборПосле(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ТоварыСделки" Тогда
		
		Элементы.Товары.ТекущиеДанные.КлючСвязиРаспределения= Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор();
		
		
		ПараметрыФормы = Новый Структура("Номенклатура",Элементы.товары.ТекущиеДанные.Номенклатура);
		ПараметрыФормы.Вставить("Сумма", ?(Объект.СуммаВключаетНДС, Элементы.Товары.ТекущиеДанные.Сумма, Элементы.Товары.ТекущиеДанные.Сумма + Элементы.Товары.ТекущиеДанные.СуммаНДС));
		ПараметрыФормы.Вставить("КлючСвязи",Элементы.Товары.ТекущиеДанные.КлючСвязиРаспределения);
		ПараметрыФормы.Вставить("ВидТЧ", "Товары"); 
		
		ОткрытьФорму("Документ.СчетНаОплатуПоставщика.Форма.ФормаРедактированияСуммПоСделкам",ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		ЭтаФорма.Модифицированность = Истина   
		
	КонецЕсли;	

	
КонецПроцедуры

&НаКлиенте
Процедура ЛГС_ТоварыПередУдалениемПосле(Элемент, Отказ)
	
	ПараметрыОтбора = Новый Структура("КлючСвязи", Элементы.Товары.ТекущиеДанные.КлючСвязиРаспределения);
	
	НайденныеСтроки = Объект.РаспределениеСуммПоСделкамТовары.НайтиСтроки(ПараметрыОтбора); 
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Для Каждого СтрНайденнаяСтрока ИЗ НайденныеСтроки Цикл
			
			Объект.РаспределениеСуммПоСделкамТовары.Удалить(СтрНайденнаяСтрока);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛГС_ТоварыПриНачалеРедактированияПосле(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		
		МаксКлючСвязиРаспределения = -1;
		
		Для Каждого Стр Из Объект.Товары Цикл
			
			Если Стр.КлючСвязиРаспределения = "" Тогда
				
				Элементы.Товары.ТекущиеДанные.КлючСвязиРаспределения = Строка(МаксКлючСвязиРаспределения + 1);
				Элементы.Товары.ТекущиеДанные.Сделки = "не распределено";
				
			ИначеЕсли МаксКлючСвязиРаспределения < Число(Стр.КлючСвязиРаспределения) Тогда
				
				МаксКлючСвязиРаспределения = Число(Стр.КлючСвязиРаспределения);	
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	Если Копирование Тогда
		
		Элементы.Товары.ТекущиеДанные.КлючСвязиРаспределения = Строка(МаксКлючСвязиРаспределения + 1); 
		Элементы.Товары.ТекущиеДанные.Сделки = "не распределено";
		
	КонецЕсли;


КонецПроцедуры

&НаСервере
Процедура ЛГС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьВизуальноеОтображениеРаспределенияПоСделкамВТоварах();
	
	Если ЛогистикаСервер.ЕстьРоль("ЛогистикаАдминистратор") тогда
		
		Элементы.Администратор.Видимость = Истина;
		
	КонецЕсли;
	
	// ++ ХАУНД Устинин 04.06.2026 ID: 4410
	Элементы.СтатусДокумента.Доступность = ОбщегоНазначения.ПользовательМожетМенятьСтатусДокумента();
	// -- ХАУНД Устинин 04.06.2026 ID: 4410
		
КонецПроцедуры

&НаСервере
Процедура ЛГС_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)

	ЗаполнитьВизуальноеОтображениеРаспределенияПоСделкамВТоварах(); 

КонецПроцедуры

