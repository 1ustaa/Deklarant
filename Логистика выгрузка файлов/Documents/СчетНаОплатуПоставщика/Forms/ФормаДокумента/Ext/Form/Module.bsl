&НаКлиенте
Процедура ЛГС_СделкаПриИзмененииПосле(Элемент)
	
	СтатусСделки = ЛогистикаСервер.ПолучитьСтатусыСделки(Объект.Сделка);
	
	Если СтатусСделки = ПредопределенноеЗначение("Перечисление.СтатусыСделок.Закрыта") ИЛИ СтатусСделки = ПредопределенноеЗначение("Перечисление.СтатусыСделок.Отменена")
		ИЛИ СтатусСделки = ПредопределенноеЗначение("Перечисление.СтатусыСделок.Завершена") Тогда
		
		ПоказатьПредупреждение(,"Архивная сделка не может быть выбрана",,"ОШИБКА!!!" + Символы.ПС +"СДЕЛКА НАХОДИТСЯ В АРХИВЕ!!!");																				   
		
		Объект.Сделка = ПредопределенноеЗначение("Документ.Сделка.ПустаяСсылка");
		
		Возврат;
		
	КонецЕсли;	
	
	УстановитьЗначенияСделокВСтроки();
	
	ЗаполнитьВизуальноеОтображениеРаспределенияПоСделкамВУслугах();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияСделокВСтроки()
	
	Если ЗначениеЗаполнено(Объект.Сделка) Тогда
		
		Объект.РаспределениеСуммПоСделкамТовары.Очистить();
		
		Для Каждого Стр Из Объект.Товары Цикл
			
			Если НЕ ЗначениеЗаполнено(Стр.КлючСвязиРаспределения) Тогда
				
				Стр.КлючСвязиРаспределения = Стр.ПолучитьИдентификатор();
				
			КонецЕсли;
			
			СтрРаспределение = Объект.РаспределениеСуммПоСделкамТовары.Добавить();
			СтрРаспределение.КлючСвязи = Стр.КлючСвязиРаспределения;
			СтрРаспределение.Сделка = Объект.Сделка;
			
			Если Объект.СуммаВключаетНДС Тогда
				
				СтрРаспределение.СуммаРаспределения = Стр.Сумма;
				
			Иначе
				
				СтрРаспределение.СуммаРаспределения = Стр.Сумма + Стр.СуммаНДС;
				
			КонецЕсли;
			
		КонецЦикла;  
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВизуальноеОтображениеРаспределенияПоСделкамВУслугах()
	
	Для Каждого Стр Из Объект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("КлючСвязи", Стр.КлючСвязиРаспределения);
		
		НайденныеСтроки = Объект.РаспределениеСуммПоСделкамТовары.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ТекстовоеПредставление = "";
			
			Для Каждого СтрНайденнаяСтрока ИЗ НайденныеСтроки Цикл
				
				Если ТекстовоеПредставление = "" Тогда
					
					ТекстовоеПредставление = ПолучитьНомерДокумента(СтрНайденнаяСтрока.Сделка) + " - " + Формат(СтрНайденнаяСтрока.СуммаРаспределения,"ЧДЦ=2; ЧГ=");	
					
				Иначе
					
					ТекстовоеПредставление = ТекстовоеПредставление + Символы.ПС + ПолучитьНомерДокумента(СтрНайденнаяСтрока.Сделка) + " - " + Формат(СтрНайденнаяСтрока.СуммаРаспределения,"ЧДЦ=2; ЧГ=");
					
				КонецЕсли;
				
			КонецЦикла;
			
			Стр.Сделки = ТекстовоеПредставление;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Для Каждого Стр ИЗ Объект.Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Сделки) Тогда
			
			Стр.Сделки = "не распределено";
			
		КонецЕсли;
		
	КонецЦикла;  
КонецПроцедуры

&НаКлиенте
Процедура ЛГС_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	
	Если (ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.ДобавленВПлатежныйКалендарь") 
		ИЛИ ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.ОплаченЧастично") 
		ИЛИ ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.Оплачен")) 
		И ЭтотОбъект.СрокОплаты = '00010101' Тогда  
		
		ПоказатьПредупреждение(,"Не заполнено поле <Срок оплаты>",,"Ошибка");
		ЭтаФорма.ТекущийЭлемент = Элементы.СрокОплаты;
		
		Отказ = Истина;
		
	КонецЕсли;
	
	ЕстьНераспределенные =  РезультатПроверкиПозицийПоВидамСделок();
	
	Если ЕстьНераспределенные Тогда
		ПоказатьПредупреждение(,"Имеются нераспределенные позиции из Видов Расходов Сделки",,"Ошибка");
		Отказ = Истина;
	КонецЕсли; 
	
 КонецПроцедуры 
 
 &НаСервере
 Функция РезультатПроверкиПозицийПоВидамСделок()
	 
	 НаличиеНераспределено = Ложь;
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = "
	 |ВЫБРАТЬ РАЗЛИЧНЫЕ
	 |	ВидыРасходовСделки.Номенклатура КАК Номенклатура
	 |ИЗ
	 |	РегистрСведений.ВидыРасходовСделки КАК ВидыРасходовСделки
	 |"; 
	 ВидыРасходов = Запрос.Выполнить().Выгрузить();
	 ВидыРасходов.Свернуть("Номенклатура");  
	 
	//Проверяем ТЧ Товаты 
	НаличиеНераспределено = ЛогистикаСервер.ПолучитьРезультатПроверкиРаспределенные(Объект.Товары, Объект.РаспределениеСуммПоСделкамТовары, ВидыРасходов);  
	 
	Возврат НаличиеНераспределено;
		 
КонецФункции 
 

&НаКлиенте
Процедура ЛГС_СтатусДокументаНачалоВыбораПеред(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ЭтотОбъект.СтарыйСтатус = ЭтотОбъект.СтатусДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛГС_СтатусДокументаПриИзмененииПеред(Элемент)
	
	Если ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.СогласованДляОплаты") Тогда
		
		Если НЕ (ЛогистикаСервер.ЕстьРоль("ЛогистикаАдминистратор") ИЛИ ЛогистикаСервер.ЕстьРоль("ЛогистикаСогласованиеОплатыСчетов")) Тогда
			
			ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.НеОплачен"); 
			
		    ПоказатьПредупреждение(,"Недостаточно прав для установки статуса <Согласован для оплаты>",,"Ошибка");
			
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.ДобавленВПлатежныйКалендарь") Тогда	
		
		Если ЭтотОбъект.СтарыйСтатус = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.СогласованДляОплаты") Тогда
			
			ЭтаФорма.ТекущийЭлемент = Элементы.СрокОплаты;
			
		ИначеЕсли НЕ (ЛогистикаСервер.ЕстьРоль("ЛогистикаАдминистратор") ИЛИ ЛогистикаСервер.ЕстьРоль("ЛогистикаСогласованиеОплатыСчетов")) Тогда
			
			ЭтотОбъект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусОплатыСчета.НеОплачен");
			ПоказатьПредупреждение(,"Статус <Добавлен в платежный календарь> может быть установлен только из статуса <Согласован для оплаты>",,"Ошибка");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ПослеЗаписиНаСервере")
Процедура ЛГС_ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ЗаполнитьДобавленныеКолонкиТаблиц();

	Если Не ЗначениеЗаполнено(Объект.ТипЦен) Тогда
		Ценообразование.ОбновитьЦеныНоменклатуры(Объект.Ссылка, 
		Перечисления.СпособыЗаполненияЦен.ПоЗакупочнымЦенам,
		Объект.ВалютаДокумента,
		Объект.СуммаВключаетНДС);
	КонецЕсли;

	ОбщегоНазначенияБПВызовСервера.УстановитьЗначениеПоУмолчанию("ОсновнойВариантРасчетаВходящегоНДС",
	?(Объект.СуммаВключаетНДС, Перечисления.ВариантыРасчетаНДС.НДСВСумме, Перечисления.ВариантыРасчетаНДС.НДССверху));

	УстановитьСостояниеДокумента();
	#Удаление
	УстановитьСтатусДокумента();
	#КонецУдаления 
	#Вставка
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОграничениеСчетов.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.ОграничениеСчетов КАК ОграничениеСчетов
	|ГДЕ
	|	ОграничениеСчетов.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", ПользователиКлиентСервер.ТекущийПользователь());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		УстановитьСтатусДокумента(); 
		
	КонецЕсли;

	#КонецВставки
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.СостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;

	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

	РаботаСДоговорамиКонтрагентовБП.ЗаписатьСпособЗаполненияСтавкиНДСПоДокументу(
	ТекущийОбъект.ДоговорКонтрагента, ТекущийОбъект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ЛГС_ОбработкаПроверкиЗаполненияНаСервереПосле(Отказ, ПроверяемыеРеквизиты)
	ПроверяемыеРеквизиты.Добавить("СрокОплаты");
КонецПроцедуры

 #КонецОбласти

