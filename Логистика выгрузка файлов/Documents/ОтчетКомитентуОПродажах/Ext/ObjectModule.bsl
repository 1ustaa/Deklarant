&После("ОбработкаПроведения")
Процедура ЛГС_ОбработкаПроведения1(Отказ, РежимПроведения)
	
	Движения.ПеревыставляемыеТоварыУслуги.Записывать = Истина;
	
	
	Для Каждого Стр Из ЭтотОбъект.Товары Цикл    
		
		Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = Стр.Номенклатура;
		Движение.Сделка = ЭтотОбъект.ДокументОснование.Сделка;
		Движение.Контрагент = ЭтотОбъект.Контрагент;
		Движение.Сумма = Стр.Сумма + ?(ЭтотОбъект.СуммаВключаетНДС, 0, Стр.СуммаНДС);
		
	КонецЦикла;
	
	
	ЗаписиОтправленияПисьма = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьНаборЗаписей();
	ЗаписиОтправленияПисьма.Отбор.Документ.Установить(Ссылка);	
	
	ЗаписиОтправленияПисьма.Прочитать();
	
	Если ЗаписиОтправленияПисьма.Количество() = 0 И Дата > Дата('20250225') Тогда
		
		НоваяЗаписьПисьма = РегистрыСведений.ЛГС_КонтрольОтправкиПисемКонтрагентам.СоздатьМенеджерЗаписи();
		НоваяЗаписьПисьма.Документ = Ссылка;
		НоваяЗаписьПисьма.Записать();
		
	КонецЕсли;  
		
		НаборЗаписей = РегистрыСведений.СтатусыДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(ЭтотОбъект.ДокументОснование);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 И ЭтотОбъект.ДокументОснование <> Документы.СчетНаОплатуПокупателю.ПустаяСсылка() Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Организация = ЭтотОбъект.ДокументОснование.Организация;
			НоваяЗапись.Документ = ЭтотОбъект.ДокументОснование;
			НоваяЗапись.ДополнительныйСтатус = Перечисления.СтатусыОтгрузки.Отгружен;
			НоваяЗапись.Статус = Перечисления.СтатусОплатыСчета.НеОплачен;
		    НаборЗаписей.Записать();
		Иначе
			Для Каждого ЗаписьРегистра Из НаборЗаписей Цикл
				ЗаписьРегистра.ДополнительныйСтатус = Перечисления.СтатусыОтгрузки.Отгружен;
			КонецЦикла; 
		НаборЗаписей.Записать();
		КонецЕсли;

		
		// ++ Устинин С.А. 06.11.2026 ID 11128
		// Автоматическое списание Дт УСН.02 по оплатам, зачтенным в поступлениях отчета о закупках
		ЛГС_СформироватьДвиженияСписанияУСН02(Отказ);
		// -- Устинин С.А. 06.11.2026 ID 11128

КонецПроцедуры

// ++ Устинин С.А. 06.11.2026 ID 11128
// Формирует движения Дт УСН.02 при проведении отчета комитенту о закупках.
//
// Алгоритм:
//  1. По поступлениям (акт, накладная, УПД) из табличной части "Поставщики" находит проводки
//     Дт 76.06 - Кт 76.06 (зачет аванса) и по субконто 3 Дт определяет документы "Поступление на расчетный счет".
//  2. Из движений найденных оплат получает Кт УСН.02: контрагент, договор, документ расчетов, сумма, содержание.
//  3. Формирует Дт УСН.02 по тем же субконто на дату отчета. Сумма ограничивается остатком
//     по счету на момент отчета, чтобы исключить повторное списание одной оплаты разными отчетами.
//  Если проводок по Кт УСН.02 нет - движения не формируются.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//
Процедура ЛГС_СформироватьДвиженияСписанияУСН02(Отказ)

	Если Отказ
		Или РучнаяКорректировка
		Или ВидОперации <> Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
		Возврат;
	КонецЕсли;

	Поступления = Новый Массив;
	Для Каждого СтрокаПоставщика Из Поставщики Цикл
		Если ТипЗнч(СтрокаПоставщика.Партия) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
			И Поступления.Найти(СтрокаПоставщика.Партия) = Неопределено Тогда
			Поступления.Добавить(СтрокаПоставщика.Партия);
		КонецЕсли;
	КонецЦикла;

	Если Поступления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Шаг 1. Оплаты, зачтенные в поступлениях отчета (Дт 76.06 - Кт 76.06, субконто 3 Дт)
	ЗапросОплат = Новый Запрос;
	ЗапросОплат.УстановитьПараметр("Поступления", Поступления);
	ЗапросОплат.УстановитьПараметр("Организация", Организация);
	ЗапросОплат.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗачетыАвансов.СубконтоДт3 КАК Оплата
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&Поступления)
	|				И Организация = &Организация
	|				И СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПрочимиПокупателямиИЗаказчиками)
	|				И СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПрочимиПокупателямиИЗаказчиками),
	|			,
	|			) КАК ЗачетыАвансов
	|ГДЕ
	|	ЗачетыАвансов.Активность
	|	И ЗачетыАвансов.СубконтоДт3 ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет";

	Оплаты = ЗапросОплат.Выполнить().Выгрузить().ВыгрузитьКолонку("Оплата");
	Если Оплаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Шаг 2. Кт УСН.02 найденных оплат, ограниченный остатком по счету на момент отчета
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Оплаты",      Оплаты);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Граница",     Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДвиженияОплат.СубконтоКт1 КАК Контрагент,
	|	ДвиженияОплат.СубконтоКт2 КАК Договор,
	|	ДвиженияОплат.СубконтоКт3 КАК ДокументРасчетов,
	|	МАКСИМУМ(ДвиженияОплат.Содержание) КАК Содержание,
	|	СУММА(ДвиженияОплат.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_КредитУСН02
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&Оплаты)
	|				И Организация = &Организация
	|				И СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.УСНРасчетыСПокупателямиКомитент),
	|			,
	|			) КАК ДвиженияОплат
	|ГДЕ
	|	ДвиженияОплат.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияОплат.СубконтоКт1,
	|	ДвиженияОплат.СубконтоКт2,
	|	ДвиженияОплат.СубконтоКт3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КредитУСН02.Контрагент КАК Контрагент,
	|	КредитУСН02.Договор КАК Договор,
	|	КредитУСН02.ДокументРасчетов КАК ДокументРасчетов,
	|	КредитУСН02.Содержание КАК Содержание,
	|	ВЫБОР
	|		КОГДА КредитУСН02.Сумма < -Остатки.СуммаОстаток
	|			ТОГДА КредитУСН02.Сумма
	|		ИНАЧЕ -Остатки.СуммаОстаток
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	ВТ_КредитУСН02 КАК КредитУСН02
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.Остатки(
	|				&Граница,
	|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.УСНРасчетыСПокупателямиКомитент),
	|				,
	|				Организация = &Организация
	|					И Субконто3 В (&Оплаты)) КАК Остатки
	|		ПО КредитУСН02.Контрагент = Остатки.Субконто1
	|			И КредитУСН02.Договор = Остатки.Субконто2
	|			И КредитУСН02.ДокументРасчетов = Остатки.Субконто3
	|ГДЕ
	|	Остатки.СуммаОстаток < 0
	|	И КредитУСН02.Сумма > 0";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Шаг 3. Дт УСН.02 по тем же субконто на дату отчета
	СчетУСН02 = ПланыСчетов.Хозрасчетный.УСНРасчетыСПокупателямиКомитент;

	Пока Выборка.Следующий() Цикл

		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = Дата;
		Проводка.Организация = Организация;
		Проводка.СчетДт      = СчетУСН02;
		Проводка.Сумма       = Выборка.Сумма;
		Проводка.Содержание  = Выборка.Содержание;

		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, Выборка.Контрагент);
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, Выборка.Договор);
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, Выборка.ДокументРасчетов);

	КонецЦикла;

	// Типовая ОбработкаПроведения уже выполнила Движения.Записать(), поэтому перезаписываем набор явно
	Движения.Хозрасчетный.Записывать = Истина;
	Движения.Хозрасчетный.Записать();

КонецПроцедуры
