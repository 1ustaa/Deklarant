	// Вставить содержимое обработчика.
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьРаспределениеСуммПоСделкам(Отказ)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;	
	КонецЕсли;
	
	ТекстЗапросаПроверкиРаспределенияСумм = ТекстЗапросаПроверкиРаспределенияСумм();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроверкиРаспределенияСумм; 
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	Для каждого РезультатЗапроса Из РезультатыЗапросов Цикл
	
		Если РезультатЗапроса.Пустой() Тогда
			Продолжить;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.ОсталосьРаспределить <> 0 Тогда
			
			Отказ = Истина;
			
			Если Выборка.ОсталосьРаспределить > 0 Тогда
				ТекстСообщения = СтрШаблон("Таблица ""%1"" - общая сумма не распределена на сделки полностью.", Выборка.НаименованиеТаблицы);
			Иначе	
				ТекстСообщения = СтрШаблон("Таблица ""%1"" - общая сумма превышает сумму распределения.", Выборка.НаименованиеТаблицы);
			КонецЕсли;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Функция ТекстЗапросаПроверкиРаспределенияСумм()

	Возврат "ВЫБРАТЬ
	        |	ПоступлениеТоваровУслугТовары.Ссылка КАК Ссылка,
	        |	СУММА(ВЫБОР
	        |			КОГДА ПоступлениеТоваровУслугТовары.Ссылка.СуммаВключаетНДС
	        |				ТОГДА ПоступлениеТоваровУслугТовары.Сумма
	        |			ИНАЧЕ ПоступлениеТоваровУслугТовары.Сумма + ПоступлениеТоваровУслугТовары.СуммаНДС
	        |		КОНЕЦ) КАК ВсегоПоДокументу,
	        |	СУММА(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.СуммаРаспределения) КАК СуммаРаспределения,
	        |	СУММА(ЕСТЬNULL(ВЫБОР
	        |				КОГДА ПоступлениеТоваровУслугТовары.Ссылка.СуммаВключаетНДС
	        |					ТОГДА ПоступлениеТоваровУслугТовары.Сумма
	        |				ИНАЧЕ ПоступлениеТоваровУслугТовары.Сумма + ПоступлениеТоваровУслугТовары.СуммаНДС
	        |			КОНЕЦ, 0) - ЕСТЬNULL(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.СуммаРаспределения, 0)) КАК ОсталосьРаспределить,
	        |	""товары"" КАК НаименованиеТаблицы
	        |ИЗ
	        |	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамТовары КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары
	        |		ПО ПоступлениеТоваровУслугТовары.Ссылка = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.Ссылка
	        |			И ПоступлениеТоваровУслугТовары.КлючСвязиРаспределения = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамТовары.КлючСвязи
	        |ГДЕ
	        |	ПоступлениеТоваровУслугТовары.Ссылка = &Ссылка
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ПоступлениеТоваровУслугТовары.Ссылка
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка КАК Ссылка,
	        |	СУММА(ВЫБОР
	        |			КОГДА ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка.СуммаВключаетНДС
	        |				ТОГДА ПоступлениеТоваровУслугАгентскиеУслуги.Сумма
	        |			ИНАЧЕ ПоступлениеТоваровУслугАгентскиеУслуги.Сумма + ПоступлениеТоваровУслугАгентскиеУслуги.СуммаНДС
	        |		КОНЕЦ) КАК ВсегоПоДокументу,
	        |	СУММА(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения) КАК СуммаРаспределения,
	        |	СУММА(ЕСТЬNULL(ВЫБОР
	        |				КОГДА ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка.СуммаВключаетНДС
	        |					ТОГДА ПоступлениеТоваровУслугАгентскиеУслуги.Сумма
	        |				ИНАЧЕ ПоступлениеТоваровУслугАгентскиеУслуги.Сумма + ПоступлениеТоваровУслугАгентскиеУслуги.СуммаНДС
	        |			КОНЕЦ, 0) - ЕСТЬNULL(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения, 0)) КАК ОсталосьРаспределить,
	        |	""агентские услуги"" КАК НаименованиеТаблицы
	        |ИЗ
	        |	Документ.ПоступлениеТоваровУслуг.АгентскиеУслуги КАК ПоступлениеТоваровУслугАгентскиеУслуги
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамАгентскиеУслуги КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги
	        |		ПО ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка
	        |			И ПоступлениеТоваровУслугАгентскиеУслуги.КлючСвязиРаспределения = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.КлючСвязи
	        |ГДЕ
	        |	ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка = &Ссылка
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ПоступлениеТоваровУслугУслуги.Ссылка КАК Ссылка,
	        |	СУММА(ВЫБОР
	        |			КОГДА ПоступлениеТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	        |				ТОГДА ПоступлениеТоваровУслугУслуги.Сумма
	        |			ИНАЧЕ ПоступлениеТоваровУслугУслуги.Сумма + ПоступлениеТоваровУслугУслуги.СуммаНДС
	        |		КОНЕЦ) КАК ВсегоПоДокументу,
	        |	СУММА(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамУслуги.СуммаРаспределения) КАК СуммаРаспределения,
	        |	СУММА(ЕСТЬNULL(ВЫБОР
	        |				КОГДА ПоступлениеТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	        |					ТОГДА ПоступлениеТоваровУслугУслуги.Сумма
	        |				ИНАЧЕ ПоступлениеТоваровУслугУслуги.Сумма + ПоступлениеТоваровУслугУслуги.СуммаНДС
	        |			КОНЕЦ, 0) - ЕСТЬNULL(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамУслуги.СуммаРаспределения, 0)) КАК ОсталосьРаспределить,
	        |	""услуги"" КАК НаименованиеТаблицы
	        |ИЗ
	        |	Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамУслуги КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамУслуги
	        |		ПО ПоступлениеТоваровУслугУслуги.Ссылка = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамУслуги.Ссылка
	        |			И ПоступлениеТоваровУслугУслуги.КлючСвязиРаспределения = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамУслуги.КлючСвязи
	        |ГДЕ
	        |	ПоступлениеТоваровУслугУслуги.Ссылка = &Ссылка
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ПоступлениеТоваровУслугУслуги.Ссылка";

КонецФункции 

#КонецОбласти

 