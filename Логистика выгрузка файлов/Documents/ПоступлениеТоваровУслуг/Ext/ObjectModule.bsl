&После("ПриЗаписи")
Процедура ЛГС_ПриЗаписи(Отказ)
		
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сделка");
	
	Для Каждого Стр Из ЭтотОбъект.РаспределениеСуммПоСделкамУслуги Цикл
		
		СтрТЗ = ТЗ.Добавить();
		СтрТЗ.Сделка = Стр.Сделка;
		
	КонецЦикла;
	
	Для Каждого Стр Из ЭтотОбъект.РаспределениеСуммПоСделкамТовары Цикл
		
		СтрТЗ = ТЗ.Добавить();
		СтрТЗ.Сделка = Стр.Сделка;
		
	КонецЦикла;
	
	Для Каждого Стр Из ЭтотОбъект.РаспределениеСуммПоСделкамАгентскиеУслуги Цикл
		
		СтрТЗ = ТЗ.Добавить();
		СтрТЗ.Сделка = Стр.Сделка;
		
	КонецЦикла;
	
	ТЗ.Свернуть("Сделка");
	
	СтрокаСделки = "";
	АдресаПапок = "";
	
	Для Каждого Стр ИЗ ТЗ Цикл
		
		Если СтрокаСделки = "" Тогда
			
			СтрокаСделки = Стр.Сделка.Номер;
			
		Иначе
			
			СтрокаСделки = СтрокаСделки + ", " + Стр.Сделка.Номер;
			
		КонецЕсли;
		
		Если АдресаПапок = "" Тогда
			
			АдресаПапок = Стр.Сделка.ПутьКПапке;
			
		Иначе
			
			АдресаПапок = АдресаПапок + Символы.ПС + Стр.Сделка.ПутьКПапке;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ЛогистикаСервер.ДублируетПоВходящимРеквизитам(ЭтотОбъект) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Для данного контрагента на данную дату уже есть входящее поступление с этим номером!'");
		Сообщение.Поле = "НомерВходящегоДокумента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	НЗ = РегистрыСведений.ДанныеПоступленийДляВыводаВСписках.СоздатьНаборЗаписей();
	
	НЗ.Отбор.Поступление.Установить(ЭтотОбъект.Ссылка);
	
	НЗ.Прочитать();
	
	Если НЗ.Количество() > 0 Тогда
		
		Для Каждого Запись ИЗ НЗ Цикл
			
			Запись.Поступление = ЭтотОбъект.Ссылка;
			Запись.АдресаПапок = АдресаПапок;
			Запись.Сделки = СтрокаСделки;
						
		КонецЦикла;
		
	НЗ.Записать();	
		
	Иначе
		
		Запись = РегистрыСведений.ДанныеПоступленийДляВыводаВСписках.СоздатьМенеджерЗаписи(); 
		
		Запись.Поступление = ЭтотОбъект.Ссылка; 
		Запись.АдресаПапок = АдресаПапок;
		Запись.Сделки = СтрокаСделки;
		
		Запись.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

&После("ОбработкаЗаполнения")
Процедура ЛГС_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	    
	Если Товары.Количество() > 0 Тогда          
		
		Для Каждого СтрТовары Из Товары  Цикл 
			
			Сделка = ПолучитьСделку(СтрТовары.КлючСвязиРаспределения,ДанныеЗаполнения.РаспределениеСуммПоСделкамТовары );
			
			Если Сделка.Количество() > 0 Тогда
				
				Для Каждого СтрСделка Из Сделка Цикл
				
				СтрРаспределениеСуммПоСделкамТовары = РаспределениеСуммПоСделкамТовары.Добавить();
				СтрРаспределениеСуммПоСделкамТовары.КлючСвязи = СтрСделка.КлючСвязи;
				СтрРаспределениеСуммПоСделкамТовары.Сделка = СтрСделка.Сделка;
				СтрРаспределениеСуммПоСделкамТовары.СуммаРаспределения = СтрСделка.СуммаРаспределения;  
				
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;	
		 
	КонецЕсли;
	
	Если Услуги.Количество() > 0 Тогда
		
		Для Каждого СтрУслуги Из Услуги  Цикл 
			
			Сделка = ПолучитьСделку(СтрУслуги.КлючСвязиРаспределения,ДанныеЗаполнения.РаспределениеСуммПоСделкамТовары );
			
			Если Сделка.Количество() > 0 Тогда
				
				Для Каждого СтрСделка Из Сделка Цикл
					
					СтрРаспределениеСуммПоСделкамУслуги = РаспределениеСуммПоСделкамУслуги.Добавить();
					СтрРаспределениеСуммПоСделкамУслуги.КлючСвязи = СтрСделка.КлючСвязи;
					СтрРаспределениеСуммПоСделкамУслуги.Сделка = СтрСделка.Сделка;
					СтрРаспределениеСуммПоСделкамУслуги.СуммаРаспределения = СтрСделка.СуммаРаспределения; 
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;	
		 
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСделку(КлючСвязи,ТабРаспределениеСуммПоСделкамТовары)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("КлючСвязи", КлючСвязи); 
	
	Результат = ТабРаспределениеСуммПоСделкамТовары.НайтиСтроки(ПараметрыОтбора);
	
	Возврат Результат;

КонецФункции	

&После("ОбработкаПроведения")
Процедура ЛГС_ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроверитьРаспределениеСуммПоСделкам(Отказ);
	
	Движения.ПеревыставляемыеТоварыУслуги.Записывать = Истина;		
	
	Для Каждого Стр Из ЭтотОбъект.РаспределениеСуммПоСделкамАгентскиеУслуги Цикл
		
		ПараметрыОтбора = Новый Структура("КлючСвязиРаспределения", Стр.КлючСвязи);	
		
		НайденныеСтроки = ЭтотОбъект.АгентскиеУслуги.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Номенклатура = НайденныеСтроки[0].Номенклатура;
			Движение.Контрагент = ЭтотОбъект.Контрагент;
			Движение.Сделка = Стр.Сделка;
			Движение.Сумма = Стр.СуммаРаспределения * ЭтотОбъект.КурсВзаиморасчетов / ЭтотОбъект.КратностьВзаиморасчетов;   
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Стр Из ЭтотОбъект.РаспределениеСуммПоСделкамУслуги Цикл
		
		ПараметрыОтбора = Новый Структура("КлючСвязиРаспределения", Стр.КлючСвязи);	
		
		НайденныеСтроки = ЭтотОбъект.Услуги.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Номенклатура = НайденныеСтроки[0].Номенклатура;
			Движение.Контрагент = ЭтотОбъект.Контрагент;
			Движение.Сделка = Стр.Сделка;
			Движение.Сумма = Стр.СуммаРаспределения * ЭтотОбъект.КурсВзаиморасчетов / ЭтотОбъект.КратностьВзаиморасчетов;   
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Для Каждого Стр Из ЭтотОбъект.РаспределениеСуммПоСделкамТовары Цикл
		
		ПараметрыОтбора = Новый Структура("КлючСвязиРаспределения", Стр.КлючСвязи);	
		
		НайденныеСтроки = ЭтотОбъект.Товары.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Движение = Движения.ПеревыставляемыеТоварыУслуги.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Номенклатура = НайденныеСтроки[0].Номенклатура;
			Движение.Контрагент = ЭтотОбъект.Контрагент;
			Движение.Сделка = Стр.Сделка;
			Движение.Сумма = Стр.СуммаРаспределения * ЭтотОбъект.КурсВзаиморасчетов / ЭтотОбъект.КратностьВзаиморасчетов;   
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьСделкиНаАрхивность(ТабличнаяЧасть)
	
	ТЗ = ТабличнаяЧасть.Выгрузить();
	ТЗ.Свернуть("Сделка");
	
	СделкиСОшибками = Новый Массив;
	
	Для каждого СтрокаТЗ из ТЗ Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыСделок.Сделка КАК Сделка,
		|	СтатусыСделок.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.СтатусыСделок КАК СтатусыСделок
		|ГДЕ
		|	СтатусыСделок.Сделка = &Сделка";
		
		Запрос.УстановитьПараметр("Сделка", СтрокаТЗ.Сделка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл  
			Если Выборка.Статус = Перечисления.СтатусыСделок.Закрыта 
				ИЛИ Выборка.Статус = Перечисления.СтатусыСделок.Завершена Тогда
				
				СделкиСОшибками.Добавить(СтрокаТЗ.Сделка);
				Прервать; // Выходим из цикла, так как ошибка уже найдена
			КонецЕсли;
		КонецЦикла; 
		
	КонецЦикла;
	
	Возврат СделкиСОшибками;
	
КонецФункции

