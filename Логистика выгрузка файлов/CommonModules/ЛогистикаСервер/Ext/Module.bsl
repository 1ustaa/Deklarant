Функция ПолучитьНомерСтатуса(Статус, ВидСделки) Экспорт
	
	Если ВидСделки = Перечисления.ВидыСделок.Автоперевозка Тогда   
		
		Если Статус = Перечисления.СтатусыСделок.ЗаявкаОтправлена Тогда
			Возврат 1;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ЗаявкаПодписана Тогда
			Возврат 2;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ПрибылНаПогрузку Тогда
			Возврат 3;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ПогруженВыехалНаВыгрузку Тогда
			Возврат 4;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.НаВыгрузке Тогда
			Возврат 5;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Выгружен Тогда
			Возврат 6;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ДокументыОтправлены Тогда
			Возврат 7;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Отменена ИЛИ Статус = Перечисления.СтатусыСделок.Удалена Тогда
			Возврат 8;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Завершена Тогда
			Возврат 10;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.КонтрольПередЗакрытием Тогда
			Возврат 9;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Закрыта Тогда
			Возврат 10;
		КонецЕсли;	
		
	ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Сертификация  Тогда
		
		Если Статус = Перечисления.СтатусыСделок.ЗаявкаПолучена Тогда
			Возврат 1;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ДокументыПолучены Тогда
			Возврат 2;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.МакетОтправлен Тогда
			Возврат 3;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.СертификатВыпущен Тогда
			Возврат 4;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Отменена ИЛИ Статус = Перечисления.СтатусыСделок.Удалена Тогда
			Возврат 7;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Завершена Тогда
			Возврат 10;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.КонтрольПередЗакрытием Тогда
			Возврат 9;
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Закрыта Тогда
			Возврат 10;
		КонецЕсли;	
		
	Иначе	
		
		Если Статус = Перечисления.СтатусыСделок.Новая Тогда
			
			Возврат 1;  
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ВРаботе ИЛИ Статус = Перечисления.СтатусыСделок.ВПорту 
			ИЛИ Статус = Перечисления.СтатусыСделок.ПодготовкаДТ Тогда
			
			Возврат 2;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.НаПодходе ИЛИ Статус = Перечисления.СтатусыСделок.ПодачаДТ Тогда
			
			Возврат 3; 
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Выгружен ИЛИ Статус = Перечисления.СтатусыСделок.ВыходИзПорта 
			ИЛИ Статус = Перечисления.СтатусыСделок.ГотовКВывозу ИЛИ Статус = Перечисления.СтатусыСделок.ДТПодана Тогда
			
			Возврат 4; 
			
		ИначеЕсли  Статус = Перечисления.СтатусыСделок.ТаможенныйКонтроль Тогда
			
			Возврат 5;	
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Вывезен ИЛИ Статус = Перечисления.СтатусыСделок.SWBОформлен
			ИЛИ Статус = Перечисления.СтатусыСделок.Осмотр ИЛИ Статус = Перечисления.СтатусыСделок.МИДК ИЛИ Статус = Перечисления.СтатусыСделок.Досмотр
			ИЛИ Статус = Перечисления.СтатусыСделок.КТС Тогда
			
			Возврат 5; 
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Доставлен ИЛИ Статус = Перечисления.СтатусыСделок.ВыпускДТ Тогда
			
			Возврат 6;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.СданПорожний ИЛИ Статус = Перечисления.СтатусыСделок.ППД ИЛИ Статус = Перечисления.СтатусыСделок.НТД Тогда
			
			Возврат 7; 
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ВыставленыВсеРасходы Тогда
			
			Возврат 8;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ДокументыПодготовлены Тогда
			
			Возврат 8;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.КонтрольПередЗакрытием Тогда
			
			Возврат 9;	
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Закрыта ИЛИ Статус = Перечисления.СтатусыСделок.Завершена Тогда
			
			Возврат 10;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Отменена ИЛИ Статус = Перечисления.СтатусыСделок.Удалена Тогда
			
			Возврат 0;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.Задержана Тогда
			
			Возврат 0;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ПретензияСуд Тогда
			
			Возврат 0;
			
		ИначеЕсли Статус = Перечисления.СтатусыСделок.ПустаяСсылка() Тогда   // тестовая удалить
			
			Возврат 0;	
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецФункции

Функция ЕстьРоль(ИмяРоли, Пользователь = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|		ПО ГруппыДоступаПользователи.Ссылка.Профиль = ПрофилиГруппДоступаРоли.Ссылка
		|ГДЕ
		|	ПрофилиГруппДоступаРоли.Роль.Имя = &Роль
		|	И ГруппыДоступаПользователи.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Роль", ИмяРоли);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;		
	Иначе	
		Возврат Истина;		
	КонецЕсли;
	
КонецФункции

