	|		ЕСТЬNULL(ВТ_Реализации.СуммаНДСАкта, 0) КАК СуммаНДСАкта,
	|		ЕСТЬNULL(ВТ_Реализации.СуммаСНДСАкта, 0) КАК СуммаСНДСАкта,
	|		ЕСТЬNULL(ВТ_СчетаПокупателям.СуммаБезНДССчета, 0) КАК СуммаБезНДССчета,
	|		ЕСТЬNULL(ВТ_СчетаПокупателям.СуммаНДССчета, 0) КАК СуммаНДССчета,
	|		ЕСТЬNULL(ВТ_СчетаПокупателям.СуммаСНДССчета, 0) КАК СуммаСНДССчета,
	|		ВЫБОР
	|			КОГДА ВТ_Реализации.ВалютаДокумента ЕСТЬ NULL
	|				ТОГДА 1
	|			КОГДА ВТ_Реализации.ВалютаДокумента.Наименование = ""руб.""
	|				ТОГДА 1
	|			ИНАЧЕ ЕСТЬNULL(ВТ_КурсПоАктам.КурсАкта, ЕСТЬNULL(ВТ_Реализации.КурсДокумента, 1))
	|		КОНЕЦ КАК КурсАкта,
	|		ВЫБОР
	|			КОГДА ВТ_СчетаПокупателям.ВалютаДокумента ЕСТЬ NULL
	|				ТОГДА 1
	|			КОГДА ВТ_СчетаПокупателям.ВалютаДокумента.Наименование = ""руб.""
	|				ТОГДА 1
	|			ИНАЧЕ ЕСТЬNULL(ВТ_КурсПоАктам.КурсАкта, ЕСТЬNULL(ВТ_СчетаПокупателям.КурсДокумента, 1))
	|		КОНЕЦ КАК КурсСчета
	|	ИЗ
	|		ВТ_СчетаПокупателям КАК ВТ_СчетаПокупателям
	|			ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Реализации КАК ВТ_Реализации
	|			ПО ВТ_СчетаПокупателям.Счет = ВТ_Реализации.Счет
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсПоАктам КАК ВТ_КурсПоАктам
	|			ПО (ВТ_Реализации.Акт = ВТ_КурсПоАктам.Акт)) КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Счет,
	|	Данные.Сделка,
	|	Данные.Акт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ИСХОДЯЩИЕ 6. Строки исходящих печатной формы (Счет / Акт) со статусом оплаты счета.
	|// Акты, аннулированные по ЭДО, исключаются.
	|ВЫБРАТЬ
	|	ВТ_Исходящие.Сделка КАК Сделка,
	|	ВТ_Исходящие.Счет КАК Счет,
	|	ВТ_Исходящие.Акт КАК Акт,
	|	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаБезНДСАкта_Руб, 0)) КАК СуммаБезНДСАкта,
	|	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаНДСАкта_Руб, 0)) КАК СуммаНДСАкта,
	|	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаСНДСАкта_Руб, 0)) КАК СуммаСНДСАкта,
	|	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаБезНДССчета_Руб, 0)) КАК СуммаБезНДССчета,
	|	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаНДССчета_Руб, 0)) КАК СуммаНДССчета,
	|	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаСНДССчета_Руб, 0)) КАК СуммаСНДССчета,
	|	СтатусыДокументов.Статус КАК Статус,
	|	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО,
	|	ВТ_Исходящие.Сделка.Вид.Ссылка КАК СделкаВидСсылка,
	|	ВТ_Исходящие.Акт.Представление КАК АктПредставление
	|ПОМЕСТИТЬ ВТ_ИсходящиеСтроки
	|ИЗ
	|	ВТ_Исходящие КАК ВТ_Исходящие
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументов КАК СтатусыДокументов
	|		ПО ВТ_Исходящие.Счет = СтатусыДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	|		ПО (СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект = ВТ_Исходящие.Акт.Ссылка)
	|ГДЕ
	|	(СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО ЕСТЬ NULL
	|			ИЛИ СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО <> ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.Аннулирован))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Исходящие.Сделка,
	|	ВТ_Исходящие.Счет,
	|	ВТ_Исходящие.Акт,
	|	СтатусыДокументов.Статус,
	|	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО,
	|	ВТ_Исходящие.Сделка.Вид.Ссылка,
	|	ВТ_Исходящие.Акт.Представление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ИСХОДЯЩИЕ 7. Исходящие акты по номенклатуре для отчета комиссии: те же суммы и курсы, что в п. 6,
	|// аннулированные по ЭДО исключены. НДС непервыставляемый (для пониженной ставки) - в валюте документа,
	|// только номенклатура с Перевыставляемый = Ложь в РС ВидыРасходовСделки (как в ПолучитьНДСИсходящие).
	|ВЫБРАТЬ
	|	ВТ_РеализацииНоменклатура.Сделка КАК Сделка,
	|	ВТ_РеализацииНоменклатура.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ВТ_РеализацииНоменклатура.СуммаБезНДСАкта, 0) * ВЫБОР
	|		КОГДА ВТ_РеализацииНоменклатура.ВалютаДокумента ЕСТЬ NULL
	|			ТОГДА 1
	|		КОГДА ВТ_РеализацииНоменклатура.ВалютаДокумента.Наименование = ""руб.""
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ВТ_КурсПоАктам.КурсАкта, ЕСТЬNULL(ВТ_РеализацииНоменклатура.КурсДокумента, 1))
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ЕСТЬNULL(ВТ_РеализацииНоменклатура.СуммаСНДСАкта, 0) * ВЫБОР
	|		КОГДА ВТ_РеализацииНоменклатура.ВалютаДокумента ЕСТЬ NULL
	|			ТОГДА 1
	|		КОГДА ВТ_РеализацииНоменклатура.ВалютаДокумента.Наименование = ""руб.""
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ВТ_КурсПоАктам.КурсАкта, ЕСТЬNULL(ВТ_РеализацииНоменклатура.КурсДокумента, 1))
	|	КОНЕЦ КАК СуммаСНДС,
	|	ВЫБОР
	|		КОГДА ВидыРасходовСделки.Перевыставляемый = ЛОЖЬ
	|			ТОГДА ЕСТЬNULL(ВТ_РеализацииНоменклатура.СуммаНДСАкта, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НДСНепервыставляемый,
	|	ВЫБОР
	|		КОГДА ВидыРасходовСделки.Перевыставляемый ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(ВТ_РеализацииНоменклатура.СуммаНДСАкта, 0)
	|	КОНЕЦ КАК НДСПоПеревыставляемости,
	|	ВидыРасходовСделки.Перевыставляемый КАК Перевыставляемый,
	|	ЕСТЬNULL(ВТ_РеализацииНоменклатура.Количество, 0) КАК Количество
	|ПОМЕСТИТЬ ВТ_ИсходящиеНоменклатура
	|ИЗ
	|	ВТ_РеализацииНоменклатура КАК ВТ_РеализацииНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсПоАктам КАК ВТ_КурсПоАктам
	|		ПО ВТ_РеализацииНоменклатура.Акт = ВТ_КурсПоАктам.Акт
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыРасходовСделки КАК ВидыРасходовСделки
	|		ПО ВТ_РеализацииНоменклатура.Номенклатура = ВидыРасходовСделки.Номенклатура
	|			И ВТ_РеализацииНоменклатура.Сделка.Вид = ВидыРасходовСделки.ВидСделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	|		ПО (СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект = ВТ_РеализацииНоменклатура.Акт.Ссылка)
	|ГДЕ
	|	(СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО ЕСТЬ NULL
	|			ИЛИ СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО <> ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.Аннулирован))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ИСХОДЯЩИЕ 8. НДС счетов покупателям по признаку перевыставляемости (в валюте документа) -
	|// для профита по счетам при пониженной ставке.
	|ВЫБРАТЬ
	|	СчетНаОплатуПокупателюТовары.Ссылка.Сделка КАК Сделка,
	|	ВидыРасходовСделки.Перевыставляемый КАК Перевыставляемый,
	|	СУММА(ВЫБОР
	|			КОГДА ВидыРасходовСделки.Перевыставляемый ЕСТЬ NULL
	|				ТОГДА 0
	|			КОГДА Вт_ОтборВидСделки.ВидСделки ЕСТЬ NULL
	|				ТОГДА СчетНаОплатуПокупателюТовары.СуммаНДС
	|			КОГДА Вт_ОтборНоменклатура.Номенклатура ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ СчетНаОплатуПокупателюТовары.СуммаНДС
	|		КОНЕЦ) КАК СуммаНДС
	|ПОМЕСТИТЬ ВТ_НДССчетовИсходящих
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОтборВидСделки КАК Вт_ОтборВидСделки
	|		ПО СчетНаОплатуПокупателюТовары.Ссылка.Сделка.Вид = Вт_ОтборВидСделки.ВидСделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОтборНоменклатура КАК Вт_ОтборНоменклатура
	|		ПО СчетНаОплатуПокупателюТовары.Ссылка.Сделка.Вид = Вт_ОтборНоменклатура.ВидСделки
	|			И СчетНаОплатуПокупателюТовары.Номенклатура = Вт_ОтборНоменклатура.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыРасходовСделки КАК ВидыРасходовСделки
	|		ПО СчетНаОплатуПокупателюТовары.Номенклатура = ВидыРасходовСделки.Номенклатура
	|			И СчетНаОплатуПокупателюТовары.Ссылка.Сделка.Вид = ВидыРасходовСделки.ВидСделки
	|ГДЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка.Проведен = ИСТИНА
	|	И СчетНаОплатуПокупателюТовары.Ссылка.Сделка В
	|			(ВЫБРАТЬ
	|				ВТ_Сделки.Сделка
	|			ИЗ
	|				ВТ_Сделки КАК ВТ_Сделки)
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетНаОплатуПокупателюТовары.Ссылка.Сделка,
	|	ВидыРасходовСделки.Перевыставляемый";

КонецФункции

// Входящие: счета поставщиков и акты (поступления, внутренние расходы, операции).
// Логика - как в печатной форме (Колупаев М.Б. 17.08.2026. ID: 7912 - аннулированные по ЭДО не исключаются).
// Создает ВТ_ВходящиеСтроки (строки печатной формы), ВТ_ПоступленияНоменклатура (акты по номенклатуре).
Функция ТекстВТВходящие()

	Возврат
	"// ВХОДЯЩИЕ 1. Счета поставщиков: суммы, распределенные на сделку, в рублях (курс / кратность счета),
	|// с учетом отбора номенклатуры. Нужны только для колонок «по счетам» печатной формы.
	|ВЫБРАТЬ
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка КАК Счет,
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Сделка КАК Сделка,
	|	СУММА(ВЫБОР
	|			КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.СуммаВключаетНДС = ИСТИНА
	|				ТОГДА ВЫБОР
	|						КОГДА Вт_ОтборВидСделки.ВидСделки ЕСТЬ NULL
	|							ТОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА Вт_ОтборНоменклатура.Номенклатура ЕСТЬ NULL
	|									ТОГДА 0
	|								ИНАЧЕ СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
	|							КОНЕЦ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА Вт_ОтборВидСделки.ВидСделки ЕСТЬ NULL
	|						ТОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / (СчетНаОплатуПоставщикаТовары.Сумма + СчетНаОплатуПоставщикаТовары.СуммаНДС))
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Вт_ОтборНоменклатура.Номенклатура ЕСТЬ NULL
	|								ТОГДА 0
	|							ИНАЧЕ СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / (СчетНаОплатуПоставщикаТовары.Сумма + СчетНаОплатуПоставщикаТовары.СуммаНДС))
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ * СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КурсВзаиморасчетов / СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.КратностьВзаиморасчетов) КАК СуммаБезНДССчета,
	|	СУММА(ВЫБОР
	|			КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.СуммаВключаетНДС = ИСТИНА
	|				ТОГДА ВЫБОР
	|						КОГДА Вт_ОтборВидСделки.ВидСделки ЕСТЬ NULL
	|							ТОГДА СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА Вт_ОтборНоменклатура.Номенклатура ЕСТЬ NULL
	|									ТОГДА 0
	|								ИНАЧЕ СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
	|							КОНЕЦ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА Вт_ОтборВидСделки.ВидСделки ЕСТЬ NULL
	|						ТОГДА СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / (СчетНаОплатуПоставщикаТовары.Сумма + СчетНаОплатуПоставщикаТовары.СуммаНДС))
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Вт_ОтборНоменклатура.Номенклатура ЕСТЬ NULL
	|								ТОГДА 0
	|							ИНАЧЕ СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / (СчетНаОплатуПоставщикаТовары.Сумма + СчетНаОплатуПоставщикаТовары.СуммаНДС))
	|						КОНЕЦ
