	|ПОМЕСТИТЬ ВТ_АктыВходящиеНДСПеревыставляемый
	|ИЗ
	|	ВТ_Поступления КАК ВТ_Поступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыРасходовСделки КАК ВидыРасходовСделки
	|		ПО ВТ_Поступления.Номенклатура = ВидыРасходовСделки.Номенклатура
	|			И (ВидыРасходовСделки.ВидСделки = ВТ_Поступления.Сделка.Вид)";  
	
	Запрос.УстановитьПараметр("СчетаВходящие",СчетаВходящие);
	Запрос.УстановитьПараметр("АктыВходящие",АктыВходящие);
	
	Результат = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ТЗ_СчетаВходящие = Результат[2].Выгрузить();
	ТЗ_АктыВходящие =  Результат[3].Выгрузить();
	
	Если ТЗ_СчетаВходящие.Количество() > 0 Тогда
		
		Для каждого стрТЗ_СчетаВходящие из ТЗ_СчетаВходящие Цикл  
			
			Если стрТЗ_СчетаВходящие.Перевыставляемый Тогда
				
				СуммаНДСИтогоВходящиеСчетаПеревыставляемый = СуммаНДСИтогоВходящиеСчетаПеревыставляемый + стрТЗ_СчетаВходящие.СуммаНДССчета; 
				
				СтруктураНДСВходящие.СчетВходящийПеревыставляемыйНДС = СтруктураНДСВходящие.СчетВходящийПеревыставляемыйНДС + стрТЗ_СчетаВходящие.СуммаНДССчета;
				
			Иначе
				
				СтруктураНДСВходящие.СчетВходящийНеПеревыставляемыйНДС = СтруктураНДСВходящие.СчетВходящийНеПеревыставляемыйНДС + стрТЗ_СчетаВходящие.СуммаНДССчета;
				
			КонецЕсли; 
			
			СтруктураНДСВходящие.СчетВходящийВсегоНДС = СтруктураНДСВходящие.СчетВходящийВсегоНДС + стрТЗ_СчетаВходящие.СуммаНДССчета; 
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	
	Если ТЗ_АктыВходящие.Количество() > 0 Тогда 
		
		Для каждого стрТЗ_АктыВходящие из ТЗ_АктыВходящие Цикл
			
			Если стрТЗ_АктыВходящие.Перевыставляемый Тогда
				
				СуммаНДСИтогоВходящиеАктыПеревыставляемый = СуммаНДСИтогоВходящиеАктыПеревыставляемый + стрТЗ_АктыВходящие.СуммаНДСАкта; 
				
				СтруктураНДСВходящие.АктВходящийПеревыставляемыйНДС = СтруктураНДСВходящие.АктВходящийПеревыставляемыйНДС + стрТЗ_АктыВходящие.СуммаНДСАкта;
				
			Иначе
				
				СтруктураНДСВходящие.АктВходящийНеПеревыставляемыйНДС = СтруктураНДСВходящие.АктВходящийНеПеревыставляемыйНДС + стрТЗ_АктыВходящие.СуммаНДСАкта;
				
			КонецЕсли; 
			
			СтруктураНДСВходящие.АктВходящийВсегоНДС	= СтруктураНДСВходящие.АктВходящийВсегоНДС + стрТЗ_АктыВходящие.СуммаНДСАкта;
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры 


