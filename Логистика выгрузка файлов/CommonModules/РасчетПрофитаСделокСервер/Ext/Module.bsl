	|		Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамАгентскиеУслуги КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.АгентскиеУслуги КАК ПоступлениеТоваровУслугАгентскиеУслуги
	|			ПО ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.КлючСвязи = ПоступлениеТоваровУслугАгентскиеУслуги.КлючСвязиРаспределения
	|				И (ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка)
	|	ГДЕ
	|		ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.Проведен = ИСТИНА
	|		И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Сделка В
	|				(ВЫБРАТЬ
	|					ВТ_Сделки.Сделка
	|				ИЗ
	|					ВТ_Сделки КАК ВТ_Сделки)
	|
	|	СГРУППИРОВАТЬ ПО
	|		ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка,
	|		ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Сделка,
	|		ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.СчетНаОплатуПоставщика,
	|		ПоступлениеТоваровУслугАгентскиеУслуги.Номенклатура
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ОперацияБух.Ссылка,
	|		ХозрасчетныйДвиженияССубконто.Сумма,
	|		NULL,
	|		ОперацияБух.Сделка.Ссылка,
	|		ХозрасчетныйДвиженияССубконто.Сумма,
	|		ХозрасчетныйДвиженияССубконто.Сумма,
	|		NULL,
	|		ИСТИНА
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК ХозрасчетныйДвиженияССубконто
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияБух КАК ОперацияБух
	|			ПО ХозрасчетныйДвиженияССубконто.Регистратор = ОперацияБух.Ссылка
	|	ГДЕ
	|		ОперацияБух.Сделка В
	|				(ВЫБРАТЬ
	|					ВТ_Сделки.Сделка
	|				ИЗ
	|					ВТ_Сделки КАК ВТ_Сделки)) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОтборВидСделки КАК Вт_ОтборВидСделки
	|		ПО ВложенныйЗапрос.Сделка.Вид = Вт_ОтборВидСделки.ВидСделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОтборНоменклатура КАК Вт_ОтборНоменклатура
	|		ПО ВложенныйЗапрос.Сделка.Вид = Вт_ОтборНоменклатура.ВидСделки
	|			И ВложенныйЗапрос.Номенклатура = Вт_ОтборНоменклатура.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Акт,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ВХОДЯЩИЕ 3. Те же акты без разреза номенклатуры - как в печатной форме.
	|ВЫБРАТЬ
	|	ВТ_ПоступленияНоменклатура.Акт КАК Акт,
	|	СУММА(ВТ_ПоступленияНоменклатура.СуммаБезНДСАкта) КАК СуммаБезНДСАкта,
	|	ВТ_ПоступленияНоменклатура.Счет КАК Счет,
	|	ВТ_ПоступленияНоменклатура.Сделка КАК Сделка,
	|	СУММА(ВТ_ПоступленияНоменклатура.СуммаНДСАкта) КАК СуммаНДСАкта,
	|	СУММА(ВТ_ПоступленияНоменклатура.СуммаСНДСАкта) КАК СуммаСНДСАкта
	|ПОМЕСТИТЬ ВТ_Поступления
	|ИЗ
	|	ВТ_ПоступленияНоменклатура КАК ВТ_ПоступленияНоменклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоступленияНоменклатура.Акт,
	|	ВТ_ПоступленияНоменклатура.Счет,
	|	ВТ_ПоступленияНоменклатура.Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ВХОДЯЩИЕ 4. Счета и акты: акт соединяется со счетом поставщика по счету и сделке.
	|ВЫБРАТЬ
	|	ВТ_СчетаПоставщиков.Счет КАК Счет,
	|	ЕСТЬNULL(ВТ_СчетаПоставщиков.Сделка, ВТ_Поступления.Сделка) КАК Сделка,
	|	ВТ_Поступления.Акт КАК Акт,
	|	СУММА(ВТ_Поступления.СуммаБезНДСАкта) КАК СуммаБезНДСАкта,
	|	СУММА(ВТ_Поступления.СуммаНДСАкта) КАК СуммаНДСАкта,
	|	СУММА(ВТ_Поступления.СуммаСНДСАкта) КАК СуммаСНДСАкта,
	|	СУММА(ВТ_СчетаПоставщиков.СуммаБезНДССчета) КАК СуммаБезНДССчета,
	|	СУММА(ВТ_СчетаПоставщиков.СуммаНДССчета) КАК СуммаНДССчета,
	|	СУММА(ВТ_СчетаПоставщиков.СуммаСНДССчета) КАК СуммаСНДССчета
	|ПОМЕСТИТЬ ВТ_Входящие
	|ИЗ
	|	ВТ_Поступления КАК ВТ_Поступления
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_СчетаПоставщиков КАК ВТ_СчетаПоставщиков
	|		ПО ВТ_Поступления.Счет = ВТ_СчетаПоставщиков.Счет
	|			И ВТ_Поступления.Сделка = ВТ_СчетаПоставщиков.Сделка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СчетаПоставщиков.Счет,
	|	ВТ_Поступления.Акт,
	|	ЕСТЬNULL(ВТ_СчетаПоставщиков.Сделка, ВТ_Поступления.Сделка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ВХОДЯЩИЕ 5. Строки входящих печатной формы со статусом оплаты счета.
	|// Акты, аннулированные по ЭДО, НЕ исключаются (Колупаев М.Б. 17.08.2026 ID 7912).
	|ВЫБРАТЬ
	|	ВТ_Входящие.Сделка КАК Сделка,
	|	ВТ_Входящие.Счет КАК Счет,
	|	ВТ_Входящие.Акт КАК Акт,
	|	СУММА(ЕСТЬNULL(ВТ_Входящие.СуммаБезНДСАкта, 0)) КАК СуммаБезНДСАкта,
	|	СУММА(ЕСТЬNULL(ВТ_Входящие.СуммаНДСАкта, 0)) КАК СуммаНДСАкта,
	|	СУММА(ЕСТЬNULL(ВТ_Входящие.СуммаСНДСАкта, 0)) КАК СуммаСНДСАкта,
	|	СУММА(ЕСТЬNULL(ВТ_Входящие.СуммаБезНДССчета, 0)) КАК СуммаБезНДССчета,
	|	СУММА(ЕСТЬNULL(ВТ_Входящие.СуммаНДССчета, 0)) КАК СуммаНДССчета,
	|	СУММА(ЕСТЬNULL(ВТ_Входящие.СуммаСНДССчета, 0)) КАК СуммаСНДССчета,
	|	СтатусыДокументов.Статус КАК Статус,
	|	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО,
	|	ВТ_Входящие.Сделка.Вид.Ссылка КАК СделкаВидСсылка,
	|	ВТ_Входящие.Акт.Представление КАК АктПредставление
	|ПОМЕСТИТЬ ВТ_ВходящиеСтроки
	|ИЗ
	|	ВТ_Входящие КАК ВТ_Входящие
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументов КАК СтатусыДокументов
	|		ПО ВТ_Входящие.Счет = СтатусыДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	|		ПО (СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект = ВТ_Входящие.Акт.Ссылка)
	|			И (СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.Аннулирован))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Входящие.Сделка,
	|	ВТ_Входящие.Счет,
	|	ВТ_Входящие.Акт,
	|	СтатусыДокументов.Статус,
	|	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО,
	|	ВТ_Входящие.Сделка.Вид.Ссылка,
	|	ВТ_Входящие.Акт.Представление";

КонецФункции

// Профит: ВТ_ПрофитСделок (по номенклатуре, для отчета комиссии) и ВТ_ИтогиСделок (подвал печатной формы).
// Формулы - как в подвале печатной формы:
//   ОСН: ПрофитБезНДСПоАктам = БезНДС исходящих актов - БезНДС входящих актов;
//   пониженная ставка: ПрофитБезНДСПоАктам = СНДС исходящих актов - НДС исходящих непервыставляемый - СНДС входящих актов.
Функция ТекстВТПрофит()

	Возврат
	"// ПРОФИТ 1. Профит по сделке и номенклатуре для отчета комиссии: исходящие акты (ИСХОДЯЩИЕ 7)
	|// минус входящие акты (ВХОДЯЩИЕ 2) по формуле подвала печатной формы.
	|// Сумма по номенклатуре = ПрофитБезНДСПоАктам печатной формы.
	|ВЫБРАТЬ
	|	Данные.Сделка КАК Сделка,
	|	Данные.Номенклатура КАК Номенклатура,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Сделки.ПониженнаяСтавка
	|				ТОГДА Данные.СНДСИсходящий - Данные.НДСНепервыставляемый - Данные.СНДСВходящий
	|			ИНАЧЕ Данные.БезНДСИсходящий - Данные.БезНДСВходящий
	|		КОНЕЦ) КАК ПрофитПоАктам,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Сделки.ПониженнаяСтавка
	|				ТОГДА Данные.СНДСИсходящий - Данные.НДСНепервыставляемый
	|			ИНАЧЕ Данные.БезНДСИсходящий
	|		КОНЕЦ) КАК СуммаАктаИсходящего,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Сделки.ПониженнаяСтавка
	|				ТОГДА Данные.СНДСВходящий
	|			ИНАЧЕ Данные.БезНДСВходящий
	|		КОНЕЦ) КАК СуммаАктаВходящего,
	|	СУММА(Данные.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПрофитСделок
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_ИсходящиеНоменклатура.Сделка КАК Сделка,
	|		ВТ_ИсходящиеНоменклатура.Номенклатура КАК Номенклатура,
	|		ЕСТЬNULL(ВТ_ИсходящиеНоменклатура.СуммаБезНДС, 0) КАК БезНДСИсходящий,
	|		ЕСТЬNULL(ВТ_ИсходящиеНоменклатура.СуммаСНДС, 0) КАК СНДСИсходящий,
	|		ЕСТЬNULL(ВТ_ИсходящиеНоменклатура.НДСНепервыставляемый, 0) КАК НДСНепервыставляемый,
	|		0 КАК БезНДСВходящий,
	|		0 КАК СНДСВходящий,
	|		ЕСТЬNULL(ВТ_ИсходящиеНоменклатура.Количество, 0) КАК Количество
	|	ИЗ
	|		ВТ_ИсходящиеНоменклатура КАК ВТ_ИсходящиеНоменклатура
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВТ_ПоступленияНоменклатура.Сделка,
	|		ВТ_ПоступленияНоменклатура.Номенклатура,
	|		0,
	|		0,
	|		0,
	|		ЕСТЬNULL(ВТ_ПоступленияНоменклатура.СуммаБезНДСАкта, 0),
	|		ЕСТЬNULL(ВТ_ПоступленияНоменклатура.СуммаСНДСАкта, 0),
	|		0
	|	ИЗ
	|		ВТ_ПоступленияНоменклатура КАК ВТ_ПоступленияНоменклатура) КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Сделки КАК ВТ_Сделки
	|		ПО Данные.Сделка = ВТ_Сделки.Сделка
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Сделка,
	|	Данные.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ПРОФИТ 2. Итоги печатной формы по сделке: суммы строк исходящих (ИСХОДЯЩИЕ 6) и входящих (ВХОДЯЩИЕ 5),
	|// НДС непервыставляемый по актам и по счетам.
	|ВЫБРАТЬ
	|	ВТ_Сделки.Сделка КАК Сделка,
	|	ВТ_Сделки.ПониженнаяСтавка КАК ПониженнаяСтавка,
	|	ЕСТЬNULL(Исходящие.СуммаБезНДСАкта, 0) КАК ИсхБезНДСАкты,
	|	ЕСТЬNULL(Исходящие.СуммаНДСАкта, 0) КАК ИсхНДСАкты,
	|	ЕСТЬNULL(Исходящие.СуммаСНДСАкта, 0) КАК ИсхСНДСАкты,
	|	ЕСТЬNULL(Исходящие.СуммаБезНДССчета, 0) КАК ИсхБезНДССчета,
	|	ЕСТЬNULL(Исходящие.СуммаНДССчета, 0) КАК ИсхНДССчета,
	|	ЕСТЬNULL(Исходящие.СуммаСНДССчета, 0) КАК ИсхСНДССчета,
	|	ЕСТЬNULL(Входящие.СуммаБезНДСАкта, 0) КАК ВхБезНДСАкты,
	|	ЕСТЬNULL(Входящие.СуммаНДСАкта, 0) КАК ВхНДСАкты,
	|	ЕСТЬNULL(Входящие.СуммаСНДСАкта, 0) КАК ВхСНДСАкты,
	|	ЕСТЬNULL(Входящие.СуммаБезНДССчета, 0) КАК ВхБезНДССчета,
	|	ЕСТЬNULL(Входящие.СуммаНДССчета, 0) КАК ВхНДССчета,
	|	ЕСТЬNULL(Входящие.СуммаСНДССчета, 0) КАК ВхСНДССчета,
	|	ЕСТЬNULL(НДСАктов.НДСНепервыставляемый, 0) КАК НДСИсхНепервыставляемыйАкты,
	|	ЕСТЬNULL(НДССчетов.НДСНепервыставляемый, 0) КАК НДСИсхНепервыставляемыйСчета
	|ПОМЕСТИТЬ ВТ_ИтогиСделокСуммы
	|ИЗ
	|	ВТ_Сделки КАК ВТ_Сделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_ИсходящиеСтроки.Сделка КАК Сделка,
	|			СУММА(ВТ_ИсходящиеСтроки.СуммаБезНДСАкта) КАК СуммаБезНДСАкта,
	|			СУММА(ВТ_ИсходящиеСтроки.СуммаНДСАкта) КАК СуммаНДСАкта,
	|			СУММА(ВТ_ИсходящиеСтроки.СуммаСНДСАкта) КАК СуммаСНДСАкта,
	|			СУММА(ВТ_ИсходящиеСтроки.СуммаБезНДССчета) КАК СуммаБезНДССчета,
	|			СУММА(ВТ_ИсходящиеСтроки.СуммаНДССчета) КАК СуммаНДССчета,
	|			СУММА(ВТ_ИсходящиеСтроки.СуммаСНДССчета) КАК СуммаСНДССчета
	|		ИЗ
	|			ВТ_ИсходящиеСтроки КАК ВТ_ИсходящиеСтроки
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_ИсходящиеСтроки.Сделка) КАК Исходящие
	|		ПО ВТ_Сделки.Сделка = Исходящие.Сделка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_ВходящиеСтроки.Сделка КАК Сделка,
	|			СУММА(ВТ_ВходящиеСтроки.СуммаБезНДСАкта) КАК СуммаБезНДСАкта,
	|			СУММА(ВТ_ВходящиеСтроки.СуммаНДСАкта) КАК СуммаНДСАкта,
	|			СУММА(ВТ_ВходящиеСтроки.СуммаСНДСАкта) КАК СуммаСНДСАкта,
	|			СУММА(ВТ_ВходящиеСтроки.СуммаБезНДССчета) КАК СуммаБезНДССчета,
	|			СУММА(ВТ_ВходящиеСтроки.СуммаНДССчета) КАК СуммаНДССчета,
	|			СУММА(ВТ_ВходящиеСтроки.СуммаСНДССчета) КАК СуммаСНДССчета
	|		ИЗ
	|			ВТ_ВходящиеСтроки КАК ВТ_ВходящиеСтроки
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_ВходящиеСтроки.Сделка) КАК Входящие
	|		ПО ВТ_Сделки.Сделка = Входящие.Сделка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_ИсходящиеНоменклатура.Сделка КАК Сделка,
	|			СУММА(ВТ_ИсходящиеНоменклатура.НДСНепервыставляемый) КАК НДСНепервыставляемый
	|		ИЗ
	|			ВТ_ИсходящиеНоменклатура КАК ВТ_ИсходящиеНоменклатура
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_ИсходящиеНоменклатура.Сделка) КАК НДСАктов
	|		ПО ВТ_Сделки.Сделка = НДСАктов.Сделка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_НДССчетовИсходящих.Сделка КАК Сделка,
	|			СУММА(ВТ_НДССчетовИсходящих.СуммаНДС) КАК НДСНепервыставляемый
	|		ИЗ
	|			ВТ_НДССчетовИсходящих КАК ВТ_НДССчетовИсходящих
	|		ГДЕ
	|			ВТ_НДССчетовИсходящих.Перевыставляемый = ЛОЖЬ
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_НДССчетовИсходящих.Сделка) КАК НДССчетов
	|		ПО ВТ_Сделки.Сделка = НДССчетов.Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ПРОФИТ 3. Профит по сделке - формулы подвала печатной формы (ОСН / пониженная ставка).
	|ВЫБРАТЬ
	|	Суммы.Сделка КАК Сделка,
	|	Суммы.ПониженнаяСтавка КАК ПониженнаяСтавка,
	|	Суммы.ИсхБезНДСАкты КАК ИсхБезНДСАкты,
	|	Суммы.ИсхНДСАкты КАК ИсхНДСАкты,
	|	Суммы.ИсхСНДСАкты КАК ИсхСНДСАкты,
	|	Суммы.ИсхБезНДССчета КАК ИсхБезНДССчета,
	|	Суммы.ИсхНДССчета КАК ИсхНДССчета,
	|	Суммы.ИсхСНДССчета КАК ИсхСНДССчета,
	|	Суммы.ВхБезНДСАкты КАК ВхБезНДСАкты,
	|	Суммы.ВхНДСАкты КАК ВхНДСАкты,
	|	Суммы.ВхСНДСАкты КАК ВхСНДСАкты,
	|	Суммы.ВхБезНДССчета КАК ВхБезНДССчета,
	|	Суммы.ВхНДССчета КАК ВхНДССчета,
	|	Суммы.ВхСНДССчета КАК ВхСНДССчета,
	|	Суммы.НДСИсхНепервыставляемыйАкты КАК НДСИсхНепервыставляемыйАкты,
	|	Суммы.НДСИсхНепервыставляемыйСчета КАК НДСИсхНепервыставляемыйСчета,
	|	ВЫБОР
	|		КОГДА Суммы.ПониженнаяСтавка
	|			ТОГДА Суммы.ИсхСНДСАкты - Суммы.НДСИсхНепервыставляемыйАкты - Суммы.ВхСНДСАкты
	|		ИНАЧЕ Суммы.ИсхБезНДСАкты - Суммы.ВхБезНДСАкты
	|	КОНЕЦ КАК ПрофитБезНДСПоАктам,
	|	ВЫБОР
	|		КОГДА Суммы.ПониженнаяСтавка
	|			ТОГДА Суммы.ИсхСНДССчета - Суммы.НДСИсхНепервыставляемыйСчета - Суммы.ВхСНДССчета
	|		ИНАЧЕ Суммы.ИсхБезНДССчета - Суммы.ВхБезНДССчета
	|	КОНЕЦ КАК ПрофитБезНДСПоСчетам,
	|	ВЫБОР
	|		КОГДА Суммы.ПониженнаяСтавка
	|			ТОГДА 0
	|		ИНАЧЕ Суммы.ИсхСНДСАкты - Суммы.ВхСНДСАкты
	|	КОНЕЦ КАК ПрофитСНДСПоАктам,
	|	ВЫБОР
	|		КОГДА Суммы.ПониженнаяСтавка
	|			ТОГДА 0
	|		ИНАЧЕ Суммы.ИсхСНДССчета - Суммы.ВхСНДССчета
	|	КОНЕЦ КАК ПрофитСНДСПоСчетам
	|ПОМЕСТИТЬ ВТ_ИтогиСделок
	|ИЗ
	|	ВТ_ИтогиСделокСуммы КАК Суммы";

