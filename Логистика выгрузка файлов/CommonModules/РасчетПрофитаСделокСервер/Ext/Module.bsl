#Область СлужебныеПроцедурыИФункции

// ++ ХАУНД Устинин С.А. 20.10.2026 ID 10230

// Таблица сделок с признаком пониженной ставки НДС.
// Как в печатной форме: режим НДС по организации сделки на текущую дату.
Функция ТаблицаСделокСРежимомНДС(Сделки)

	ТаблицаСделок = Новый ТаблицаЗначений;
	ТаблицаСделок.Колонки.Добавить("Сделка", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ТаблицаСделок.Колонки.Добавить("ПониженнаяСтавка", Новый ОписаниеТипов("Булево"));

	Если Сделки.Количество() = 0 Тогда
		Возврат ТаблицаСделок;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сделка.Ссылка КАК Сделка,
	|	Сделка.Организация КАК Организация
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.Ссылка В(&Сделки)";
	Запрос.УстановитьПараметр("Сделки", Сделки);

	ПониженнаяСтавкаПоОрганизациям = Новый Соответствие;
	ДатаРежимаНДС = ТекущаяДата();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ПониженнаяСтавка = ПониженнаяСтавкаПоОрганизациям.Получить(Выборка.Организация);
		Если ПониженнаяСтавка = Неопределено Тогда
			ПониженнаяСтавка = УчетНДС.ПрименяетсяПониженнаяСтавкаНДС(Выборка.Организация, ДатаРежимаНДС);
			ПониженнаяСтавкаПоОрганизациям.Вставить(Выборка.Организация, ПониженнаяСтавка);
		КонецЕсли;

		НоваяСтрока = ТаблицаСделок.Добавить();
		НоваяСтрока.Сделка = Выборка.Сделка;
		НоваяСтрока.ПониженнаяСтавка = ПониженнаяСтавка;

	КонецЦикла;

	Возврат ТаблицаСделок;

КонецФункции

