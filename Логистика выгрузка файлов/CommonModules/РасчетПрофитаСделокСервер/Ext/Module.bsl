// Расчет профита сделок - единственное место, где считается профит.
// Используется печатной формой «Профит сделки» (ПрофитСделки) и отчетом
// «Начисление комиссии менеджерам» (ПоместитьПрофитСделок).
//
// Эталон расчета - печатная форма «Профит сделки». После любой правки расчета запустить внешнюю обработку
// «Выгрузка и сверка профита сделок» (ВыгрузкаПрофитаСделок), команду «Сравнить со снимком»:
// печать должна совпасть со снимком, отчет комиссии - с печатью.

#Область ПрограммныйИнтерфейс

// Помещает в менеджер временных таблиц данные профита по переданным сделкам.
//
// Параметры:
//   МенеджерВТ - МенеджерВременныхТаблиц
//   Сделки - Массив из ДокументСсылка.Сделка
//
// Создаваемые таблицы (основные):
//   ВТ_ПрофитСделок - для отчета комиссии:
//     * Сделка, Номенклатура
//     * ПрофитПоАктам - профит без НДС по актам (как ПрофитБезНДСПоАктам в печатной форме)
//     * СуммаАктаИсходящего, СуммаАктаВходящего - база профита по исходящим/входящим актам
//     * Количество - количество по исходящим актам
//   ВТ_ИтогиСделок - итоги и профит по сделке, как в подвале печатной формы (см. ПрофитСделки).
//   ВТ_ИсходящиеСтроки, ВТ_ВходящиеСтроки - строки печатной формы (Счет / Акт).
//
Процедура ПоместитьПрофитСделок(МенеджерВТ, Сделки) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = ТекстВТСделкиИзТаблицы()
		+ ТекстРазделитель() + ТекстВТОтборы()
		+ ТекстРазделитель() + ТекстВТИсходящие()
		+ ТекстРазделитель() + ТекстВТВходящие()
		+ ТекстРазделитель() + ТекстВТПрофит();
	Запрос.УстановитьПараметр("ТаблицаСделок", ТаблицаСделокСРежимомНДС(Сделки));
	Запрос.Выполнить();

КонецПроцедуры

// Профит одной сделки для печатной формы «Профит сделки».
//
// Параметры:
//   Сделка - ДокументСсылка.Сделка
//
// Возвращаемое значение:
//   Структура:
//     * Исходящие - ТаблицаЗначений - строки исходящих (Счет, Ссылка, суммы по счету и акту, Статус)
//     * Входящие - ТаблицаЗначений - строки входящих (Счет, Ссылка, суммы по счету и акту, Статус)
//     * ПониженнаяСтавка - Булево
//     * ИсхБезНДСАкты, ИсхНДСАкты, ИсхСНДСАкты, ВхБезНДСАкты, ВхНДСАкты, ВхСНДСАкты - Число
//     * ИсхБезНДССчета, ИсхНДССчета, ИсхСНДССчета, ВхБезНДССчета, ВхНДССчета, ВхСНДССчета - Число
//     * НДСИсхНепервыставляемыйАкты, НДСИсхНепервыставляемыйСчета - Число
//     * ПрофитБезНДСПоАктам, ПрофитБезНДСПоСчетам, ПрофитСНДСПоАктам, ПрофитСНДСПоСчетам - Число
//
Функция ПрофитСделки(Сделка) Экспорт

	Сделки = Новый Массив;
	Сделки.Добавить(Сделка);

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьПрофитСделок(МенеджерВТ, Сделки);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ_ИсходящиеСтроки.Счет КАК Счет,
	|	ВТ_ИсходящиеСтроки.Акт КАК Ссылка,
	|	ВТ_ИсходящиеСтроки.СуммаБезНДСАкта КАК СуммаБезНДСАкта,
	|	ВТ_ИсходящиеСтроки.СуммаНДСАкта КАК СуммаНДСАкта,
	|	ВТ_ИсходящиеСтроки.СуммаСНДСАкта КАК СуммаСНДСАкта,
	|	ВТ_ИсходящиеСтроки.СуммаБезНДССчета КАК СуммаБезНДССчета,
	|	ВТ_ИсходящиеСтроки.СуммаНДССчета КАК СуммаНДССчета,
	|	ВТ_ИсходящиеСтроки.СуммаСНДССчета КАК СуммаСНДССчета,
	|	ВТ_ИсходящиеСтроки.Статус КАК Статус
	|ИЗ
	|	ВТ_ИсходящиеСтроки КАК ВТ_ИсходящиеСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВходящиеСтроки.Счет КАК Счет,
	|	ВТ_ВходящиеСтроки.Акт КАК Ссылка,
	|	ВТ_ВходящиеСтроки.СуммаБезНДСАкта КАК СуммаБезНДСАкта,
	|	ВТ_ВходящиеСтроки.СуммаНДСАкта КАК СуммаНДСАкта,
	|	ВТ_ВходящиеСтроки.СуммаСНДСАкта КАК СуммаСНДСАкта,
	|	ВТ_ВходящиеСтроки.СуммаБезНДССчета КАК СуммаБезНДССчета,
	|	ВТ_ВходящиеСтроки.СуммаНДССчета КАК СуммаНДССчета,
	|	ВТ_ВходящиеСтроки.СуммаСНДССчета КАК СуммаСНДССчета,
	|	ВТ_ВходящиеСтроки.Статус КАК Статус
	|ИЗ
	|	ВТ_ВходящиеСтроки КАК ВТ_ВходящиеСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИтогиСделок.ПониженнаяСтавка КАК ПониженнаяСтавка,
	|	ВТ_ИтогиСделок.ИсхБезНДСАкты КАК ИсхБезНДСАкты,
	|	ВТ_ИтогиСделок.ИсхНДСАкты КАК ИсхНДСАкты,
	|	ВТ_ИтогиСделок.ИсхСНДСАкты КАК ИсхСНДСАкты,
	|	ВТ_ИтогиСделок.ВхБезНДСАкты КАК ВхБезНДСАкты,
	|	ВТ_ИтогиСделок.ВхНДСАкты КАК ВхНДСАкты,
	|	ВТ_ИтогиСделок.ВхСНДСАкты КАК ВхСНДСАкты,
	|	ВТ_ИтогиСделок.ИсхБезНДССчета КАК ИсхБезНДССчета,
	|	ВТ_ИтогиСделок.ИсхНДССчета КАК ИсхНДССчета,
	|	ВТ_ИтогиСделок.ИсхСНДССчета КАК ИсхСНДССчета,
	|	ВТ_ИтогиСделок.ВхБезНДССчета КАК ВхБезНДССчета,
	|	ВТ_ИтогиСделок.ВхНДССчета КАК ВхНДССчета,
	|	ВТ_ИтогиСделок.ВхСНДССчета КАК ВхСНДССчета,
	|	ВТ_ИтогиСделок.НДСИсхНепервыставляемыйАкты КАК НДСИсхНепервыставляемыйАкты,
	|	ВТ_ИтогиСделок.НДСИсхНепервыставляемыйСчета КАК НДСИсхНепервыставляемыйСчета,
	|	ВТ_ИтогиСделок.ПрофитБезНДСПоАктам КАК ПрофитБезНДСПоАктам,
	|	ВТ_ИтогиСделок.ПрофитБезНДСПоСчетам КАК ПрофитБезНДСПоСчетам,
	|	ВТ_ИтогиСделок.ПрофитСНДСПоАктам КАК ПрофитСНДСПоАктам,
	|	ВТ_ИтогиСделок.ПрофитСНДСПоСчетам КАК ПрофитСНДСПоСчетам
	|ИЗ
	|	ВТ_ИтогиСделок КАК ВТ_ИтогиСделок";

	Результаты = Запрос.ВыполнитьПакет();

	Результат = Новый Структура;
	Результат.Вставить("Исходящие", Результаты[0].Выгрузить());
	Результат.Вставить("Входящие", Результаты[1].Выгрузить());

	Итоги = Результаты[2].Выгрузить();
	Для Каждого Колонка Из Итоги.Колонки Цикл
		Значение = ?(Итоги.Количество() = 0, Неопределено, Итоги[0][Колонка.Имя]);
		Если Колонка.Имя = "ПониженнаяСтавка" Тогда
			Результат.Вставить(Колонка.Имя, Значение = Истина);
		Иначе
			Результат.Вставить(Колонка.Имя, ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст запроса строк исходящих документов сделки (параметр &Сделка).
// Оставлен для совместимости, расчет - в ПоместитьПрофитСделок.
Функция ТекстЗапросаИсходящиеСчета() Экспорт

	Возврат ТекстВТСделкиИзСсылки()
		+ ТекстРазделитель() + ТекстВТОтборы()
		+ ТекстРазделитель() + ТекстВТИсходящие()
		+ ТекстРазделитель() +
		"ВЫБРАТЬ
		|	ВТ_ИсходящиеСтроки.Счет КАК Счет,
		|	ВТ_ИсходящиеСтроки.Акт КАК Ссылка,
		|	ВТ_ИсходящиеСтроки.СуммаБезНДСАкта КАК СуммаБезНДСАкта,
		|	ВТ_ИсходящиеСтроки.СуммаНДСАкта КАК СуммаНДСАкта,
		|	ВТ_ИсходящиеСтроки.СуммаСНДСАкта КАК СуммаСНДСАкта,
		|	ВТ_ИсходящиеСтроки.СуммаБезНДССчета КАК СуммаБезНДССчета,
		|	ВТ_ИсходящиеСтроки.СуммаНДССчета КАК СуммаНДССчета,
		|	ВТ_ИсходящиеСтроки.СуммаСНДССчета КАК СуммаСНДССчета,
		|	ВТ_ИсходящиеСтроки.Статус КАК Статус,
		|	ВТ_ИсходящиеСтроки.СостояниеЭДО КАК СостояниеЭДО,
		|	ВТ_ИсходящиеСтроки.СделкаВидСсылка КАК СделкаВидСсылка,
		|	ВТ_ИсходящиеСтроки.АктПредставление КАК Представление
		|ИЗ
		|	ВТ_ИсходящиеСтроки КАК ВТ_ИсходящиеСтроки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счет";

КонецФункции

// Текст запроса строк входящих документов сделки (параметр &Сделка).
// Оставлен для совместимости, расчет - в ПоместитьПрофитСделок.
Функция ТекстЗапросаВходящиеСчета() Экспорт

	Возврат ТекстВТСделкиИзСсылки()
		+ ТекстРазделитель() + ТекстВТОтборы()
		+ ТекстРазделитель() + ТекстВТВходящие()
		+ ТекстРазделитель() +
		"ВЫБРАТЬ
		|	ВТ_ВходящиеСтроки.Счет КАК Счет,
		|	ВТ_ВходящиеСтроки.Акт КАК Ссылка,
		|	ВТ_ВходящиеСтроки.СуммаБезНДСАкта КАК СуммаБезНДСАкта,
		|	ВТ_ВходящиеСтроки.СуммаНДСАкта КАК СуммаНДСАкта,
		|	ВТ_ВходящиеСтроки.СуммаСНДСАкта КАК СуммаСНДСАкта,
		|	ВТ_ВходящиеСтроки.СуммаБезНДССчета КАК СуммаБезНДССчета,
		|	ВТ_ВходящиеСтроки.СуммаНДССчета КАК СуммаНДССчета,
		|	ВТ_ВходящиеСтроки.СуммаСНДССчета КАК СуммаСНДССчета,
		|	ВТ_ВходящиеСтроки.Статус КАК Статус,
		|	ВТ_ВходящиеСтроки.СостояниеЭДО КАК СостояниеЭДО,
		|	ВТ_ВходящиеСтроки.СделкаВидСсылка КАК СделкаВидСсылка,
		|	ВТ_ВходящиеСтроки.АктПредставление КАК Представление
		|ИЗ
		|	ВТ_ВходящиеСтроки КАК ВТ_ВходящиеСтроки";

КонецФункции

// НДС исходящих документов сделки в разрезе перевыставляемости (суммы в валюте документов).
// Оставлена для совместимости, расчет - в ПоместитьПрофитСделок.
Процедура ПолучитьНДСИсходящие(СтруктураНДСИсходящие, Сделка) Экспорт

	Сделки = Новый Массив;
	Сделки.Добавить(Сделка);

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьПрофитСделок(МенеджерВТ, Сделки);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛОЖЬ КАК ЭтоСчет,
	|	ЕСТЬNULL(ВТ_ИсходящиеНоменклатура.Перевыставляемый, ЛОЖЬ) КАК Перевыставляемый,
	|	СУММА(ВТ_ИсходящиеНоменклатура.НДСПоПеревыставляемости) КАК СуммаНДС
	|ИЗ
	|	ВТ_ИсходящиеНоменклатура КАК ВТ_ИсходящиеНоменклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ВТ_ИсходящиеНоменклатура.Перевыставляемый, ЛОЖЬ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИСТИНА,
	|	ЕСТЬNULL(ВТ_НДССчетовИсходящих.Перевыставляемый, ЛОЖЬ),
	|	СУММА(ВТ_НДССчетовИсходящих.СуммаНДС)
	|ИЗ
	|	ВТ_НДССчетовИсходящих КАК ВТ_НДССчетовИсходящих
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ВТ_НДССчетовИсходящих.Перевыставляемый, ЛОЖЬ)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		СуммаНДС = ?(ТипЗнч(Выборка.СуммаНДС) = Тип("Число"), Выборка.СуммаНДС, 0);
		Префикс = ?(Выборка.ЭтоСчет, "Счет", "Акт");

		Если Выборка.Перевыставляемый Тогда
			ИмяСвойства = Префикс + "ИсходящийПеревыставляемыйНДС";
		Иначе
			ИмяСвойства = Префикс + "ИсходящийНеПеревыставляемыйНДС";
		КонецЕсли;
		СтруктураНДСИсходящие[ИмяСвойства] = СтруктураНДСИсходящие[ИмяСвойства] + СуммаНДС;
		СтруктураНДСИсходящие[Префикс + "ИсходящийВсегоНДС"] = СтруктураНДСИсходящие[Префикс + "ИсходящийВсегоНДС"] + СуммаНДС;

	КонецЦикла;

КонецПроцедуры

// -- ХАУНД Устинин С.А. 20.10.2026 ID 10230

Процедура ПолучитьНДСВходящиеПеревыставляемые(АктыВходящие,СчетаВходящие,СуммаНДСИтогоВходящиеАктыПеревыставляемый,СуммаНДСИтогоВходящиеСчетаПеревыставляемый,СтруктураНДСВходящие) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка КАК Счет,
	|	СУММА(ВЫБОР
	|			КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.СуммаВключаетНДС = ИСТИНА
	|				ТОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
	|			ИНАЧЕ СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения - СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / (СчетНаОплатуПоставщикаТовары.Сумма + СчетНаОплатуПоставщикаТовары.СуммаНДС))
	|		КОНЕЦ) КАК СуммаБезНДССчета,
	|	СУММА(ВЫБОР
	|			КОГДА СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Ссылка.СуммаВключаетНДС = ИСТИНА
	|				ТОГДА СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / СчетНаОплатуПоставщикаТовары.Сумма)
	|			ИНАЧЕ СчетНаОплатуПоставщикаТовары.СуммаНДС * (СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.СуммаРаспределения / (СчетНаОплатуПоставщикаТовары.Сумма + СчетНаОплатуПоставщикаТовары.СуммаНДС))
	|		КОНЕЦ) КАК СуммаНДССчета,
	|	СчетНаОплатуПоставщикаТовары.Номенклатура КАК Номенклатура,
	|	СчетНаОплатуПоставщикаРаспределениеСуммПоСделкамТовары.Сделка КАК Сделка
	|ПОМЕСТИТЬ ВТ_СчетаПоставщиков
	|ИЗ
