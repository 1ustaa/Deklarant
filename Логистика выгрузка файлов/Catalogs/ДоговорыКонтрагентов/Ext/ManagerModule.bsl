&НаСервере
Функция СформироватьПечатнуюФормуДоговорТЭО(МассивОбъектов, ОбъектыПечати, ИмяМакета) 
		
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяМакета = Неопределено;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб          = Истина;
	ТабличныйДокумент.ОриентацияСтраницы   = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ДоговорТЭО"; 
	ТабличныйДокумент.Защита = Ложь;
	
	ПечатьТорговыхДокументов.УстановитьМинимальныеПоляПечати(ТабличныйДокумент);
	
	ТабличныйДокумент = ЗаполнитьТабличныйДокументДоговорТЭО(ТабличныйДокумент, МассивОбъектов[0]); 
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
	1, ОбъектыПечати, МассивОбъектов[0]);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция ЗаполнитьТабличныйДокументДоговорТЭО(ТабДок, Договор)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ДоговорыКонтрагентов.ДоговорТЭО");	
	
	ОбластьДоговор = Макет.ПолучитьОбласть("Договор");
	
	СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Договор.Организация);
	СведенияОКонтрагенте = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Договор.Владелец);

	ОбластьДоговор.Параметры.Номер = Договор.Номер;
