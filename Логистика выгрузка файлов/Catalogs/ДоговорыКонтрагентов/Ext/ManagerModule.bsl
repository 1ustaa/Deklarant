
#Область ОпределениеКоманд

&После("ДобавитьКомандыПечати")
Процедура ЛГС_ДобавитьКомандыПечати(КомандыПечати)
	
	// Договор ТЭО
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ДоговорТЭО";
	КомандаПечати.Представление = НСтр("ru = 'Договор ТЭО'");
	КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.СписокФорм    = "ФормаСписка,ФормаСпискаОбщая,ФормаЭлемента";
	КомандаПечати.Порядок = 170;
	
	// Договор ТП
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ДоговорТП";
	КомандаПечати.Представление = НСтр("ru = 'Договор ТП'");
	КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.СписокФорм    = "ФормаСписка,ФормаСпискаОбщая,ФормаЭлемента";
	КомандаПечати.Порядок = 171;  
	
	// Договор ТЭОТП
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ДоговорТЭОТП";
	КомандаПечати.Представление = НСтр("ru = 'Договор ТЭО И ТП'");
	КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.СписокФорм    = "ФормаСписка,ФормаСпискаОбщая,ФормаЭлемента";
	КомандаПечати.Порядок = 172;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДоговорТЭО") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ДоговорТЭО", "Договор ТЭО №" + МассивОбъектов[0].Номер + " от " + Формат(МассивОбъектов[0].Дата,"ДФ='dd.MM.yyyy""г.""'"), 
		СформироватьПечатнуюФормуДоговорТЭО(МассивОбъектов, ОбъектыПечати, "ДоговорТЭО"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДоговорТП") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ДоговорТП", "Договор ТП №" + МассивОбъектов[0].Номер + " от " + Формат(МассивОбъектов[0].Дата,"ДФ='dd.MM.yyyy""г.""'"), 
		СформироватьПечатнуюФормуДоговорТП(МассивОбъектов, ОбъектыПечати, "ДоговорТП"));
	КонецЕсли;    
	
		//Колупаев М.Б. 23.07.2026 ID 6908	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДоговорТЭОТП") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ДоговорТЭОТП", "ДоговорТЭО И ТП" + МассивОбъектов[0].Номер + " от " + Формат(МассивОбъектов[0].Дата,"ДФ='dd.MM.yyyy""г.""'"), 
		СформироватьПечатнуюФормуДоговорТЭОТП(МассивОбъектов, ОбъектыПечати, "ДоговорТЭОТП"));
	КонецЕсли;

		
КонецПроцедуры
#КонецОбласти   


#Область ЗаполнениеМакетов 

&НаСервере
Функция СформироватьПечатнуюФормуДоговорТЭОТП(МассивОбъектов, ОбъектыПечати, ИмяМакета) 
	//Колупаев М.Б. 23.07.2026 ID 6908	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяМакета = Неопределено;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб          = Истина;
	ТабличныйДокумент.ОриентацияСтраницы   = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ТЭОТП"; 
	ТабличныйДокумент.Защита = Ложь;
	
	ПечатьТорговыхДокументов.УстановитьМинимальныеПоляПечати(ТабличныйДокумент);
	
	ТабличныйДокумент = ЗаполнитьТабличныйДокументДоговорТЭОТП(ТабличныйДокумент, МассивОбъектов[0]); 
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
	1, ОбъектыПечати, МассивОбъектов[0]);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

