
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СхемаСкд = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();  
	ПараметрыДанных = Настройки.ПараметрыДанных; 
	Параметры = СформироватьПараметрыОтчета(ПараметрыДанных);
	
	ТЗ_Начисления = СформироватьТаблицуНачислений();
	
	МенеджерВТ = ЗапросПрофитПоСделкам(Параметры);
	
	ЗаполнитьТаблицуЗначенийДаннымиПоОтделам(ТЗ_Начисления, Параметры, МенеджерВТ); 
	
	Если НЕ (РольДоступна("ОтчетПоКомиссииПросмотрВсехСотрудников") ИЛИ РольДоступна("АдминистраторСистемы")) Тогда
		ОтобратьТаблицуТаблицаПоСотруднику(ТЗ_Начисления);	
	КонецЕсли;
	
	КомпановщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКД = КомпановщикМакета.Выполнить(СхемаСкд, Настройки, ДанныеРасшифровки);
	
	ВнешнийНаборДанных = Новый Структура("тзНачисления", ТЗ_Начисления); 
	
	ПроцессорКД = новый ПроцессорКомпоновкиДанных; 
	ПроцессорКД.Инициализировать(МакетКД, ВнешнийНаборДанных, ДанныеРасшифровки); 
	
	ПроцессорВывода = новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКД, истина);
	
КонецПроцедуры 

#Область СлужебныеПроцедурыИФункции

Процедура ОтобратьТаблицуТаблицаПоСотруднику(ТЗ_Начисления)
	
	ТЗ_СОтборомПоСотруднику = СформироватьТаблицуНачислений();
	
	Для каждого Строка Из ТЗ_Начисления Цикл
		
		Если Строка.Сотрудник = Пользователи.ТекущийПользователь() Тогда
			НоваяСтрока = ТЗ_СОтборомПоСотруднику.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЕсли;	
		
	КонецЦикла;
	
	ТЗ_Начисления = ТЗ_СОтборомПоСотруднику;
	
КонецПроцедуры

Функция СформироватьПараметрыОтчета(ПараметрыДанных)
	
	Параметры = Новый Структура();
	
	Период = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период")).Значение;  
	Параметры.Вставить("НачалоПериода", Период.ДатаНачала);
	Параметры.Вставить("КонецПериода", Период.ДатаОкончания); 
	
	Возврат Параметры;
	
КонецФункции

Функция СформироватьТаблицуНачислений()
	
	ТЗ_Начисления = Новый ТаблицаЗначений; 
	
	ОписаниеТиповСотрудник = Новый Массив(); 
	ОписаниеТиповСотрудник.Добавить(Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ОписаниеТиповСотрудник.Добавить(Новый ОписаниеТипов("Строка"));
	
	ТЗ_Начисления.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов(ОписаниеТиповСотрудник,,,, Новый КвалификаторыСтроки(100)));
	ТЗ_Начисления.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты")); 
	ТЗ_Начисления.Колонки.Добавить("КонтрагентНаименование", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ_Начисления.Колонки.Добавить("Сделка", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ТЗ_Начисления.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ_Начисления.Колонки.Добавить("Профит", Новый ОписаниеТипов("Число"));
	ТЗ_Начисления.Колонки.Добавить("Премия", Новый ОписаниеТипов("Число"));
	ТЗ_Начисления.Колонки.Добавить("Отдел", Новый ОписаниеТипов("СправочникСсылка.ОтделыОрганизаций")); 
	ТЗ_Начисления.Колонки.Добавить("ТипПремииСлуж", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ_Начисления.Колонки.Добавить("СуммаАктРеализации", Новый ОписаниеТипов("Число"));
	ТЗ_Начисления.Колонки.Добавить("СуммаАктПоступление", Новый ОписаниеТипов("Число")); 
	
	Возврат ТЗ_Начисления;                 
	
КонецФункции 

Процедура ЗаполнитьТаблицуЗначенийДаннымиПоОтделам(ТЗ_Начисления, Параметры, МенеджерВТ)
	
	РезультатЗапросаНастройкиОтчета = ЗапросНастройкиОтчета(Параметры);
	ВыборкаНастройкиОтчета = РезультатЗапросаНастройкиОтчета.Выбрать();
	
	Пока ВыборкаНастройкиОтчета.Следующий() Цикл
		
		ПараметрыОтбора = ВыборкаНастройкиОтчета.ХранилищеОтбора.Получить();   
		РезультатЗапросаПрофитПоОтделу = ЗапросПрофитПоОтделу(ПараметрыОтбора, ВыборкаНастройкиОтчета, МенеджерВТ);
		
		ВыборкаИтог = РезультатЗапросаПрофитПоОтделу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаИтог.Следующий();
		
		Выборка = ВыборкаИтог.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрТЗ = ТЗ_Начисления.Добавить();
			
			Если ВыборкаНастройкиОтчета.ДляРуководителя Тогда
				СтрТЗ.Сотрудник =  " Руководитель отдела";
			Иначе	
				СтрТЗ.Сотрудник = Выборка.Менеджер;
			КонецЕсли;
			
			Если ПараметрыОтбора.ВариантыРасчетаКомиссии = "Процент" Тогда   
				
				Если ПараметрыОтбора.ОтЧегоПроцент = Перечисления.БазаДляРасчетаКомиссии.СуммаПрофита Тогда
					БазаКомиссии = Выборка.ПрофитПоАктам;
					БазаОбщаяСумма = ВыборкаИтог.ПрофитПоАктам;
				ИначеЕсли ПараметрыОтбора.ОтЧегоПроцент = Перечисления.БазаДляРасчетаКомиссии.СуммаПродаж Тогда	
					БазаКомиссии = Выборка.ПрофитПоАктам; 
					БазаОбщаяСумма = ВыборкаИтог.СуммаАктаИсходящего;
				КонецЕсли;                      
				
				Если ПараметрыОтбора.Свойство("РазмерПроцентаКомисси") Тогда
					ПроцентКомиссии = ПараметрыОтбора.РазмерПроцентаКомисси
				ИначеЕсли ПараметрыОтбора.Свойство("ПороговыеЗначенияДляПроцента") Тогда
					ПроцентКомиссии = ПолучитьПороговоеЗначение(БазаОбщаяСумма, ПараметрыОтбора.ПороговыеЗначенияДляПроцента);
					ПроцентКомиссии = ?(ПроцентКомиссии = Неопределено, 0, ПроцентКомиссии);
				КонецЕсли;   
				
				Если ПараметрыОтбора.НадбавкаЗаПервичнуюСделку > 0 Тогда
					
					НомерСделки	= ПолучитьНомерСделки(Выборка.Сделка);
					
					Если НомерСделки = 1 Тогда
						ПроцентКомиссии = ПроцентКомиссии + ПараметрыОтбора.НадбавкаЗаПервичнуюСделку;
					Иначе
						ПроцентКомиссии = ПроцентКомиссии;	
					КонецЕсли;
					
				КонецЕсли;
				
				СтрТЗ.Премия = Выборка.ПрофитПоАктам * ПроцентКомиссии / 100;    
				
			ИначеЕсли ПараметрыОтбора.ВариантыРасчетаКомиссии = "ФиксированнаяСумма" Тогда 
				
				Если ПараметрыОтбора.ОтделОрганизации.Наименование = "Сертификация" Тогда
					Количество = Выборка.КоличествоСертификатов;	
				Иначе	
					Количество = Выборка.Количество;	
				КонецЕсли;
				
				ФиксированнаяСумма = 0;
				Если ПараметрыОтбора.Свойство("РазмерФиксированнойСуммы") Тогда
					ФиксированнаяСумма = ПараметрыОтбора.РазмерФиксированнойСуммы
				ИначеЕсли ПараметрыОтбора.Свойство("ПороговыеЗначенияДляФиксированнойСуммы") Тогда
					ФиксированнаяСумма = ПолучитьПороговоеЗначение(Количество, ПараметрыОтбора.ПороговыеЗначенияДляФиксированнойСуммы);
				КонецЕсли;	
				
				СтрТЗ.Премия = Количество * ФиксированнаяСумма;
				
			КонецЕсли;
			
			СтрТЗ.Профит = Выборка.ПрофитПоАктам;
			СтрТЗ.Сделка = Выборка.Сделка; 
			СтрТЗ.Номенклатура = Выборка.Номенклатура;
			СтрТЗ.Контрагент = Выборка.Контрагент; 
			СтрТЗ.КонтрагентНаименование = Выборка.КонтрагентНаименование;
			СтрТЗ.Отдел = ВыборкаНастройкиОтчета.Отдел;
			СтрТЗ.ТипПремииСлуж = ""; 
			СтрТЗ.СуммаАктРеализации = Выборка.СуммаАктаИсходящего;
			СтрТЗ.СуммаАктПоступление = Выборка.СуммаАктаВходящего;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросПрофитПоОтделу(ПараметрыОтбора, ЗаписьРегистра, МенеджерВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ВТ_ИтоговыеДанные.СуммаАктаВходящего, 0)) КАК СуммаАктаВходящего,
	|	СУММА(ЕСТЬNULL(ВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0)) КАК СуммаАктаИсходящего,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Номенклатура
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Сделка
	|	КОНЕЦ КАК Сделка,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Ответственный
	|	КОНЕЦ КАК Ответственный,
	|	СУММА(ЕСТЬNULL(ВТ_ИтоговыеДанные.ПрофитПоАктам, 0)) КАК ПрофитПоАктам,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ""Таможенные декларации""
	|		ИНАЧЕ ВТ_ИтоговыеДанные.КонтрагентНаименование
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	СУММА(ЕСТЬNULL(ВТ_ИтоговыеДанные.Количество, 0)) КАК Количество,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.ОтветственныйНаименование
	|	КОНЕЦ КАК ОтветственныйНаименование,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.СделкаДата
	|	КОНЕЦ КАК СделкаДата,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.НомерСделки
	|	КОНЕЦ КАК НомерСделки,
	|	ВТ_ИтоговыеДанные.Сделка.МенеджерПоТаможне КАК Менеджер,
	|	СУММА(ЕСТЬNULL(ВТ_ИтоговыеДанные.КоличествоСертификатов, 0)) КАК КоличествоСертификатов
	|ИЗ
	|	ВТ_ИтоговыеДанные КАК ВТ_ИтоговыеДанные
	|ГДЕ
	|	(&ОтборПоНоменклатуре = ЛОЖЬ
	|			ИЛИ ВТ_ИтоговыеДанные.Номенклатура В (&НоменклатураОтбор))
	|	И (&ОтборПоВидуСделки = ЛОЖЬ
	|			ИЛИ ВТ_ИтоговыеДанные.Сделка.Вид В (&ВидыСделокОтбор))
	|	И (&ОтборПоМенеджеру = ЛОЖЬ
	|			ИЛИ НЕ ВТ_ИтоговыеДанные.Сделка.МенеджерПоТаможне В (&МенеджерыОтбор))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Номенклатура
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Сделка
	|	КОНЕЦ,
	|	ВТ_ИтоговыеДанные.Сделка.МенеджерПоТаможне,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.ОтветственныйНаименование
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.СделкаДата
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.НомерСделки
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Ответственный
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		ИНАЧЕ ВТ_ИтоговыеДанные.Контрагент
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &СгруппироватьНоменклатуру
	|			ТОГДА ""Таможенные декларации""
	|		ИНАЧЕ ВТ_ИтоговыеДанные.КонтрагентНаименование
	|	КОНЕЦ
	|ИТОГИ
	|	СУММА(СуммаАктаВходящего),
	|	СУММА(СуммаАктаИсходящего),
	|	СУММА(ПрофитПоАктам),
	|	СУММА(Количество),
	|	СУММА(КоличествоСертификатов)
	|ПО
	|	ОБЩИЕ";  
	
	Запрос.УстановитьПараметр("СгруппироватьНоменклатуру", ЗаписьРегистра.СгруппироватьНоменклатуру);
	Если ПараметрыОтбора.Свойство("НоменклатураДляОтобора") Тогда
		Запрос.УстановитьПараметр("НоменклатураОтбор", ПараметрыОтбора.НоменклатураДляОтобора.ВыгрузитьКолонку("Номенклатура"));
		Запрос.УстановитьПараметр("ОтборПоНоменклатуре", ЗаписьРегистра.ЗависитОтНоменклатуры);  
	Иначе
		Запрос.УстановитьПараметр("НоменклатураОтбор", "");
		Запрос.УстановитьПараметр("ОтборПоНоменклатуре", ЗаписьРегистра.ЗависитОтНоменклатуры); 	
	КонецЕсли;
	
	Если ПараметрыОтбора.Свойство("ВидыСделокДляОтбора") Тогда
		Запрос.УстановитьПараметр("ВидыСделокОтбор", ПараметрыОтбора.ВидыСделокДляОтбора.ВыгрузитьКолонку("ВидСделки"));
		Запрос.УстановитьПараметр("ОтборПоВидуСделки", ЗаписьРегистра.ЗависитОтВидаСделки);
	Иначе
		Запрос.УстановитьПараметр("ВидыСделокОтбор", "");
		Запрос.УстановитьПараметр("ОтборПоВидуСделки", ЗаписьРегистра.ЗависитОтВидаСделки);	
	КонецЕсли;
	
	Если ПараметрыОтбора.Свойство("МенеджерыДляОтбора") Тогда
		Запрос.УстановитьПараметр("МенеджерыОтбор", ПараметрыОтбора.МенеджерыДляОтбора.ВыгрузитьКолонку("Менеджер"));
		Запрос.УстановитьПараметр("ОтборПоМенеджеру", ЗаписьРегистра.ОтборПоМенеджерам);
	Иначе                                                                         
		Запрос.УстановитьПараметр("МенеджерыОтбор", "");
		Запрос.УстановитьПараметр("ОтборПоМенеджеру", ЗаписьРегистра.ОтборПоМенеджерам);
	КонецЕсли;
	
	Если ПараметрыОтбора.Менеджер = Перечисления.ВидыМенеджеровНачислениеКомиссии.МенеджерПоРаботеСКлиентами Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка.МенеджерПоТаможне", "Сделка.МенеджерПоРаботеСКлиентами");
	ИначеЕсли ПараметрыОтбора.Менеджер = Перечисления.ВидыМенеджеровНачислениеКомиссии.МенеджерПоПродажам Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка.МенеджерПоТаможне", "Сделка.Менеджер");	
	КонецЕсли;  
	
	РезультатЗапроса = Запрос.Выполнить();	 
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция ЗапросНастройкиОтчета(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.Отдел КАК Отдел,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ДляРуководителя КАК ДляРуководителя,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ЗависитОтНоменклатуры КАК ЗависитОтНоменклатуры,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ПроцентЗависитОтПороговогоЗначения КАК ПроцентЗависитОтПороговогоЗначения,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ЗависитОтВидаСделки КАК ЗависитОтВидаСделки,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ФиксированнаяСуммаЗависитОтПороговогоЗначения КАК ФиксированнаяСуммаЗависитОтПороговогоЗначения,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ХранилищеОтбора КАК ХранилищеОтбора,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.ОтборПоМенеджерам КАК ОтборПоМенеджерам,
	|	НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних.СгруппироватьНоменклатуру КАК СгруппироватьНоменклатуру
	|ИЗ
	|	РегистрСведений.НачислениеКомиссииМенеджерамНастройкиОтчета.СрезПоследних(, ) КАК НачислениеКомиссииМенеджерамНастройкиОтчетаСрезПоследних";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция ПолучитьПороговоеЗначение(ОбщаяСумма, ПороговыеЗначения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПороговыеЗначения.От КАК От,
	|	ПороговыеЗначения.Значение КАК Значение
	|ПОМЕСТИТЬ ВтПороговыеЗначения
	|ИЗ
	|	&ПороговыеЗначения КАК ПороговыеЗначения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтПороговыеЗначения.От КАК От,
	|	МИНИМУМ(ЕСТЬNULL(ВтПороговыеЗначения1.От, 999999999999999)) КАК До,
	|	ВтПороговыеЗначения.Значение КАК Значение
	|ПОМЕСТИТЬ ВтЗначенияОтИДо
	|ИЗ
	|	ВтПороговыеЗначения КАК ВтПороговыеЗначения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПороговыеЗначения КАК ВтПороговыеЗначения1
	|		ПО ВтПороговыеЗначения.От < ВтПороговыеЗначения1.От
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтПороговыеЗначения.От,
	|	ВтПороговыеЗначения.Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВтЗначенияОтИДо.Значение КАК Значение
	|ИЗ
	|	ВтЗначенияОтИДо КАК ВтЗначенияОтИДо
	|ГДЕ
	|	ВтЗначенияОтИДо.От <= &ОбщаяСумма
	|	И ВтЗначенияОтИДо.До >= &ОбщаяСумма";
	
	Запрос.УстановитьПараметр("ОбщаяСумма", ОбщаяСумма);
	Запрос.УстановитьПараметр("ПороговыеЗначения", ПороговыеЗначения); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Значение;
	
КонецФункции 

Функция ПолучитьНомерСделки(Сделка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Сделка.Ссылка) КАК Номер,
	|	Сделка.Контрагент КАК Контрагент,
	|	Сделка.Вид КАК Вид
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.Дата <= &Дата
	|	И Сделка.Контрагент = &Контрагент
	|	И Сделка.Вид = &Вид
	|
	|СГРУППИРОВАТЬ ПО
	|	Сделка.Контрагент,
	|	Сделка.Вид
	|";
	Запрос.УстановитьПараметр("Дата",Сделка.Дата);
	Запрос.УстановитьПараметр("Контрагент",Сделка.Контрагент);
	Запрос.УстановитьПараметр("Вид",Сделка.Вид);  
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Результат.Пустой() Тогда
		НомерСделки = 1;
	Иначе	
		Выборка.Следующий();
		НомерСделки = Выборка.Номер;
	КонецЕсли;
	
	Возврат НомерСделки;
	
КонецФункции

// Профит считается тем же расчетом, что и в печатной форме «Профит сделки»
// (РасчетПрофитаСделокСервер.ПоместитьПрофитСделок). Здесь - только отбор сделок периода
// и реквизиты сделки для отборов отделов и расчета премий.
Функция ЗапросПрофитПоСделкам(Параметры)

	МенеджерВТ = Новый МенеджерВременныхТаблиц;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сделка.Ссылка КАК Сделка
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода";
	Запрос.УстановитьПараметр("НачалоПериода", Параметры.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", Параметры.КонецПериода);

	Сделки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сделка");

	РасчетПрофитаСделокСервер.ПоместитьПрофитСделок(МенеджерВТ, Сделки);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сделка.Ссылка КАК Сделка,
	|	Сделка.Контрагент КАК Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Сделка_1.Ссылка) КАК Номер
	|ПОМЕСТИТЬ ВТ_НомераСделок
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка_1
	|		ПО Сделка.МоментВремени >= Сделка_1.МоментВремени
	|			И Сделка.Контрагент = Сделка_1.Контрагент
	|ГДЕ
	|	Сделка.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Сделки.Сделка
	|			ИЗ
	|				ВТ_Сделки КАК ВТ_Сделки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Сделка.Контрагент,
	|	Сделка.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПрофитСделок.Номенклатура КАК Номенклатура,
	|	ВТ_ПрофитСделок.Сделка КАК Сделка,
	|	ВТ_ПрофитСделок.Сделка.Контрагент КАК Контрагент,
	|	ВТ_ПрофитСделок.Сделка.Ответственный КАК Ответственный,
	|	ВТ_ПрофитСделок.ПрофитПоАктам КАК ПрофитПоАктам,
	|	ВТ_ПрофитСделок.Сделка.Контрагент.Наименование КАК КонтрагентНаименование,
	|	ВТ_ПрофитСделок.Сделка.Ответственный.Наименование КАК ОтветственныйНаименование,
	|	ВТ_ПрофитСделок.Сделка.Дата КАК СделкаДата,
	|	ВТ_НомераСделок.Номер КАК НомерСделки,
	|	ВТ_ПрофитСделок.Сделка.Менеджер КАК МенеджерПоПродажам,
	|	ВТ_ПрофитСделок.Сделка.МенеджерПоТаможне КАК МенеджерПоТаможне,
	|	ВТ_ПрофитСделок.Количество КАК Количество,
	|	ВТ_ПрофитСделок.СуммаАктаИсходящего КАК СуммаАктаИсходящего,
	|	ВТ_ПрофитСделок.СуммаАктаВходящего КАК СуммаАктаВходящего,
	|	ВТ_ПрофитСделок.Сделка.КоличествоСертификатов КАК КоличествоСертификатов
	|ПОМЕСТИТЬ ВТ_ИтоговыеДанные
	|ИЗ
	|	ВТ_ПрофитСделок КАК ВТ_ПрофитСделок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НомераСделок КАК ВТ_НомераСделок
	|		ПО ВТ_ПрофитСделок.Сделка = ВТ_НомераСделок.Сделка";

	Запрос.Выполнить();

	Возврат МенеджерВТ;

КонецФункции

#КонецОбласти
