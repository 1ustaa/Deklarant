			СтрТЗ.Контрагент = СтрВыборка.Контрагент;
			СтрТЗ.Сделка = СтрВыборка.Сделка;
			СтрТЗ.Номенклатура = Строка(СтрВыборка.Номенклатура);
			СтрТЗ.Премия = СтрВыборка.ПремияРукОтдДекл;
			СтрТЗ.Профит = СтрВыборка.ПрофитПоАктам;
			СтрТЗ.Отдел = "Декларирование";
			СтрТЗ.ТипПремииСлуж = "Декларирование"; 
			СтрТЗ.СуммаАктРеализации = СтрВыборка.СуммаАктаИсходящего;
			СтрТЗ.СуммаАктПоступление = СтрВыборка.СуммаАктаВходящего;
		КонецЕсли;
		
		// Премия по сертификации
		Если СтрВыборка.Сделка.Вид = Перечисления.ВидыСделок.Сертификация Тогда
			СтрТЗ = ТЗ_Начисления.Добавить(); 
			СтрТЗ.Сотрудник =  "Мельникова Елена Александровна"; 
			СтрТЗ.Контрагент = СтрВыборка.Контрагент;
			СтрТЗ.Сделка = СтрВыборка.Сделка;
			СтрТЗ.Номенклатура = СтрВыборка.Сделка.НомераСертификатов;
			СтрТЗ.Премия = СтрВыборка.Сделка.КоличествоСертификатов * 500;
			СтрТЗ.Профит = 0;
			СтрТЗ.Отдел = "Сертификация";
			СтрТЗ.ТипПремииСлуж = "Сертификация";
			СтрТЗ.СуммаАктРеализации = СтрВыборка.СуммаАктаИсходящего;
			СтрТЗ.СуммаАктПоступление = СтрВыборка.СуммаАктаВходящего;
		КонецЕсли; 
		
	КонецЦикла;	

		
КонецПроцедуры
