	                |									КОГДА ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов <> 0
	                |											ИЛИ ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов <> NULL
	                |										ТОГДА ЕСТЬNULL(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения * ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.КурсВзаиморасчетов, 0) - ПоступлениеТоваровУслугАгентскиеУслуги.СуммаНДС * (ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения / (ПоступлениеТоваровУслугАгентскиеУслуги.Сумма + ПоступлениеТоваровУслугАгентскиеУслуги.СуммаНДС))
	                |									ИНАЧЕ ЕСТЬNULL(ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения, 0) - ПоступлениеТоваровУслугАгентскиеУслуги.СуммаНДС * (ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.СуммаРаспределения / (ПоступлениеТоваровУслугАгентскиеУслуги.Сумма + ПоступлениеТоваровУслугАгентскиеУслуги.СуммаНДС))
	                |								КОНЕЦ
	                |						КОНЕЦ
	                |				КОНЕЦ
	                |		КОНЕЦ),
	                |	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Сделка,
	                |	ЕСТЬNULL(ПоступлениеТоваровУслугАгентскиеУслуги.Номенклатура, ПоступлениеТоваровУслугАгентскиеУслуги.Содержание),
	                |	ВТ_Корр.Сумма,
	                |	ВТ_Корр.СуммаНДС
	                |ИЗ
	                |	Документ.ПоступлениеТоваровУслуг.РаспределениеСуммПоСделкамАгентскиеУслуги КАК ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.АгентскиеУслуги КАК ПоступлениеТоваровУслугАгентскиеУслуги
	                |		ПО ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.КлючСвязи = ПоступлениеТоваровУслугАгентскиеУслуги.КлючСвязиРаспределения
	                |			И (ПоступлениеТоваровУслугАгентскиеУслуги.Ссылка = ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка)
	                |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Корр КАК ВТ_Корр
	                |		ПО ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка = ВТ_Корр.ДокументПоступления
	                |ГДЕ
	                |	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Ссылка.Проведен = ИСТИНА
	                |	И ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Сделка.ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ПоступлениеТоваровУслугРаспределениеСуммПоСделкамАгентскиеУслуги.Сделка,
	                |	ЕСТЬNULL(ПоступлениеТоваровУслугАгентскиеУслуги.Номенклатура, ПоступлениеТоваровУслугАгентскиеУслуги.Содержание),
	                |	ВТ_Корр.Сумма,
	                |	ВТ_Корр.СуммаНДС
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	СУММА(ЕСТЬNULL(ВТ_Поступления.СуммаАкта, 0) + ЕСТЬNULL(ВТ_Поступления.Сумма, 0) + ЕСТЬNULL(ВТ_Поступления.СуммаНДС, 0)) КАК СуммаАкта,
	                |	ВТ_Поступления.Сделка КАК Сделка,
	                |	ВТ_Поступления.Номенклатура КАК Номенклатура
	                |ПОМЕСТИТЬ ВТ_Входящие
	                |ИЗ
	                |	ВТ_Поступления КАК ВТ_Поступления
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ВТ_Поступления.Сделка,
	                |	ВТ_Поступления.Номенклатура
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	СУММА(ВТ_Входящие.СуммаАкта) КАК СуммаАктаВходящего,
	                |	СУММА(ВТ_Исходящие.СуммаАкта) КАК СуммаАктаИсходящего,
	                |	ЕСТЬNULL(ВТ_Исходящие.Номенклатура, ВТ_Входящие.Номенклатура) КАК Номенклатура,
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка) КАК Сделка,
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент) КАК Контрагент,
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный) КАК Ответственный,
	                |	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаАкта, 0) - ЕСТЬNULL(ВТ_Входящие.СуммаАкта, 0)) КАК ПрофитПоАктам,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент)).Наименование КАК КонтрагентНаименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный)).Наименование КАК ОтветственныйНаименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка)).Дата КАК СделкаДата
	                |ПОМЕСТИТЬ ИВТ_ИтоговыеДанные
	                |ИЗ
	                |	ВТ_Входящие КАК ВТ_Входящие
	                |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Исходящие КАК ВТ_Исходящие
	                |		ПО ВТ_Входящие.Сделка = ВТ_Исходящие.Сделка
	                |			И ВТ_Входящие.Номенклатура = ВТ_Исходящие.Номенклатура
	                |ГДЕ
	                |	(ВТ_Входящие.Сделка.ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода
	                |			ИЛИ ВТ_Исходящие.Сделка.ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЕСТЬNULL(ВТ_Исходящие.Номенклатура, ВТ_Входящие.Номенклатура),
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка),
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент),
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный),
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент)).Наименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный)).Наименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка)).Дата
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ИВТ_ИтоговыеДанные.Ответственный КАК Ответственный,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.СуммаАктаВходящего КАК СуммаАктаВходящего,
	                |	ИВТ_ИтоговыеДанные.СуммаАктаИсходящего КАК СуммаАктаИсходящего,
	                |	ИВТ_ИтоговыеДанные.Номенклатура КАК Номенклатура,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК Профит,
	                |	(ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0)) * 0.04 КАК Премия,
	                |	ИВТ_ИтоговыеДанные.Сделка.МенеджерПоРаботеСКлиентами КАК СделкаМенеджерПоРаботеСКлиентами
	                |ПОМЕСТИТЬ ВТ_ДанныеДляОтделаКлиенты
	                |ИЗ
	                |	ИВТ_ИтоговыеДанные КАК ИВТ_ИтоговыеДанные
	                |ГДЕ
	                |	НЕ ИВТ_ИтоговыеДанные.Сделка.Вид В (&ВидыСделокАСД)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ИВТ_ИтоговыеДанные.СуммаАктаВходящего КАК СуммаАктаВходящего,
	                |	ИВТ_ИтоговыеДанные.СуммаАктаИсходящего КАК СуммаАктаИсходящего,
	                |	ИВТ_ИтоговыеДанные.Номенклатура КАК Номенклатура,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ИВТ_ИтоговыеДанные.Ответственный КАК Ответственный,
	                |	ИВТ_ИтоговыеДанные.ПрофитПоАктам КАК ПрофитПоАктам,
	                |	ИВТ_ИтоговыеДанные.КонтрагентНаименование КАК КонтрагентНаименование,
	                |	ИВТ_ИтоговыеДанные.ОтветственныйНаименование КАК ОтветственныйНаименование,
