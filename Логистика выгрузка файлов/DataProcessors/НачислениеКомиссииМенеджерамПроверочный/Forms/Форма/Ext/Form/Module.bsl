&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтотОбъект.ПериодОтчета.ДатаНачала = НачалоГода(ТекущаяДата());
	ЭтотОбъект.ПериодОтчета.ДатаОкончания = КонецГода(ТекущаяДата());
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	Если ЗначениеЗаполнено(ПериодОтчета.ДатаНачала) И ЗначениеЗаполнено(ПериодОтчета.ДатаОкончания) Тогда
		
		Если ПериодОтчета.ДатаНачала <= ПериодОтчета.ДатаОкончания Тогда
			
			КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ОтчетНачисленияПремийПоСделкам");    
			// Добавляем в коллекцию (тип массив) сформированный Табличный документ
			КоллекцияПечатныхФорм[0].ТабличныйДокумент = СформироватьОтчетНаСервере(); 
			// если требуется устанавливаем параметры печати
			КоллекцияПечатныхФорм[0].СинонимМакета = "Сводка по выручке и профитам по клиентам";
			
			КоллекцияПечатныхФорм[0].Экземпляров = 1;
			
			УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма);  
			
		Иначе 
			
			Сообщить("Невозможно вывести отчет: конец периода должен быть больше начала периода");  
			
		КонецЕсли; 
		
	Иначе
		
		ПоказатьПредупреждение(,"Невозможно вывести отчет: период отчета должен быть заполнен",,"ОШИБКА");
		
		//Сообщить("Невозможно вывести отчет: период должен быть заполнен");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчетНаСервере()
	
	ТЗ_Начисления = Новый ТаблицаЗначений;
	ТЗ_Начисления.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТЗ_Начисления.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗ_Начисления.Колонки.Добавить("Сделка", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ТЗ_Начисления.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТЗ_Начисления.Колонки.Добавить("Профит", Новый ОписаниеТипов("Число"));
	ТЗ_Начисления.Колонки.Добавить("Премия", Новый ОписаниеТипов("Число"));
	ТЗ_Начисления.Колонки.Добавить("Отдел", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100))); 
	ТЗ_Начисления.Колонки.Добавить("ТипПремииСлуж", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТЗ_Начисления.Колонки.Добавить("СуммаАктРеализации", Новый ОписаниеТипов("Число"));
	ТЗ_Начисления.Колонки.Добавить("СуммаАктПоступление", Новый ОписаниеТипов("Число"));
	
	ОрганизацияОтчета = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	
	//Если ОрганизацияОтчета.ИНН = "5074080761" Тогда // Декларант
	//	
	//	ЗаполнитьТЗДанными(ТЗ_Начисления); 
	//	
	Если ОрганизацияОтчета.ИНН = "2315213101" Тогда // Логист (ОСНО)
		
		ЗаполнитьТЗДаннымиЛогист(ТЗ_Начисления); 
		
	Иначе 
		
		ЗаполнитьТЗДанными(ТЗ_Начисления);	 //Декларант (УПРОЩЕНКА)
		
	КонецЕсли;
	
	
	
	ИтогСуммаОтделПродаж = 0;
	ИтогСуммаОтделКлиенты = 0;
	ИтогСуммаАвтоСобств = 0;
	
	Для каждого СтрТЗ из ТЗ_Начисления Цикл
		
		Если СтрТЗ.Отдел = "ИтогСуммаОтделПродаж" Тогда
			
			ИтогСуммаОтделПродаж = ИтогСуммаОтделПродаж + СтрТЗ.Профит;
			
		ИначеЕсли СтрТЗ.Отдел = "АвтоперевозкиСобств" Тогда	
			
			ИтогСуммаАвтоСобств = ИтогСуммаАвтоСобств + СтрТЗ.Профит;
			
		ИначеЕсли СтрТЗ.Отдел = "ОтделРаботыСКлиентами" Тогда	
			
			ИтогСуммаОтделКлиенты = ИтогСуммаОтделКлиенты + СтрТЗ.Профит;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	ПроцентРОП = ?(ИтогСуммаОтделПродаж < 6000000,2,3);
	ПроцентАвтоСобств = ?(ИтогСуммаАвтоСобств < 2160000,0.5,1);   
	
	ПрофитРОП = 0; 
	
	ВремТЗ = ТЗ_Начисления.Скопировать();
	
	Для каждого СтрВремТЗ из ВремТЗ Цикл
		
		Если СтрВремТЗ.Отдел = "ОтделПродаж" И (СтрВремТЗ.Сотрудник <> "Мельникова Елена Александровна" 
			И СтрВремТЗ.Сотрудник <> "Куршин Александр Владимирович") Тогда
			// Руководитель отдела продаж
			СтрТЗ = ТЗ_Начисления.Добавить(); 
			СтрТЗ.Сотрудник =  "А_Руководитель отдела продаж";
			СтрТЗ.Контрагент = СтрВремТЗ.Контрагент;
			СтрТЗ.Сделка = СтрВремТЗ.Сделка;
			СтрТЗ.Номенклатура = СтрВремТЗ.Номенклатура;
			СтрТЗ.Премия = СтрВремТЗ.Профит * ПроцентРОП / 100;
			СтрТЗ.Профит = СтрВремТЗ.Профит;
			СтрТЗ.Отдел = "ОтделПродаж";
			СтрТЗ.ТипПремииСлуж = "Отдел продаж";
			СтрТЗ.СуммаАктРеализации = СтрВремТЗ.СуммаАктРеализации;
			СтрТЗ.СуммаАктПоступление = СтрВремТЗ.СуммаАктПоступление;
			
			
		КонецЕсли;		
		
		
		Если СтрВремТЗ.Отдел = "ОтделРаботыСКлиентами" Тогда
			
			// Руководитель отдела работы склиентами
			СтрТЗ = ТЗ_Начисления.Добавить(); 
			СтрТЗ.Сотрудник =  "А_Руководитель отдела по работе с клиентами";
			СтрТЗ.Контрагент = СтрВремТЗ.Контрагент;
			СтрТЗ.Сделка = СтрВремТЗ.Сделка; 
			СтрТЗ.Номенклатура = СтрВремТЗ.Номенклатура;
			СтрТЗ.Премия = СтрВремТЗ.Профит * 3 / 100;
			СтрТЗ.Профит = СтрВремТЗ.Профит;
			СтрТЗ.Отдел = "ОтделРаботыСКлиентами";
			СтрТЗ.ТипПремииСлуж = "Отдел работы с клиентами"; 
			СтрТЗ.СуммаАктРеализации = СтрВремТЗ.СуммаАктРеализации;
			СтрТЗ.СуммаАктПоступление = СтрВремТЗ.СуммаАктПоступление;
			
		КонецЕсли;
		
	КонецЦикла;	  
	
	
	Для каждого стрТЗ_Начисления из ТЗ_Начисления Цикл
		
		Если стрТЗ_Начисления.Отдел = "АвтоперевозкиСобств" Тогда
			
			стрТЗ_Начисления.Премия = стрТЗ_Начисления.Профит * ПроцентАвтоСобств / 100;
			
		КонецЕсли;
		
		
	КонецЦикла;	
	
	
	
	ДанныеДляРасчетов = Новый Структура;
	ДанныеДляРасчетов.Вставить("ИтогСуммаОтделПродаж",ИтогСуммаОтделПродаж);
	ДанныеДляРасчетов.Вставить("ИтогСуммаОтделКлиенты",ИтогСуммаОтделКлиенты);
	ДанныеДляРасчетов.Вставить("ИтогСуммаАвтоСобств",ИтогСуммаАвтоСобств);
	ДанныеДляРасчетов.Вставить("ПроцентРОП",ПроцентРОП);
	ДанныеДляРасчетов.Вставить("ПроцентАвтоСобств",ПроцентАвтоСобств);
	ДанныеДляРасчетов.Вставить("ТЗ_Начисления",ТЗ_Начисления);
	
	Отчет = СформироватьПечатнуюФорму(ДанныеДляРасчетов);  
	
	Возврат Отчет;
	
КонецФункции  

// Для Декларанта
&НаСервере
Процедура ЗаполнитьТЗДанными(ТЗ_Начисления)
	
	Счета76 = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Хозрасчетный.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
		|ГДЕ
		|	Хозрасчетный.Код ПОДОБНО ""76%""
		|";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	
	Пока Выборка.Следующий() Цикл
		
		Счета76.Добавить(Выборка.Ссылка);
		
	КонецЦикла;	
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Сделка.Ссылка КАК Сделка,
	               |	Сделка.Контрагент КАК Контрагент,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Сделка_1.Ссылка) КАК Номер
