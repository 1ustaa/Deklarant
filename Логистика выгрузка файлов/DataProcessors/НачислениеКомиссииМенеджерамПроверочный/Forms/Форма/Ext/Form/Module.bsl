	                |	ВТ_ПоступленияСтавкаНДС.Сделка КАК Сделка,
	                |	ВТ_ПоступленияСтавкаНДС.Номенклатура КАК Номенклатура
	                |ПОМЕСТИТЬ ВТ_Поступления
	                |ИЗ
	                |	ВТ_ПоступленияСтавкаНДС КАК ВТ_ПоступленияСтавкаНДС
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ВТ_ПоступленияСтавкаНДС.Номенклатура,
	                |	ВТ_ПоступленияСтавкаНДС.Сделка
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	СУММА(ЕСТЬNULL(ВТ_Поступления.СуммаАкта, 0)) КАК СуммаАкта,
	                |	ВТ_Поступления.Сделка КАК Сделка,
	                |	ВТ_Поступления.Номенклатура КАК Номенклатура
	                |ПОМЕСТИТЬ ВТ_Входящие
	                |ИЗ
	                |	ВТ_Поступления КАК ВТ_Поступления
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ВТ_Поступления.Сделка,
	                |	ВТ_Поступления.Номенклатура
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	СУММА(ВТ_Входящие.СуммаАкта) КАК СуммаАктаВходящего,
	                |	СУММА(ВТ_Исходящие.СуммаАкта) КАК СуммаАктаИсходящего,
	                |	ЕСТЬNULL(ВТ_Исходящие.Номенклатура, ВТ_Входящие.Номенклатура) КАК Номенклатура,
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка) КАК Сделка,
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент) КАК Контрагент,
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный) КАК Ответственный,
	                |	СУММА(ЕСТЬNULL(ВТ_Исходящие.СуммаАкта, 0) - ЕСТЬNULL(ВТ_Входящие.СуммаАкта, 0)) КАК ПрофитПоАктам,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент)).Наименование КАК КонтрагентНаименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный)).Наименование КАК ОтветственныйНаименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка)).Дата КАК СделкаДата
	                |ПОМЕСТИТЬ ИВТ_ИтоговыеДанные
	                |ИЗ
	                |	ВТ_Входящие КАК ВТ_Входящие
	                |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Исходящие КАК ВТ_Исходящие
	                |		ПО ВТ_Входящие.Сделка = ВТ_Исходящие.Сделка
	                |			И ВТ_Входящие.Номенклатура = ВТ_Исходящие.Номенклатура
	                |ГДЕ
	                |	(ВТ_Входящие.Сделка.ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода
	                |			ИЛИ ВТ_Исходящие.Сделка.ДатаЗакрытия МЕЖДУ &НачалоПериода И &КонецПериода)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЕСТЬNULL(ВТ_Исходящие.Номенклатура, ВТ_Входящие.Номенклатура),
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка),
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент),
	                |	ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный),
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Контрагент, ВТ_Входящие.Сделка.Контрагент)).Наименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка.Ответственный, ВТ_Входящие.Сделка.Ответственный)).Наименование,
	                |	(ЕСТЬNULL(ВТ_Исходящие.Сделка, ВТ_Входящие.Сделка)).Дата
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ИВТ_ИтоговыеДанные.Ответственный КАК Ответственный,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.СуммаАктаВходящего КАК СуммаАктаВходящего,
	                |	ИВТ_ИтоговыеДанные.СуммаАктаИсходящего КАК СуммаАктаИсходящего,
	                |	ИВТ_ИтоговыеДанные.Номенклатура КАК Номенклатура,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК Профит,
	                |	(ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0)) * 0.04 КАК Премия,
	                |	ИВТ_ИтоговыеДанные.Сделка.МенеджерПоРаботеСКлиентами КАК МенеджерПоРаботеСКлиентами
	                |ПОМЕСТИТЬ ВТ_ДанныеДляОтделаКлиенты
	                |ИЗ
	                |	ИВТ_ИтоговыеДанные КАК ИВТ_ИтоговыеДанные
	                |ГДЕ
	                |	НЕ ИВТ_ИтоговыеДанные.Сделка.Вид В (&ВидыСделокАСД)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.Номенклатура, """""""") КАК Номенклатура,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) КАК СуммаАктаИсходящего,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК СуммаАктаВходящего,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК ПрофитАвто
	                |ПОМЕСТИТЬ ВТ_АвтоСобственное
	                |ИЗ
	                |	ИВТ_ИтоговыеДанные КАК ИВТ_ИтоговыеДанные
	                |ГДЕ
	                |	ИВТ_ИтоговыеДанные.Номенклатура = &Номенклатура4
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ИВТ_ИтоговыеДанные.СуммаАктаВходящего КАК СуммаАктаВходящего,
	                |	ИВТ_ИтоговыеДанные.СуммаАктаИсходящего КАК СуммаАктаИсходящего,
	                |	ИВТ_ИтоговыеДанные.Номенклатура КАК Номенклатура,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ИВТ_ИтоговыеДанные.Ответственный КАК Ответственный,
	                |	ИВТ_ИтоговыеДанные.ПрофитПоАктам КАК ПрофитПоАктам,
	                |	ИВТ_ИтоговыеДанные.КонтрагентНаименование КАК КонтрагентНаименование,
	                |	ИВТ_ИтоговыеДанные.ОтветственныйНаименование КАК ОтветственныйНаименование,
	                |	ИВТ_ИтоговыеДанные.СделкаДата КАК СделкаДата,
	                |	ВТ_НомераСделок.Номер КАК НомерСделки,
	                |	ИВТ_ИтоговыеДанные.Сделка.Менеджер КАК МенеджерПоПродажам,
	                |	ВЫБОР
	                |		КОГДА ИВТ_ИтоговыеДанные.Сделка.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Декларирование)
	                |			ТОГДА ИВТ_ИтоговыеДанные.ПрофитПоАктам * 0.04
	                |		ИНАЧЕ 0
	                |	КОНЕЦ КАК ПремияРукОтдДекл,
	                |	ВЫБОР
	                |		КОГДА ВТ_НомераСделок.Номер = 1
	                |			ТОГДА ИВТ_ИтоговыеДанные.ПрофитПоАктам * 0.1
	                |		ИНАЧЕ ИВТ_ИтоговыеДанные.ПрофитПоАктам * 0.075
	                |	КОНЕЦ КАК ПремияМенеджерПродаж
	                |ПОМЕСТИТЬ ВТ_ИтогДанныеСНомерамиСделок
	                |ИЗ
	                |	ИВТ_ИтоговыеДанные КАК ИВТ_ИтоговыеДанные
	                |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НомераСделок КАК ВТ_НомераСделок
	                |		ПО ИВТ_ИтоговыеДанные.Сделка = ВТ_НомераСделок.Сделка
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ИВТ_ИтоговыеДанные.Номенклатура КАК Номенклатура,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) КАК СуммаАктаИсходящего,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК СуммаАктаВходящего,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК ПрофитСделкаАвто
	                |ПОМЕСТИТЬ ВТ_СделкаАвтоперевозка
	                |ИЗ
	                |	ИВТ_ИтоговыеДанные КАК ИВТ_ИтоговыеДанные
	                |ГДЕ
	                |	ИВТ_ИтоговыеДанные.Сделка.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Автоперевозка)
	                |	И ИВТ_ИтоговыеДанные.СуммаАктаВходящего > 0
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.Номенклатура, """""""") КАК Номенклатура,
	                |	ИВТ_ИтоговыеДанные.Сделка КАК Сделка,
	                |	ИВТ_ИтоговыеДанные.Контрагент КАК Контрагент,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) КАК СуммаАктаИсходящего,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК СуммаАктаВходящего,
	                |	ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаИсходящего, 0) - ЕСТЬNULL(ИВТ_ИтоговыеДанные.СуммаАктаВходящего, 0) КАК ПрофитАвто
	                |ПОМЕСТИТЬ ВТ_Экспедирование
	                |ИЗ
	                |	ИВТ_ИтоговыеДанные КАК ИВТ_ИтоговыеДанные";
	
	Запрос1.УстановитьПараметр("СтавкиНДС", ТЗСтавкиНДС);
	Запрос1.УстановитьПараметр("КонецПериода", ПериодОтчета.ДатаОкончания); 
	Запрос1.УстановитьПараметр("НачалоПериода", ПериодОтчета.ДатаНачала);
	Запрос1.УстановитьПараметр("ВидыСделокАСД", МассивВидовСделокАСД);
	
	Результат1 = Запрос1.ВыполнитьПакетСПромежуточнымиДанными();
	
	// Отдел работы с клиентами
	Выборка = Результат1[10].Выгрузить();
	Для каждого стрВыборка из Выборка Цикл
		
		СтрТЗ = ТЗ_Начисления.Добавить(); 
		СтрТЗ.Сотрудник =  стрВыборка.МенеджерПоРаботеСКлиентами.Наименование;
		СтрТЗ.Контрагент = стрВыборка.Контрагент;
		СтрТЗ.Сделка = стрВыборка.Сделка;
		СтрТЗ.Номенклатура = Строка(СтрВыборка.Номенклатура);
		СтрТЗ.Премия = стрВыборка.Премия;
		СтрТЗ.Профит = стрВыборка.Профит;
		СтрТЗ.Отдел = "ОтделРаботыСКлиентами";
		СтрТЗ.ТипПремииСлуж = "Отдел работы с клиентами";
		СтрТЗ.СуммаАктРеализации = стрВыборка.СуммаАктаИсходящего; 
		СтрТЗ.СуммаАктПоступление = стрВыборка.СуммаАктаВходящего;
		
		
	КонецЦикла;	
	
	// Авто собственное
	ВыборкаАвто = Результат[11].Выгрузить(); 
	СотрудникПоАвтоСобственное = Справочники.Пользователи.НайтиПоНаименованию("Мельникова Елена Александровнаа");
	Для каждого стрВыборкаАвто из ВыборкаАвто Цикл
		
		СтрТЗ = ТЗ_Начисления.Добавить(); 
		СтрТЗ.Сотрудник =  "Мельникова Елена Александровна"; 
		СтрТЗ.Контрагент = стрВыборкаАвто.Контрагент;
		СтрТЗ.Сделка = стрВыборкаАвто.Сделка;
		СтрТЗ.Номенклатура = Строка(стрВыборкаАвто.Номенклатура); //+ "(Авто собственное)";
		СтрТЗ.Премия = 0;
		СтрТЗ.Профит = стрВыборкаАвто.ПрофитАвто;
		СтрТЗ.Отдел = "АвтоперевозкиСобств";
		СтрТЗ.ТипПремииСлуж = "Автоперевозки собственные"; 
		СтрТЗ.СуммаАктРеализации = стрВыборкаАвто.СуммаАктаИсходящего; 
		СтрТЗ.СуммаАктПоступление = стрВыборкаАвто.СуммаАктаВходящего;
		
	КонецЦикла;	  
	
	// Сделка - Автоперевозка
	ВыборкаСделкаАвтоперевозка = Результат[13].Выгрузить();
	Для каждого стрВыборкаСделкаАвтоперевозка из ВыборкаСделкаАвтоперевозка Цикл
		
		СтрТЗ = ТЗ_Начисления.Добавить(); 
		СтрТЗ.Сотрудник =  "Мельникова Елена Александровна"; 
		СтрТЗ.Контрагент = стрВыборкаСделкаАвтоперевозка.Контрагент;
		СтрТЗ.Сделка = стрВыборкаСделкаАвтоперевозка.Сделка;
		СтрТЗ.Номенклатура = Строка(стрВыборкаСделкаАвтоперевозка.Номенклатура); // + "(Сделка - Автоперевозка)";
		СтрТЗ.Премия = стрВыборкаСделкаАвтоперевозка.ПрофитСделкаАвто * 0.015 ;
		СтрТЗ.Профит = стрВыборкаСделкаАвтоперевозка.ПрофитСделкаАвто;
		СтрТЗ.Отдел = "СделкаАвтоперевозка";
		СтрТЗ.ТипПремииСлуж = "Автоперевозка"; 
		СтрТЗ.СуммаАктРеализации = стрВыборкаСделкаАвтоперевозка.СуммаАктаИсходящего; 
		СтрТЗ.СуммаАктПоступление = стрВыборкаСделкаАвтоперевозка.СуммаАктаВходящего;
		
	КонецЦикла;	  
	
	//Продажи, ОтделДекларирования, сертификация
	Выборка = Результат1[12].Выгрузить();
	Для каждого СтрВыборка из Выборка Цикл
		// менеджер продаж     
		
		НомерСделки = ПолучитьНомерСделки(стрВыборка.Сделка);
		
		СтрТЗ = ТЗ_Начисления.Добавить(); 
		СтрТЗ.Сотрудник =  СтрВыборка.МенеджерПоПродажам.Наименование;
		СтрТЗ.Контрагент = СтрВыборка.Контрагент;
		СтрТЗ.Сделка = СтрВыборка.Сделка;
		СтрТЗ.Номенклатура = Строка(СтрВыборка.Номенклатура);//  + "(Отдел продаж)";
		СтрТЗ.Премия = ?(НомерСделки = 1, СтрВыборка.ПрофитПоАктам * 0.1, СтрВыборка.ПрофитПоАктам * 0.075);//СтрВыборка.ПремияМенеджерПродаж;
		СтрТЗ.Профит = СтрВыборка.ПрофитПоАктам;
		СтрТЗ.Отдел = "ОтделПродаж";
		СтрТЗ.ТипПремииСлуж = "Отдел продаж"; 
		СтрТЗ.СуммаАктРеализации = СтрВыборка.СуммаАктаИсходящего;
		СтрТЗ.СуммаАктПоступление = СтрВыборка.СуммаАктаВходящего; 
		
		//руководитель отдела декларирования
		Если СтрВыборка.Сделка.Вид = Перечисления.ВидыСделок.Декларирование Тогда
			СтрТЗ = ТЗ_Начисления.Добавить(); 
			СтрТЗ.Сотрудник =  "А_Руководитель отдела декларирования";
			СтрТЗ.Контрагент = СтрВыборка.Контрагент;
			СтрТЗ.Сделка = СтрВыборка.Сделка;
			СтрТЗ.Номенклатура = Строка(СтрВыборка.Номенклатура);
			СтрТЗ.Премия = СтрВыборка.ПремияРукОтдДекл;
			СтрТЗ.Профит = СтрВыборка.ПрофитПоАктам;
			СтрТЗ.Отдел = "Декларирование";
			СтрТЗ.ТипПремииСлуж = "Декларирование"; 
			СтрТЗ.СуммаАктРеализации = СтрВыборка.СуммаАктаИсходящего;
			СтрТЗ.СуммаАктПоступление = СтрВыборка.СуммаАктаВходящего; 
		КонецЕсли;
		
		// Премия по сертификации
		Если СтрВыборка.Сделка.Вид = Перечисления.ВидыСделок.Сертификация Тогда
			СтрТЗ = ТЗ_Начисления.Добавить(); 
			СтрТЗ.Сотрудник =  "Мельникова Елена Александровна"; 
			СтрТЗ.Контрагент = СтрВыборка.Контрагент;
			СтрТЗ.Сделка = СтрВыборка.Сделка;
			СтрТЗ.Номенклатура = СтрВыборка.Сделка.НомераСертификатов;
			СтрТЗ.Премия = СтрВыборка.Сделка.КоличествоСертификатов * 500;
			СтрТЗ.Профит = 0;
			СтрТЗ.Отдел = "Сертификация";
			СтрТЗ.ТипПремииСлуж = "Сертификация";
			СтрТЗ.СуммаАктРеализации = СтрВыборка.СуммаАктаИсходящего;
			СтрТЗ.СуммаАктПоступление = СтрВыборка.СуммаАктаВходящего; 
		КонецЕсли; 
		
	КонецЦикла;	
	
	
КонецПроцедуры 

//Заполение табличного документа с отбором по сотрудникам
&НаСервере
Функция СформироватьПечатнуюФорму(ДанныеДляРасчетов) 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина; 
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	Обработка =  РеквизитФормыВЗначение("Объект");
	МакетОбработки = Обработка.ПолучитьМакет("Макет"); 
	
	ОбластьШапка = МакетОбработки.ПолучитьОбласть("Шапка");  
	
	ОбластьШапка.Параметры.ПериодНачисления = "с " + Формат(ПериодОтчета.ДатаНачала,"ДФ='dd.MM.yyyy ""г.""'") + " по " + 
	Формат(ПериодОтчета.ДатаОкончания,"ДФ='dd.MM.yyyy ""г.""'");
	
	ТабличныйДокумент.Вывести(ОбластьШапка); 
	
	Запрос = Новый Запрос;
	
	//========= + УСЛОВИЕ ОТБОРА ПО СОТРУДНИКАМ
	//+ Задаем секцию ГДЕ в запросе исходя из значения текущего пользователя
	ТекущийСотрудник = Пользователи.ТекущийПользователь(); 
	
	Если ТекущийСотрудник.Наименование = "Куршин Александр Владимирович" ИЛИ ТекущийСотрудник.Наименование = "Колодкин Максим Евгеньевич"
		ИЛИ ТекущийСотрудник.Наименование = "Власенко Виктория Андреевна" ИЛИ ТекущийСотрудник.Наименование = "Дорошенко Ксения Викторовна"
		ИЛИ ТекущийСотрудник.Наименование = "Токарева Вероника Валерьевна" 
		ИЛИ РольДоступна("АдминистраторСистемы") Тогда  // Весь отчет
		
		ТекстГДЕ = "";
		
	ИначеЕсли ТекущийСотрудник.Наименование = "Палеха Надежда Алексеевна" Тогда  // Руководитель Отдела работы с клиентами
		
		//ТекстГДЕ = "     
		//		   |ГДЕ
		//           |	ТаблицаДанных.Сотрудник = &Сотрудник
		//           |	ИЛИ ТаблицаДанных.Сотрудник = &РуководительОтдела"; 
		//Запрос.УстановитьПараметр("Сотрудник",ТекущийСотрудник.Наименование);
		//Запрос.УстановитьПараметр("РуководительОтдела","А_Руководитель отдела по работе с клиентами"); 
		
		ТекстГДЕ = "
		|ГДЕ
		|	ТаблицаДанных.Отдел = &Отдел";
		Запрос.УстановитьПараметр("Отдел","ОтделРаботыСКлиентами");
		
	ИначеЕсли ТекущийСотрудник.Наименование = "Кочвар Татьяна Николаевна" Тогда  // Руководитель Отдела Декларирования
		
		//ТекстГДЕ = "
		//		   |ГДЕ
		//           |	ТаблицаДанных.Сотрудник = &Сотрудник
		//           |	ИЛИ ТаблицаДанных.Сотрудник = &РуководительОтдела"; 
		//Запрос.УстановитьПараметр("Сотрудник",ТекущийСотрудник.Наименование);
		//Запрос.УстановитьПараметр("РуководительОтдела","А_Руководитель отдела декларирования"); 
		
		ТекстГДЕ = "
		|ГДЕ
		|	ТаблицаДанных.Отдел = &Отдел";
		Запрос.УстановитьПараметр("Отдел","Декларирование");
		
	Иначе                                                                        // Отдельно по менеджерам
		
		//Если  Лев(ТекущийСотрудник.Наименование,7) = "1cuser6" Тогда           // для разработчика
		//	ТекстГДЕ = "";	
		//Иначе	
		ТекстГДЕ = "
		|ГДЕ
		|	ТаблицаДанных.Сотрудник = &Сотрудник"; 
		Запрос.УстановитьПараметр("Сотрудник",ТекущийСотрудник.Наименование);
		//КонецЕсли;
		
	КонецЕсли;	
	//-  ===========================================================
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ТаблицаДанных.Сотрудник КАК Сотрудник,
	|	ТаблицаДанных.Контрагент КАК Контрагент,
	|	ТаблицаДанных.Сделка КАК Сделка,
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Профит КАК Профит,
	|	ТаблицаДанных.Премия КАК Премия,
	|	ТаблицаДанных.СуммаАктРеализации КАК СуммаАктРеализации,
	|	ТаблицаДанных.СуммаАктПоступление КАК СуммаАктПоступление,
	|	ТаблицаДанных.Отдел КАК Отдел,
	|	ТаблицаДанных.ТипПремииСлуж КАК ТипПремииСлуж
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных " + ТекстГДЕ + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Сотрудник КАК Сотрудник,
	|	ВТ_Данные.Контрагент КАК Контрагент,
	|	ВТ_Данные.Сделка КАК Сделка,
	|	ВТ_Данные.Профит КАК Профит,
	|	ВТ_Данные.Премия КАК Премия,
	|	ВТ_Данные.Отдел КАК Отдел,
	|	ВТ_Данные.ТипПремииСлуж КАК ТипПремииСлуж,
	|	ВТ_Данные.Номенклатура КАК Номенклатура,
	|	ВТ_Данные.СуммаАктРеализации КАК СуммаАктРеализации,
	|	ВТ_Данные.СуммаАктПоступление КАК СуммаАктПоступление
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	Контрагент,
	|	Сделка
	|ИТОГИ
	|	СУММА(Профит),
	|	СУММА(Премия),
	|	СУММА(СуммаАктРеализации),
	|	СУММА(СуммаАктПоступление)
	|ПО
	|	ТипПремииСлуж,
	|	Сотрудник,
	|	Контрагент,
	|	Сделка"; 
	Запрос.УстановитьПараметр("ТаблицаДанных",ДанныеДляРасчетов.ТЗ_Начисления);
	
	Результат = Запрос.Выполнить();
	//ВыборкаСотрудник = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОтдел = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	
	Пока ВыборкаОтдел.Следующий() Цикл
		
		ОбластьОтдел = МакетОбработки.ПолучитьОбласть("СтрОтдел");
		//ОблстьОтдел.Параметры.Отдел = ВыборкаОтдел.Отдел;
		ОбластьОтдел.Параметры.Отдел = ВыборкаОтдел.ТипПремииСлуж;
		ОбластьОтдел.Параметры.Профит = ВыборкаОтдел.Профит; 
		ОбластьОтдел.Параметры.Комиссия = ВыборкаОтдел.Премия;
		ОбластьОтдел.Параметры.СуммаАктРеализации = ВыборкаОтдел.СуммаАктРеализации; 
		
		Если ВыборкаОтдел.ТипПремииСлуж  =  "Сертификация" Тогда
			Маржа = 100;
		Иначе
			
			Если ВыборкаОтдел.СуммаАктРеализации > 0 и ВыборкаОтдел.Профит > 0 Тогда
				Маржа = ВыборкаОтдел.Профит / ВыборкаОтдел.СуммаАктРеализации * 100;
			Иначе         
				Маржа = 0;
			КонецЕсли;
			
		КонецЕсли;	
		
		ОбластьОтдел.Параметры.Маржа = Маржа;
		ТабличныйДокумент.Вывести(ОбластьОтдел,1);
		
		ВыборкаСотрудник = ВыборкаОтдел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСотрудник.Следующий() Цикл 
			//	ОбластьСотрудник  
			ОбластьСотрудник = МакетОбработки.ПолучитьОбласть("СтрСотрудник");
			
			Если Лев(ВыборкаСотрудник.Сотрудник,2) = "А_" Тогда
				ОбластьСотрудник.Параметры.Сотрудник = Прав(ВыборкаСотрудник.Сотрудник,СтрДлина(ВыборкаСотрудник.Сотрудник)-2);
			Иначе
				ОбластьСотрудник.Параметры.Сотрудник = ВыборкаСотрудник.Сотрудник; 
			КонецЕсли;
			
			ОбластьСотрудник.Параметры.Профит = ВыборкаСотрудник.Профит;
			ОбластьСотрудник.Параметры.Комиссия = ВыборкаСотрудник.Премия;
			ОбластьСотрудник.Параметры.СуммаАктРеализации = ВыборкаСотрудник.СуммаАктРеализации;  
			
			Если ВыборкаСотрудник.ТипПремииСлуж  =  "Сертификация" Тогда
				Маржа = 100;
			Иначе
				
				Если ВыборкаСотрудник.СуммаАктРеализации > 0 и ВыборкаСотрудник.Профит > 0 Тогда
					Маржа = ВыборкаСотрудник.Профит / ВыборкаСотрудник.СуммаАктРеализации * 100;
				Иначе         
					Маржа = 0;
				КонецЕсли;
				
			КонецЕсли;	
			
			ОбластьСотрудник.Параметры.Маржа = Маржа;
			
			ТабличныйДокумент.Вывести(ОбластьСотрудник,2);
			
			ВыборкаКонтрагент = ВыборкаСотрудник.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаКонтрагент.Следующий() Цикл
				//	ОбластьКлиент
				ОбластьКлиент = МакетОбработки.ПолучитьОбласть("СтрКлиент");
				
				ОбластьКлиент.Параметры.Клиент = ВыборкаКонтрагент.Контрагент;
				ОбластьКлиент.Параметры.Профит = ВыборкаКонтрагент.Профит;
				ОбластьКлиент.Параметры.Комиссия = ВыборкаКонтрагент.Премия;
				ОбластьКлиент.Параметры.СуммаАктРеализации = ВыборкаКонтрагент.СуммаАктРеализации; 
				
				Если ВыборкаКонтрагент.ТипПремииСлуж  =  "Сертификация" Тогда
					Маржа = 100;
				Иначе
					
					Если ВыборкаКонтрагент.СуммаАктРеализации > 0 и ВыборкаКонтрагент.Профит > 0 Тогда
						Маржа = ВыборкаКонтрагент.Профит / ВыборкаКонтрагент.СуммаАктРеализации * 100;
					Иначе         
						Маржа = 0;
					КонецЕсли;
					
				КонецЕсли;	
				
				ОбластьКлиент.Параметры.Маржа = Маржа;
				
				ТабличныйДокумент.Вывести(ОбластьКлиент,3);
				
				ВыборкаСделка = ВыборкаКонтрагент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаСделка.Следующий() Цикл
					//	ОбластьСделка 
					ОбластьСделка = МакетОбработки.ПолучитьОбласть("СтрСделка");
					
					ОбластьСделка.Параметры.Сделка = ВыборкаСделка.Сделка;
					ОбластьСделка.Параметры.Профит = ВыборкаСделка.Профит;
					ОбластьСделка.Параметры.Комиссия = ВыборкаСделка.Премия;
					ОбластьСделка.Параметры.СуммаАктРеализации = ВыборкаСделка.СуммаАктРеализации;
					
					Если ВыборкаСделка.ТипПремииСлуж  =  "Сертификация" Тогда
						Маржа = 100;
					Иначе
						
						Если ВыборкаСделка.СуммаАктРеализации > 0 и ВыборкаСделка.Профит > 0 Тогда
							Маржа = ВыборкаСделка.Профит / ВыборкаСделка.СуммаАктРеализации * 100;
						Иначе         
							Маржа = 0;
						КонецЕсли;
						
					КонецЕсли;	
					
					ОбластьСделка.Параметры.Маржа = Маржа ;
					
					ТабличныйДокумент.Вывести(ОбластьСделка,4);
					
					ВыборкаНоменклатура = ВыборкаСделка.Выбрать();
					Пока ВыборкаНоменклатура.Следующий() Цикл
						//ОбластьНоменклатура
						ОбластьНоменклатура = МакетОбработки.ПолучитьОбласть("СтрНоменклатура");
						
						ОбластьНоменклатура.Параметры.Номенклатура = ВыборкаНоменклатура.Номенклатура;
						ОбластьНоменклатура.Параметры.Профит = ВыборкаНоменклатура.Профит;
						ОбластьНоменклатура.Параметры.Комиссия = ВыборкаНоменклатура.Премия;
						ОбластьНоменклатура.Параметры.СуммаАктРеализации = ВыборкаНоменклатура.СуммаАктРеализации; 
						
						Если ВыборкаНоменклатура.ТипПремииСлуж  =  "Сертификация" Тогда
							Маржа = 100;
						Иначе
							
							Если ВыборкаНоменклатура.СуммаАктРеализации > 0 и ВыборкаНоменклатура.Профит > 0 Тогда
								Маржа = ВыборкаНоменклатура.Профит / ВыборкаНоменклатура.СуммаАктРеализации * 100;
							Иначе         
								Маржа = 0;
							КонецЕсли;
							
						КонецЕсли;	
						
						ОбластьНоменклатура.Параметры.Маржа = Маржа;
						
						ТабличныйДокумент.Вывести(ОбластьНоменклатура,5);
						
					КонецЦикла;
					
				КонецЦикла;	
				
				
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицуСтавокНДС()
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТЗ.Колонки.Добавить("СтавкаНДСЧисло", Новый ОписаниеТипов("Число"));
	
	Для Н1=1 ПО  Перечисления.СтавкиНДС.Количество() Цикл  
		
		СтавкаНДС = Перечисления.СтавкиНДС.Получить(Н1-1); 
		
		СтрТЗ = ТЗ.Добавить();
		СтрТЗ.СтавкаНДС = СтавкаНДС;
		СтрТЗ.СтавкаНДСЧисло = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС);
		
	КонецЦикла;	
	
	Возврат ТЗ;	
	
КонецФункции 

&НаСервере
Функция ПолучитьНомерСделки(Сделка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Сделка.Ссылка) КАК Номер,
	|	Сделка.Контрагент КАК Контрагент,
	|	Сделка.Вид КАК Вид
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.Дата <= &Дата
	|	И Сделка.Контрагент = &Контрагент
	|	И Сделка.Вид = &Вид
	|
	|СГРУППИРОВАТЬ ПО
	|	Сделка.Контрагент,
	|	Сделка.Вид
	|";
	Запрос.УстановитьПараметр("Дата",Сделка.Дата);
	Запрос.УстановитьПараметр("Контрагент",Сделка.Контрагент);
	Запрос.УстановитьПараметр("Вид",Сделка.Вид);  
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Результат.Пустой() Тогда
		НомерСделки = 1;
	Иначе	
		Выборка.Следующий();
		НомерСделки =Выборка.Номер;
	КонецЕсли;
	
	Возврат НомерСделки;
	
КонецФункции

